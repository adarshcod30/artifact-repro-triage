les", "media_files": "https://zenodo.org/api/records/1168726/media-files", "archive": "https://zenodo.org/api/records/1168726/files-archive", "archive_media": "https://zenodo.org/api/records/1168726/media-files-archive", "latest": "https://zenodo.org/api/records/1168726/versions/latest", "latest_html": "https://zenodo.org/records/1168726/latest", "versions": "https://zenodo.org/api/records/1168726/versions", "draft": "https://zenodo.org/api/records/1168726/draft", "access_links": "https://zenodo.org/api/records/1168726/access/links", "access_grants": "https://zenodo.org/api/records/1168726/access/grants", "access_users": "https://zenodo.org/api/records/1168726/access/users", "access_request": "https://zenodo.org/api/records/1168726/access/request", "access": "https://zenodo.org/api/records/1168726/access", "communities": "https://zenodo.org/api/records/1168726/communities", "communities-suggestions": "https://zenodo.org/api/records/1168726/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/1168726/request-deletion", "file_modification": "https://zenodo.org/api/records/1168726/file-modification", "quota_increase": "https://zenodo.org/api/records/1168726/quota-increase", "requests": "https://zenodo.org/api/records/1168726/requests"}, "updated": "2020-01-25T07:27:15.602341+00:00", "recid": "1168726", "revision": 4, "files": [{"id": "eacf70f1-6a90-4401-a948-be52671bf8bd", "key": "range_queries.zip", "size": 3295627, "checksum": "md5:b247042da913e45ca2bfc01abbfef680", "links": {"self": "https://zenodo.org/api/records/1168726/files/range_queries.zip/content"}}], "swh": null, "owners": [{"id": "41875"}], "status": "published", "stats": {"downloads": 44, "unique_downloads": 44, "views": 296, "unique_views": 289, "version_downloads": 44, "version_unique_downloads": 44, "version_unique_views": 289, "version_views": 296}, "state": "done", "submitted": true}, {"created": "2018-02-07T14:41:53.292212+00:00", "modified": "2020-01-25T07:27:18.700946+00:00", "id": 1168402, "conceptrecid": "1168401", "doi": "10.5281/zenodo.1168402", "conceptdoi": "10.5281/zenodo.1168401", "doi_url": "https://doi.org/10.5281/zenodo.1168402", "metadata": {"title": "Cache-Tries: Concurrent Lock-Free Hash Tries with Constant-Time Operations (Artifact)", "doi": "10.5281/zenodo.1168402", "publication_date": "2018-02-07", "description": "<p>Concurrent non-blocking hash tries have good cache locality,<br>\nand horizontally scalable operations. However, operations<br>\non most existing concurrent hash tries run in O (log n) time.<br>\nThis artifact contains present a novel<br>\nlock-free concurrent hash trie implementation&nbsp;that exerts less pressure<br>\non the memory allocator. This hash trie is augmented with<br>\na quiescently consistent cache, which permits the basic operations to run in expected O (1) time.<br>\nOn typical workloads, our implementation demonstrates up<br>\nto 5&times; performance improvements with respect to the previous hash trie variants.</p>", "access_right": "open", "creators": [{"name": "Aleksandar Prokopec", "affiliation": "Oracle Labs", "orcid": "0000-0003-0260-2729"}], "keywords": ["cache-tries", "constant-time", "lock-free", "non-blocking", "concurrent hash tries"], "version": "1.0", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "1168401"}}]}}, "title": "Cache-Tries: Concurrent Lock-Free Hash Tries with Constant-Time Operations (Artifact)", "links": {"self": "https://zenodo.org/api/records/1168402", "self_html": "https://zenodo.org/records/1168402", "preview_html": "https://zenodo.org/records/1168402?preview=1", "doi": "https://doi.org/10.5281/zenodo.1168402", "self_doi": "https://doi.org/10.5281/zenodo.1168402", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1168402", "reserve_doi": "https://zenodo.org/api/records/1168402/draft/pids/doi", "parent": "https