s": "https://zenodo.org/api/records/3371769/access/users", "access_request": "https://zenodo.org/api/records/3371769/access/request", "access": "https://zenodo.org/api/records/3371769/access", "communities": "https://zenodo.org/api/records/3371769/communities", "communities-suggestions": "https://zenodo.org/api/records/3371769/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/3371769/request-deletion", "file_modification": "https://zenodo.org/api/records/3371769/file-modification", "quota_increase": "https://zenodo.org/api/records/3371769/quota-increase", "requests": "https://zenodo.org/api/records/3371769/requests"}, "updated": "2020-01-25T07:23:58.380785+00:00", "recid": "3371769", "revision": 5, "files": [{"id": "c273f99e-b297-4210-91b8-2ce839516264", "key": "CMUSTRUDEL/choose-projects-CSCW2019-1.02.zip", "size": 924602, "checksum": "md5:4fec1815444d4889670f2bb6afea8747", "links": {"self": "https://zenodo.org/api/records/3371769/files/CMUSTRUDEL/choose-projects-CSCW2019-1.02.zip/content"}}], "swh": null, "owners": [{"id": "59682"}], "status": "published", "stats": {"downloads": 72, "unique_downloads": 69, "views": 307, "unique_views": 305, "version_downloads": 33, "version_unique_downloads": 32, "version_unique_views": 100, "version_views": 100}, "state": "done", "submitted": true}, {"created": "2019-08-09T00:18:12.243597+00:00", "modified": "2020-01-25T19:21:16.365488+00:00", "id": 3364086, "conceptrecid": "3364085", "doi": "10.5281/zenodo.3364086", "conceptdoi": "10.5281/zenodo.3364085", "doi_url": "https://doi.org/10.5281/zenodo.3364086", "metadata": {"title": "FuzzFactory: Domain-Specific Fuzzing with Waypoints (Replication Package)", "doi": "10.5281/zenodo.3364086", "publication_date": "2019-08-08", "description": "<p>This artifact accompanies the paper &quot;FuzzFactory: Domain-Specific Fuzzing with Waypoints&quot;, submitted to OOPSLA 2019.</p>\n\n<p><strong>Paper abstract</strong>:</p>\n\n<p>Coverage-guided fuzz testing has gained prominence as a highly effective method of finding security vulnerabilities such as buffer overflows in programs that parse binary data. Recently, researchers have introduced various specializations to the coverage-guided fuzzing algorithm for different domain-specific testing goals, such as finding performance bottlenecks, generating valid inputs, handling magic-byte comparisons, etc. Each such solution can require weeks of development effort and produces a distinct variant of a fuzzing tool. We observe that many of these domain-specific solutions follow a common solution pattern. In this paper, we present FuzzFactory, a framework for rapid prototyping of domain-specific fuzzing applications. FuzzFactory allows users to specify the collection of dynamic domain-specific feedback during test execution. FuzzFactory uses a domain-specific fuzzing algorithm that incorporates such custom feedback to selectively save intermediate inputs, called waypoints, to augment coverage-guided fuzzing. We use FuzzFactory to implement six domain-specific fuzzing applications: three re-implementations of prior work and three novel solutions, and evaluate their effectiveness on benchmarks from Google&#39;s fuzzer test suite. We also show how domain-specific feedback can be composed to produce composite applications, which perform better than the sum of their parts. For example, we combine domain-specific feedback about strict equality comparisons and dynamic memory allocations, to enable the automatic generation of ZIP bombs and PNG bombs. We also discover a previously unknown memory leak in libarchive.</p>", "access_right": "open", "creators": [{"name": "Padhye, Rohan", "affiliation": "UC Berkeley"}, {"name": "Lemieux, Caroline", "affiliation": "UC Berkeley"}], "contributors": [{"name": "Sen, Koushik", "affiliation": "UC Berkeley", "type": "Other"}, {"name": "Simon, Laurent", "affiliation": "Samsung Research America", "type": "Other"}, {"name": "Vijayakumar, Hayawardh", "affiliation": "Samsung Research America", "type": "Other"}], "version": "1.0", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "bsd-2-clause-netbsd"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "3364085"}}]}}, "title": "FuzzFactory: Domain-Specific Fuzzing with Waypoints (Replication Package)", "links": {"self": "https://zenodo.org/api/records/3364086", "self_html": "https://zenodo.org/records/3364086", "preview_html": "https://zenodo.org/records/3364086?preview=1", "doi": "https://doi.org/10.5281/zenodo.3364086", "self_doi": "https://doi.org/10.5281/zenodo.3364086", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.3364086", "reserve_doi": "https://zenodo.org/api/records/3364086/draft/pids/doi", "parent": "https://zenodo.org/api/records/3364085", "parent_html": "https://zenodo.org/records/3364085", "parent_doi": "https://doi.org/10.5281/zenodo.3364085", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.3364085", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:3364086/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:3364086/sequence/default", "files": "https://zenodo.org/api/records/3364086/files", "media_files": "https://zenodo.org/api/records/3364086/media-files", "archive": "https://zenodo.org/api/records/3364086/files-archive", "archive_media": "https://zenodo.org/api/records/3364086/media-files-archive", "latest": "https://zenodo.org/api/records/3364086/versions/latest", "latest_html": "https://zenodo.org/records/3364086/latest", "versions": "https://zenodo.org/api/records/3364086/versions", "draft": "https://zenodo.org/api/records/3364086/draft", "access_links": "https://zenodo.org/api/records/3364086/access/links", "access_grants": "https://zenodo.org/api/records/3364086/access/grants", "access_users": "https://zenodo.org/api/records/3364086/access/users", "access_request": "https://zenodo.org/api/records/3364086/access/request", "access":