nodo.org/api/records/2597652/versions", "draft": "https://zenodo.org/api/records/2597652/draft", "access_links": "https://zenodo.org/api/records/2597652/access/links", "access_grants": "https://zenodo.org/api/records/2597652/access/grants", "access_users": "https://zenodo.org/api/records/2597652/access/users", "access_request": "https://zenodo.org/api/records/2597652/access/request", "access": "https://zenodo.org/api/records/2597652/access", "communities": "https://zenodo.org/api/records/2597652/communities", "communities-suggestions": "https://zenodo.org/api/records/2597652/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/2597652/request-deletion", "file_modification": "https://zenodo.org/api/records/2597652/file-modification", "quota_increase": "https://zenodo.org/api/records/2597652/quota-increase", "requests": "https://zenodo.org/api/records/2597652/requests"}, "updated": "2020-01-25T07:21:25.293753+00:00", "recid": "2597652", "revision": 6, "files": [{"id": "57320fb3-6d8a-4ed7-979f-4d5da31fb6fe", "key": "AbdulAli/MSR2019Bangash-1.1.zip", "size": 84055699, "checksum": "md5:94ae7ecc5fe72aab28241d2ce92128b6", "links": {"self": "https://zenodo.org/api/records/2597652/files/AbdulAli/MSR2019Bangash-1.1.zip/content"}}], "swh": null, "owners": [{"id": "63117"}], "status": "published", "stats": {"downloads": 51, "unique_downloads": 45, "views": 140, "unique_views": 132, "version_downloads": 51, "version_unique_downloads": 45, "version_unique_views": 132, "version_views": 140}, "state": "done", "submitted": true}, {"created": "2019-02-16T09:46:09.058312+00:00", "modified": "2021-02-02T07:14:01.923190+00:00", "id": 2566774, "conceptrecid": "2549359", "doi": "10.5281/zenodo.2566774", "conceptdoi": "10.5281/zenodo.2549359", "doi_url": "https://doi.org/10.5281/zenodo.2566774", "metadata": {"title": "Replication Package: Mining Software Defects: Should We Consider Affected Releases?", "doi": "10.5281/zenodo.2566774", "publication_date": "2019-02-16", "description": "<p><strong>Replication Package: Mining Software Defects: Should We Consider Affected Releases?</strong></p>\n\n<p>With the rise of the Mining Software Repositories (MSR) field, defect datasets extracted from software repositories play a foundational role in many empirical studies related to software quality. At the core of defect data preparation is the identification of post-release defects. Prior studies leverage many heuristics (e.g., keywords and issue IDs) to identify post-release defects. However, such the heuristic approach is based on several assumptions, which pose common threats to the validity of many studies. In this paper, we set out to investigate the nature of the difference of defect datasets generated by the heuristic approach and the realistic approach that leverages the earliest affected release that is realistically estimated by a software development team for a given defect. In addition, we investigate the impact of defect identification approaches on the predictive accuracy and the ranking of defective modules that are produced by defect models. Through a case study of defect datasets of 32 releases, we find that that the heuristic approach has a large impact on both defect count datasets and binary defect datasets. Surprisingly, we find that the heuristic approach has a minimal impact on defect count models, suggesting that future work should not be too concerned about defect count models that are constructed using heuristic defect datasets. On the other hand, using defect datasets generated by the realistic approach lead to an improvement in the predictive accuracy of defect classification models.</p>", "access_right": "open", "creators": [{"name": "Chakkrit (Kla) Tantithamthavorn", "affiliation": "Monash University"}], "keywords": ["Defect Datasets"], "related_identifiers": [{"identifier": "https://github.com/awsm-research/replication-icse2019/tree/v1.1", "relation": "isSupplementTo", "scheme": "url"}], "version": "v1.1", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "other-open"}, "communities": [{"id": "seacraft"}], "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "2549359"}}]}}, "title": "Replication Package: Mining Software Defects: Should We Consider Affected Releases?", "links": {"self": "https://zenodo.org/api/records/2566774", "self_html": "https://zenodo.org/records/2566774", "preview_html": "https://zenodo.org/records/2566774?preview=1", "doi": "https://doi.org/10.5281/zenodo.2566774", "self_doi": "https://doi.org/10.5281/zenodo.2566774", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.2566774", "reserve_doi": "https://zenodo.org/api/records/2566774/draft/pids/doi", "parent": "https://zenodo.org/api/records/2549359", "parent_html": "https://zenodo.org/records/2549359", "parent_doi": "https://doi.org/10.5281/zenodo.2549359", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.2549359", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:2566774/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:2566774/sequence/default", "files": "https://zenodo.org/api/records/2566774/files", "media_files": "https://zenodo.org/api/records/2566774/media-files", "archive": "https://zenodo.org/api/records/2566774/files-archive", "archive_media": "https://zenodo.org/api/records/2566774/media-files-archive", "latest": "https://zenodo.org/api/records/2566774/versions/latest", "latest_html": "https://zenodo.org/records/2566774/latest", "versions": "https://zenodo.org/api/records/2566774/versions", "draft": "https://zenodo.org/api/records/2566774/draft", "access_links": "https://zenodo.org/api/records/2566774/access/links", "access_grants": "https://zenodo.org/api/records/2566774/access/grants", "access_users": "https://zenodo.org/api/records/2566774/access/users", "access_request": "https://zenodo.org/api/records/2566774/access/request", "access": "https://zenodo.org/api/recor