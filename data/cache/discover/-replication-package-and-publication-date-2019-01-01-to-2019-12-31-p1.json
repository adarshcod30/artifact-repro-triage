on/tree/v1.0.0", "relation": "isSupplementTo", "scheme": "url"}], "version": "v1.0.0", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "other-open"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "2548322"}}]}}, "title": "Replication Package - Branch Coverage Prediction in Automated Testing", "links": {"self": "https://zenodo.org/api/records/2548323", "self_html": "https://zenodo.org/records/2548323", "preview_html": "https://zenodo.org/records/2548323?preview=1", "doi": "https://doi.org/10.5281/zenodo.2548323", "self_doi": "https://doi.org/10.5281/zenodo.2548323", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.2548323", "reserve_doi": "https://zenodo.org/api/records/2548323/draft/pids/doi", "parent": "https://zenodo.org/api/records/2548322", "parent_html": "https://zenodo.org/records/2548322", "parent_doi": "https://doi.org/10.5281/zenodo.2548322", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.2548322", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:2548323/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:2548323/sequence/default", "files": "https://zenodo.org/api/records/2548323/files", "media_files": "https://zenodo.org/api/records/2548323/media-files", "archive": "https://zenodo.org/api/records/2548323/files-archive", "archive_media": "https://zenodo.org/api/records/2548323/media-files-archive", "latest": "https://zenodo.org/api/records/2548323/versions/latest", "latest_html": "https://zenodo.org/records/2548323/latest", "versions": "https://zenodo.org/api/records/2548323/versions", "draft": "https://zenodo.org/api/records/2548323/draft", "access_links": "https://zenodo.org/api/records/2548323/access/links", "access_grants": "https://zenodo.org/api/records/2548323/access/grants", "access_users": "https://zenodo.org/api/records/2548323/access/users", "access_request": "https://zenodo.org/api/records/2548323/access/request", "access": "https://zenodo.org/api/records/2548323/access", "communities": "https://zenodo.org/api/records/2548323/communities", "communities-suggestions": "https://zenodo.org/api/records/2548323/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/2548323/request-deletion", "file_modification": "https://zenodo.org/api/records/2548323/file-modification", "quota_increase": "https://zenodo.org/api/records/2548323/quota-increase", "requests": "https://zenodo.org/api/records/2548323/requests"}, "updated": "2020-01-24T19:28:02.255679+00:00", "recid": "2548323", "revision": 8, "files": [{"id": "a458e446-57d6-485e-8d74-494763c07856", "key": "sealuzh/branch-prediction-v1.0.0.zip", "size": 513540685, "checksum": "md5:b5fb6880e52804b586759e7f6a897a3a", "links": {"self": "https://zenodo.org/api/records/2548323/files/sealuzh/branch-prediction-v1.0.0.zip/content"}}], "swh": null, "owners": [{"id": "42386"}], "status": "published", "stats": {"downloads": 42, "unique_downloads": 41, "views": 303, "unique_views": 288, "version_downloads": 42, "version_unique_downloads": 41, "version_unique_views": 288, "version_views": 303}, "state": "done", "submitted": true}, {"created": "2019-10-08T17:46:02.517892+00:00", "modified": "2023-01-09T15:07:36.463093+00:00", "id": 3476957, "conceptrecid": "3476956", "doi": "10.5281/zenodo.3476957", "conceptdoi": "10.5281/zenodo.3476956", "doi_url": "https://doi.org/10.5281/zenodo.3476957", "metadata": {"title": "Replication Package for \"A Practical Method to Reduce Privacy Loss when Disclosing Statistics Based on Small Samples\"", "doi": "10.5281/zenodo.3476957", "publication_date": "2019-10-08", "description": "<p>We develop a simple method to reduce privacy loss when disclosing statistics such as OLS regression estimates based on samples with small numbers of observations. We focus on the case where the dataset can be broken into many groups (&quot;cells&quot;) and one is interested in releasing statistics for one or more of these cells. Building on ideas from the differential privacy literature, we add noise to the statistic of interest in proportion to the statistic&#39;s maximum observed sensitivity, defined as the maximum change in the statistic from adding or removing a single observation across all the cells in the data. Intuitively, our approach permits the release of statistics in arbitrarily small samples by adding sufficient noise to the estimates to protect privacy. Although our method does not offer a formal privacy guarantee, it generally outperforms widely used methods of disclosure limitation such as count-based cell suppression both in terms of privacy loss and statistical bias. We illustrate how the method can be implemented by discussing how it was used to release estimates of social mobility by Census tract in the Opportunity Atlas. We also provide a step-by-step guide and illustrative Stata code to implement our approach.</p>\n\n<blockquote>\n<p>Version of record for &quot;A Practical Method to Reduce Privacy Loss when Disclosing Statistics Based on Small Samples&quot; appears in Journal of Privacy and Confidentality 2019 Vol 9 Issue 2 (doi.org/10.29012/jpc.716). Based on <a href=\"https://github.com/Opportunitylab/Differential-Privacy/releases/tag/v1.0\">https://github.com/Opportunitylab/Differential-Privacy/releases/tag/v1.0</a>.</p>\n</blockquote>", "access_right": "open", "creators": [{"name": "Chetty, Raj", "affiliation": "Harvard University"}, {"name": "Friedman, John N.", "affiliation": "Brown University"}], "keywords": ["formal privacy", "privacy loss", "statistical bias"], "related_identifiers": [{"identifier": "https://github.com/journalprivacyconfidentiality/Differential-Privacy/tree/V1.0.716.1", "relation": "isSupplementTo", "resource_type": "software", "scheme": "url"}, {"identifier": "https://github.com/Opportunitylab/Differential-Privacy/releases/tag/v1.0", "relation": "isSupplementTo", "resource_type": "software", "scheme": "url"}, {"identifier": "10.29012/jpc.716", "relation": "isPartOf", "resource_type": "publication-article", "scheme": "doi"}], "version": "V1.0.716.1", "resource_type": {"title": "Software", "type": "software"}, "journal": {"issue": "2", "title": "Journal of Privacy and Confidentiality", "volume": "9"}, "license": {"id": "cc-by-4.0"}, "communities": [{"id": "jpc"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "3476956"}}]}, "notes": "We are grateful for funding from the Chan-Zuckerberg Initiative, the\n\tBill and Melinda Gates Foundation, the Overdeck Foundation, and Harvard\n\tUniversity."}, "title": "Replication Package for \"A Practical Method to Reduce Privacy Loss when Disclosing Statistics Based on Small Samples\"", "links": {"self": "https://zenodo.org/api/records/3476957", "self_html": "https://zenodo.org/records/3476957", "preview_html": "https://zenodo.org/records/3476957?preview=1", "doi": "https://doi.org/10.5281/zenodo.3476957", "self_doi": "https://doi.org/10.5281/zenodo.3476957", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.3476957", "reserve_doi": "https://zenodo.org/api/records/3476957/draft/pids/doi", "parent": "https://zenodo.org/api/records/3476956", "parent_html": "https://zenodo.org/records/3476956", "parent_doi": "https://doi.org/10.5281/zenodo.3476956", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.3476956", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:3476957/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:3476957/sequence/default", "files": "https://zenodo.org/api/records/3476957/files", "media_files": "https://zenodo.org/api/records/3476957/media-files", "archive": "https://zenodo.org/api/records/3476957/files-archive", "archive_media": "https://zenodo.org/api/records/3476957/media-files-archive", "latest": "https://zenodo.org/api/records/3476957/versions/latest", "latest_html": "https://zenodo.org/records/3476957/latest", "versions": "https://zenodo.org/api