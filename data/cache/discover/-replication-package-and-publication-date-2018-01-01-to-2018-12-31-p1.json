request": "https://zenodo.org/api/records/1194263/access/request", "access": "https://zenodo.org/api/records/1194263/access", "communities": "https://zenodo.org/api/records/1194263/communities", "communities-suggestions": "https://zenodo.org/api/records/1194263/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/1194263/request-deletion", "file_modification": "https://zenodo.org/api/records/1194263/file-modification", "quota_increase": "https://zenodo.org/api/records/1194263/quota-increase", "requests": "https://zenodo.org/api/records/1194263/requests"}, "updated": "2025-04-24T07:59:25.724996+00:00", "recid": "1194263", "revision": 10, "files": [{"id": "95259cbc-a0cd-4391-9d54-68f90af46d45", "key": "Artifact_Program_Slicing_and_CEGAR.zip", "size": 2856479973, "checksum": "md5:46c380122613c2a9a2adaeff17e81afe", "links": {"self": "https://zenodo.org/api/records/1194263/files/Artifact_Program_Slicing_and_CEGAR.zip/content"}}], "swh": null, "owners": [{"id": "40810"}], "status": "published", "stats": {"downloads": 24, "unique_downloads": 23, "views": 220, "unique_views": 215, "version_downloads": 24, "version_unique_downloads": 23, "version_unique_views": 215, "version_views": 220}, "state": "done", "submitted": true}, {"created": "2018-02-22T06:56:10.468337+00:00", "modified": "2020-01-25T07:24:59.581174+00:00", "id": 1182835, "conceptrecid": "1182834", "doi": "10.5281/zenodo.1182835", "conceptdoi": "10.5281/zenodo.1182834", "doi_url": "https://doi.org/10.5281/zenodo.1182835", "metadata": {"title": "Replication Package - How High Will It Be? Using Machine Learning Models to Predict Branch Coverage in Automated Testing", "doi": "10.5281/zenodo.1182835", "publication_date": "2018-02-22", "description": "<p>Replication Package the the paper &quot;<strong><em>How High Will It Be?&nbsp;Using Machine Learning Models to Predict Branch Coverage in Automated Testing</em></strong>&quot; accepted at MaLTeSQuE 2018 (workshop co-located with SANER).</p>\n\n<p>This is a Docker image needed to re-run the experiment conducted by the authors.</p>\n\n<p><strong>Usage</strong></p>\n\n<p>Type the following command to compute the data about the coverage for the labelled dataset<br>\n<em>julia -p 6 -L &quot;/prioritization_tool/coverage/model_building.jl&quot; bootstrap.jl --step_type generate --data_sources&nbsp;[\\&quot;dagger\\&quot;,\\&quot;ivy\\&quot;,\\&quot;guava\\&quot;,\\&quot;cassandra\\&quot;]&nbsp;--budgets&nbsp;&nbsp;[45,90,180]</em></p>\n\n<p><em>julia bootstrap.jl --step_type learn&nbsp;</em>will instead build and train the models.</p>\n\n<p>&nbsp;</p>", "access_right": "open", "creators": [{"name": "Giovanni Grano", "affiliation": "University of Zurich"}, {"name": "Timofey V. Titov", "affiliation": "University of Zurich"}, {"name": "Sebastiano Panichella", "affiliation": "University of Zurich"}, {"name": "Harald C. Gall", "affiliation": "University of Zurich"}], "keywords": ["replication", "docker", "machine learning"], "resource_type": {"title": "Software", "type": "software"}, "meeting": {"title": "Workshop on Machine Learning Techniques for Software Quality Evolution", "acronym": "MaLTeSQuE", "dates": "20 May 2018", "place": "Campobasso, Italy", "url": "https://maltesque.github.io"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "1182834"}}]}}, "title": "Replication Package - How High Will It Be? Using Machine Learning Models to Predict Branch Coverage in Automated Testing", "links": {"self": "https://zenodo.org/api/records/1182835", "self_html": "https://zenodo.org/records/1182835", "preview_html": "https://zenodo.org/records/1182835?preview=1", "doi": "https://doi.org/10.5281/zenodo.1182835", "self_doi": "https://doi.org/10.5281/zenodo.1182835", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1182835", "reserve_doi": "https://zenodo.org/api/records/1182835/draft/pids/doi", "parent": "https://zenodo.org/api/records/1182834", "parent_html": "https://zenodo.org/records/1182834", "parent_doi": "https://doi.org/10.5281/zenodo.1182834", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1182834", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:1182835/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:1182835/sequence/default", "files": "https://zenodo.org/api/records/1182835/files", "media_files": "https://zenodo.org/api/records/1182835/media-files", "archive": "https://zenodo.org/api/records/1182835/files-archive", "archive_media": "https://zenodo.org/api/records/1182835/media-files-archive", "latest": "https://zenodo.org/api/records/1182835/versions/latest", "latest_html": "https://zenodo.org/records/1182835/latest", "versions": "https://zenodo.org/api/records/1182835/versions", "draft": "https://zenodo.org/api/records/1182835/draft", "access_links": "https://zenodo.org/api/records/1182835/access/links", "access_grants": "https://zenodo.org/api/records/1182835/access/grants", "access_users": "https://zenodo.org/api/records/1182835/access/users", "access_request": "https://zenodo.org/api/records/1182835/access/request", "access": "https://zenodo.org/api/records/1182835/access", "communities": "https://zenodo.org/api/records/1182835/communities", "communities-suggestions": "https://zenodo.org/api/records/1182835/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/1182835/request-deletion", "file_modification": "https://zenodo.org/api/records/1182835/file-modification", "quota_increase": "https://zenodo.org/api/records/1182835/quota-increase", "requests": "https://zenodo.org/api/records/1182835/requests"}, "updated": "2020-01-25T07:24:59.581174+00:00", "recid": "1182835", "revision": 7, "files": [{"id": "ab5d1bc3-8e2e-4a2c-858d-9796fe180d35", "key": "maltesque18.tar", "size": 2337297408, "checksum": "md5:7630b92f4cefbf0897493bdfe389870b", "links": {"self": "https://zenodo.org/api/records/1182835/files/maltesque18.tar/content"}}], "swh": null, "owners": [{"id": "42386"}], "status": "published", "stats": {"downloads": 77, "unique_downloads": 54, "views": 207, "unique_views": 200, "version_downloads": 77, "version_unique_downloads": 54, "version_unique_views": 200, "version_views": 207}, "state": "done", "submitted": true}, {"created": "2018-01-24T16:38:20.916539+00:00", "modified": "2022-01-08T19:33:31.434289+00:00", "id": 1158649, "conceptrecid": "1158648", "doi": "10.5281/zenodo.1158649", "conceptdoi": "10.5281/zenodo.1158648", "doi_url": "https://doi.org/10.5281/zenodo.1158649", "metadata": {"title": "Replication Package for ISoLA 2016 Article `Symbolic Execution with CEGAR'", "doi": "10.5281/zenodo.1158649", "publication_date": "2018-01-24", "description": "<pre>Replication package for the article\n&#39;Dirk Beyer and Thomas Lemberger: &quot;Symbolic Execution with CEGAR&quot;, Proc. ISoLA, Springer, 2016.&#39;\n\nIt contains CPAchecker in the version used in the paper,\nas well as the benchmark-definition files necessary to run\nour experiments with BenchExec.\n\nAbstract:\n    Symbolic execution, a standard technique in program analysis,\n    is a particularly successful and popular component in systems\n    for test-case generation. One of the open research problems\n    is that the approach suffers from the path-explosion problem.\n    We apply abstraction to symbolic execution, and refine the\n    abstract model using counterexample-guided abstraction refinement (CEGAR),\n    a standard technique from model checking.\n    We also use refinement selection with existing and new heuristics\n    to influence the behavior and further improve the performance\n    of our refinement procedure.\n    We implemented our new technique\n    in the open-source software-verification framework CPAchecker.\n    Our experimental results show that the implementation is highly competitive.\n\nThe included README contains detailed instructions on how to reproduce our\nexperimental results of that work.\n</pre>", "access_right": "open", "creators": [{"name": "Beyer, Dirk", "affiliation": "LMU Munich, Germany", "orcid": "0000-0003-4832-7662"}, {"name": "Lemberger, Thomas", "affiliation": "LMU Munich, Germany", "orcid": "0000-0003-0291-815X"}], "keywords": ["Symbolic Execution", "Software Verification", "CEGAR", "sv-benchmarks"], "related_identifiers": [{"identifier": "10.1007/978-3-319-47166-2_14", "relation": "isSupplementTo", "resource_type": "publication-conferencepaper", "scheme": "doi"}], "version": "1.0.0", "language": "eng", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "apache2.0"}, "communities": [{"id": "sosy-lab"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "1158648"}}]}}, "title": "Replication Package for ISoLA 2016 Article `Symbolic Execution with CEGAR'", "links": {"self": "https://zenodo.org/api/records/1158649", "self_html": "https://zenodo.org/records/1158649", "preview_html": "https://zenodo.org/records/1158649?preview=1", "doi": "https://doi.org/10.5281/zenodo.1158649", "self_doi": "https://doi.org/10.5281/zenodo.1158649", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1158649", "reserve_doi": "https://zenodo.org/api/records/1158649/draft/pids/doi", "parent": "https://zenodo.org/api/records/1158648", "parent_html": "https://zenodo.org/records/1158648", "parent_doi": "https://doi.org/10.5281/zenodo.1158648", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1158648", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:1158649/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:1158649/sequence/default", "files": "https://zenodo.org/api/records/1158649/files", "media_files": "https://zenodo.org/api/records/1158649/media-files", "archive": "https://zenodo.org/api/records/1158649/files-archive", "archive_media": "https://zenodo.org/api/records/1158649/media-files-archive", "latest": "https://zenodo.org/api/records/1158649/versions/latest", "latest_html": "https://zenodo.org/records/1158649/latest", "versions": "https://zenodo.org/api/records/1158649/versions", "draft": "https://zenodo.org/api/records/1158649/draft", "access_links": "https://zenodo.org/api/records/1158649/access/links", "access_grants": "https://zenodo.org/api/records/1158649/access/grants", "access_users": "https://zenodo.org/api/records/1158649/access/users", "access_request": "https://zenodo.org/api/records/1158649/access/request", "access": "https://zenodo.org/api/records/1158649/access", "communities": "https://zenodo.org/api/records/1158649/communities", "communities-suggestions": "https://zenodo.org/api/records/1158649/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/1158649/request-deletion", "file_modification": "https://zenodo.org/api/records/1158649/file-modification", "quota_increase": "https://zenodo.org/api/records/1158649/quota-increase", "requests": "https://zenodo.org/api/records/1158649/requests"}, "updated": "2022-01-08T19:33:31.434289+00:00", "recid": "1158649", "revision": 9, "files": [{"id": "0f48ecee-fe4c-41b4-b3fa-14e8a9f1d2dc", "key": "cpa-symexec.zip", "size": 62221234, "checksum": "md5:2d010937fd38cb383e744ea3aa2f5a7c", "links": {"self": "https://zenodo.org/api/records/1158649/files/cpa-symexec.zip/content"}}], "swh": null, "owners": [{"id": "39516"}], "status": "published", "stats": {"downloads": 92, "unique_downloads": 92, "views": 488, "unique_views": 455, "version_downloads": 92, "version_unique_downloads": 92, "version_unique_views": 455, "version_views": 488}, "state": "done", "submitted": true}, {"created": "2018-01-24T16:32:44.286272+00:00", "modified": "2021-03-21T14:36:58.382883+00:00", "id": 1158646, "conceptrecid": "1158645", "doi": "10.5281/zenodo.1158646", "conceptdoi": "10.5281/zenodo.1158645", "doi_url": "https://doi.org/10.5281/zenodo.1158646", "metadata": {"title": "Replication Package for Article \"Software Verification: Testing vs. Model Checking\", Proc. HVC'17", "doi": "10.5281/zenodo.1158646", "publication_date": "2018-01-24", "description": "<pre>Replication package for the article\n&#39;Dirk Beyer and Thomas Lemberger: &quot;Software Verification: Testing vs. Model Checking&quot;, Proc. HVC, Springer, 2017.&#39;\n\nIt contains TBF in the version used in the article,\nas well as the benchmark-definition files that are necessary to run\nour experiments with BenchExec.\n\nFor space reasons, CPAchecker, CBMC, ESBMC, and FShell-w2t are not included,\nbut can be downloaded separately (cf. README).\n\nAbstract:\n    In practice, software testing has been the established method\n    for finding bugs in programs for a long time. But in the last 15 years,\n    software model checking has received a lot of attention, and\n    many successful tools for software model checking exist today.\n    We believe it is time for a careful comparative evaluation of\n    automatic software testing against automatic software model checking.\n    We chose six existing tools for automatic test-case generation,\n    namely AFL-fuzz, CPATiger, Crest-ppc, FShell, Klee, and PRtest,\n    and four tools for software model checking,\n    namely Cbmc, CPA-Seq, Esbmc-incr, and Esbmc-kInd,\n    for the task of finding specification violations in a large benchmark suite\n    consisting of 5 693 C programs. In order to perform such an evaluation,\n    we have implemented a framework for test-based falsification (tbf)\n    that executes and validates test cases produced by test-case generation tools\n    in order to find errors in programs.\n    The conclusion of our experiments is that software model checkers can\n    (i) find a substantially larger number of bugs\n    (ii) in less time, and\n    (iii) require less adjustment to the input programs.\n\nThe included README contains detailed instructions on how to reproduce our\nexperimental results of that work.\n</pre>", "access_right": "open", "creators": [{"name": "Beyer, Dirk", "affiliation": "LMU Munich, Germany", "orcid": "0000-0003-4832-7662"}, {"name": "Lemberger, Thomas", "affiliation": "LMU Munich, Germany", "orcid": "0000-0003-0291-815X"}], "keywords": ["Evaluation", "Testing", "Model Checking", "Comparison", "sv-benchmarks"], "related_identifiers": [{"identifier": "10.1007/978-3-319-70389-3_7", "relation": "isSupplementTo", "resource_type": "publication-conferencepaper", "scheme": "doi"}], "version": "1.0.0", "language": "eng", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "apache2.0"}, "communities": [{"id": "sosy-lab"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "1158645"}}]}}, "title": "Replication Package for Article \"Software Verification: Testing vs. Model Checking\", Proc. HVC'17", "links": {"self": "https://zenodo.org/api/records/1158646", "self_html": "https://zenodo.org/records/1158646", "preview_html": "https://zenodo.org/records/1158646?preview=1", "doi": "https://doi.org/10.5281/zenodo.1158646", "self_doi": "https://doi.org/10.5281/zenodo.1158646", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1158646", "reserve_doi": "https://zenodo.org/api/records/1158646/draft/pids/doi", "parent": "https://zenodo.org/api/records/1158645", "parent_html": "https://zenodo.org/records/1158645", "parent_doi": "https://doi.org/10.5281/zenodo.1158645", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1158645", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:1158646/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:1158646/sequence/default", "files": "https://zenodo.org/api/records/1158646/files", "media_files": "https://zenodo.org/api/records/1158646/media-files", "archive": "https://zenodo.org/api/records/1158646/files-archive", "archive_media": "https://zenodo.org/api/records/1158646/media-files-archive", "latest": "https://zenodo.org/api/records/1158646/versions/latest", "latest_html": "https:/