:45.646678+00:00", "recid": "1322090", "revision": 7, "files": [{"id": "fca2c810-fd7e-4c93-977c-7968ae20efae", "key": "ase18_parallel-bam_supplements_2018-09-20.zip", "size": 276699413, "checksum": "md5:c10b6e47770b954e49adba1fe55eae0a", "links": {"self": "https://zenodo.org/api/records/1322090/files/ase18_parallel-bam_supplements_2018-09-20.zip/content"}}], "swh": null, "owners": [{"id": "39516"}], "status": "published", "stats": {"downloads": 38, "unique_downloads": 37, "views": 690, "unique_views": 669, "version_downloads": 38, "version_unique_downloads": 37, "version_unique_views": 667, "version_views": 688}, "state": "done", "submitted": true}, {"created": "2018-07-27T14:19:37.782806+00:00", "modified": "2022-01-08T19:53:54.967728+00:00", "id": 1321181, "conceptrecid": "1256597", "doi": "10.5281/zenodo.1321181", "conceptdoi": "10.5281/zenodo.1256597", "doi_url": "https://doi.org/10.5281/zenodo.1321181", "metadata": {"title": "Reproduction Package for ASE 2018 Article `CPA-SymExec: Efficient Symbolic Execution in CPAchecker'", "doi": "10.5281/zenodo.1321181", "publication_date": "2018-07-27", "description": "<p>Reproduction Package for Article &quot;CPA-SymExec: Efficient Symbolic Execution in CPAchecker&quot; by Dirk Beyer and Thomas Lemberger</p>\n\n<p>It contains all tools and data that are necessary to reproduce the results in our article.<br>\nThe included README.md contains detailed replication instructions.</p>", "access_right": "open", "creators": [{"name": "Beyer, Dirk", "affiliation": "LMU Munich, Germany", "orcid": "0000-0003-4832-7662"}, {"name": "Lemberger, Thomas", "affiliation": "LMU Munich, Germany", "orcid": "0000-0003-0291-815X"}], "keywords": ["Symbolic execution", "Program analysis", "Test-case generation", "Software verification", "Software engineering", "SV-Benchmarks"], "related_identifiers": [{"identifier": "10.1145/3238147.3240478", "relation": "isSupplementTo", "resource_type": "publication-conferencepaper", "scheme": "doi"}, {"identifi