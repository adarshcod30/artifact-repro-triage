s://zenodo.org/api/records/1321181/versions/latest", "latest_html": "https://zenodo.org/records/1321181/latest", "versions": "https://zenodo.org/api/records/1321181/versions", "draft": "https://zenodo.org/api/records/1321181/draft", "access_links": "https://zenodo.org/api/records/1321181/access/links", "access_grants": "https://zenodo.org/api/records/1321181/access/grants", "access_users": "https://zenodo.org/api/records/1321181/access/users", "access_request": "https://zenodo.org/api/records/1321181/access/request", "access": "https://zenodo.org/api/records/1321181/access", "communities": "https://zenodo.org/api/records/1321181/communities", "communities-suggestions": "https://zenodo.org/api/records/1321181/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/1321181/request-deletion", "file_modification": "https://zenodo.org/api/records/1321181/file-modification", "quota_increase": "https://zenodo.org/api/records/1321181/quota-increase", "requests": "https://zenodo.org/api/records/1321181/requests"}, "updated": "2022-01-08T19:53:54.967728+00:00", "recid": "1321181", "revision": 8, "files": [{"id": "cbf586d9-5d4a-41ef-ab45-19ccace669d5", "key": "ASE18_CPA-SymExec.zip", "size": 895846222, "checksum": "md5:f7112cf6a4a6abc03c4024d051e3a312", "links": {"self": "https://zenodo.org/api/records/1321181/files/ASE18_CPA-SymExec.zip/content"}}], "swh": null, "owners": [{"id": "39516"}], "status": "published", "stats": {"downloads": 99, "unique_downloads": 97, "views": 1146, "unique_views": 1122, "version_downloads": 79, "version_unique_downloads": 77, "version_unique_views": 950, "version_views": 972}, "state": "done", "submitted": true}, {"created": "2018-05-15T14:53:34.231378+00:00", "modified": "2022-01-08T19:47:40.398698+00:00", "id": 1172228, "conceptrecid": "1172227", "doi": "10.5281/zenodo.1172228", "conceptdoi": "10.5281/zenodo.1172227", "doi_url": "https://doi.org/10.5281/zenodo.1172228", "metadata": {"title": "Reproduction Package for ICSE 2018 Article `Reducer-Based Construction of Conditional Verifiers'", "doi": "10.5281/zenodo.1172228", "publication_date": "2018-02-13", "description": "<pre>Replication package for the article\n&#39;Dirk Beyer, Marie-Christine Jakobs, Thomas Lemberger, and Heike Wehrheim. Reducer-Based Construction of Conditional Verifiers. In Proc. ICSE, 2018. ACM.&#39;\n\nIt contains all tools and data necessary to reproduce the results stated in our work.\nThe included README.md contains detailed instructions.\n\nAbstract:\n\tDespite recent advances, software verification remains challenging. To solve hard verification tasks, we need to leverage not just one but several different verifiers employing different technologies. To this end, we need to exchange information between verifiers. Conditional model checking was proposed as a solution to exactly this problem: The idea is to let the first verifier output a condition which describes the state space that it successfully verified and to instruct the second verifier to verify the yet unverified state space using this condition. However, most verifiers do not understand conditions as input.\nIn this paper, we propose the usage of an off-the-shelf construction of a conditional verifier from a given traditional verifier and a reducer. The reducer takes as input the program to be verified and the condition, and outputs a residual program whose paths cover the unverified state space described by the condition. As a proof of concept, we designed and implemented one particular reducer and composed three conditional model checkers from the three best verifiers at SV-COMP 2017. We defined a set of claims and experimentally evaluated their validity. All experimental data and results are available for replication.\n</pre>", "access_right": "open", "creators": [{"name": "Beyer, Dirk", "affiliation": "LMU Munich, Germany", "orcid": "0000-0003-4832-7662"}, {"name": "Jakobs, Marie-Christine", "affiliation": "LMU Munich, Germany"}, {"name": "Lemberger, Thomas", "affiliation": "LMU Munich, Germany", "orcid": "0000-0003-0291-815X"}, {"name": "Wehrheim, Heike", "affiliation": "University of Paderborn", "orcid": "0000-0002-2385-7512"}], "keywords": ["Formal Verification", "Model Checking", "Program Analysis", "Sequential Combination", "Testing", "Software Verification", "Conditional Model Checking", "SV-Benchmarks", "Reducers"], "related_identifiers": [{"identifier": "10.1145/3180155.3180259", "relation": "isSupplementTo", "resource_type": "publication-conferencepaper", "scheme": "doi"}], "version": "CMC-reducers-ICSE18-proceedings", "language": "eng", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "other-nc"}, "communities": [{"id": "sosy-lab"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "1172227"}}]}}, "title": "Reproduction Package for ICSE 2018 Article `Reducer-Based Construction of Conditional Verifiers'", "links": {"self": "https://zenodo.org/api/records/1172228", "self_html": "https://zenodo.org/records/1172228", "preview_html": "https://zenodo.org/records/1172228?preview=1", "doi": "https://doi.org/10.5281/zenodo.1172228", "self_doi": "https://doi.org/10.5281/zenodo.1172228", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1172228", "reserve_doi": "https://zenodo.org/api/records/1172228/draft/pids/doi", "parent": "https://zenodo.org/api/records/1172227", "parent_html": "https://zenodo.org/records/1172227", "parent_doi": "https://doi.org/10.5281/zenodo.1172227", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1172227", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:1172228/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:1172228/sequence/default", "files": "https://zenodo.org/api/records/1172228/files", "media_files": "https://zenodo.org/api/records/1172228/media-files", "archive": "https://zenodo.org/api/records/1172228/files-archive", "archive_media": "https://zenod