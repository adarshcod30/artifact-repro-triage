on", "results/official-run/repetition_8/WTS/execution_output.txt", "results/official-run/repetition_8/WTS/extracted_test_data.json", "results/official-run/repetition_8/WTS/generated_tests/EvoMaster_faults_Test.py", "results/official-run/repetition_8/WTS/generated_tests/em_test_utils.py", "results/official-run/repetition_9/RANDOM/covered_targets.txt", "results/official-run/repetition_9/RANDOM/criteria_analyzed/input_operation.json", "results/official-run/repetition_9/RANDOM/criteria_analyzed/input_parameter.json", "results/official-run/repetition_9/RANDOM/criteria_analyzed/input_parameter_value.json", "results/official-run/repetition_9/RANDOM/criteria_analyzed/input_path.json", "results/official-run/repetition_9/RANDOM/criteria_analyzed/output_response_body_properties.json", "results/official-run/repetition_9/RANDOM/criteria_analyzed/output_status_code.json", "results/official-run/repetition_9/RANDOM/criteria_analyzed/output_status_code_class.json", "results/official-run/repetition_9/RANDOM/execution_output.txt", "results/official-run/repetition_9/RANDOM/extracted_test_data.json", "results/official-run/repetition_9/RANDOM/generated_tests/EvoMaster_faults_Test.py", "results/official-run/repetition_9/RANDOM/generated_tests/EvoMaster_others_Test.py", "results/official-run/repetition_9/RANDOM/generated_tests/em_test_utils.py", "results/official-run/repetition_9/SMARTS/covered_targets.txt", "results/official-run/repetition_9/SMARTS/criteria_analyzed/input_operation.json", "results/official-run/repetition_9/SMARTS/criteria_analyzed/input_parameter.json", "results/official-run/repetition_9/SMARTS/criteria_analyzed/input_parameter_value.json", "results/official-run/repetition_9/SMARTS/criteria_analyzed/input_path.json", "results/official-run/repetition_9/SMARTS/criteria_analyzed/output_response_body_properties.json", "results/official-run/repetition_9/SMARTS/criteria_analyzed/output_status_code.json", "results/official-run/repetition_9/SMARTS/criteria_analyzed/output_status_code_class.json", "results/official-run/repetition_9/SMARTS/execution_output.txt", "results/official-run/repetition_9/SMARTS/extracted_test_data.json", "results/official-run/repetition_9/SMARTS/generated_tests/EvoMaster_faults_Test.py", "results/official-run/repetition_9/SMARTS/generated_tests/EvoMaster_others_Test.py", "results/official-run/repetition_9/SMARTS/generated_tests/EvoMaster_successes_Test.py", "results/official-run/repetition_9/SMARTS/generated_tests/em_test_utils.py", "results/official-run/repetition_9/WTS/covered_targets.txt", "results/official-run/repetition_9/WTS/criteria_analyzed/input_operation.json", "results/official-run/repetition_9/WTS/criteria_analyzed/input_parameter.json", "results/official-run/repetition_9/WTS/criteria_analyzed/input_parameter_value.json", "results/official-run/repetition_9/WTS/criteria_analyzed/input_path.json", "results/official-run/repetition_9/WTS/criteria_analyzed/output_response_body_properties.json", "results/official-run/repetition_9/WTS/criteria_analyzed/output_status_code.json", "results/official-run/repetition_9/WTS/criteria_analyzed/output_status_code_class.json", "results/official-run/repetition_9/WTS/execution_output.txt", "results/official-run/repetition_9/WTS/extracted_test_data.json", "results/official-run/repetition_9/WTS/generated_tests/EvoMaster_faults_Test.py", "results/official-run/repetition_9/WTS/generated_tests/EvoMaster_others_Test.py", "results/official-run/repetition_9/WTS/generated_tests/EvoMaster_successes_Test.py", "results/official-run/repetition_9/WTS/generated_tests/em_test_utils.py", "results/statistics/experiment-data-03-05-25-time-01-29-53-388.json", "results/statistics/experiment-data-03-05-25-time-21-29-51-725.json", "results/statistics/experiment-data-05-05-25-time-00-15-46-626.json", "results/statistics/experiment-data-06-05-25-time-19-56-26-372.json", "results/statistics/experiment-date-03-05-25-time-01-29-53-388.csv", "results/statistics/experiment-date-03-05-25-time-21-29-51-725.csv", "results/statistics/experiment-date-05-05-25-time-00-15-46-626.csv", "results/statistics/experiment-date-06-05-25-time-19-56-26-372.csv", "results/statistics/minimization_analysis.csv", "tool/analyze_minimization.py", "tool/configs/em.yaml.example", "tool/configs/setup_experiment.json", "tool/criteria_analyzer.py", "tool/exceptions.py", "tool/extract_criteria_from_swagger.py", "tool/extract_tests_data.py", "tool/helpers.py", "tool/main.py", "tool/requirements.txt", "tool/run_get_statistics_csv.py"], "readme": "# Replication Package\n\nThis directory contains the tool and aggregated results used in the study on\nautomatic test data generation for RESTful APIs (RANDOM, WTS, and SMARTS\ntechniques, via [EvoMaster](https://www.evomaster.org)).\n\n## License\n\nThe code (`tool/`, `analysis/`) is distributed under the MIT license. The data\nunder `results/` (experiment outputs, generated tests, coverage data) is\ndistributed under Creative Commons Attribution 4.0 (CC BY 4.0). See\n[LICENSE](LICENSE).\n\n## \u26a0\ufe0f About sensitive data\n\nThe API targeted by this study (CMDE \u2014 Conjunto M\u00ednimo de Dados Educacionais,\nmaintained by Brazil's Ministry of Education) receives the data that feeds the\nP\u00e9-de-Meia program, one of the federal government's major public policies.\nThe **API documentation is public**\n(<https://api-cmde.gestaopresente.mec.gov.br/v1/documentation>), so the\nOpenAPI specification (`api-docs.json`) and the criteria derived from it\n(`criteria/*.json`) are included in this package without restriction.\n\n> **Version note:** the `api-docs.json` included here is a copy **archived at\n> the time of the experiment** (May 2025). The public documentation at the\n> link above may have changed since then \u2014 do not assume the two are\n> identical.\n\nThe tests generated by EvoMaster (`generated_tests/*.py`, under\n`results/official-run/`), on the other hand, had **a real authentication key\n(`x-api-key`) used to access the API** embedded in every request. Unlike the\nspecification, this key is not public information \u2014 it was **redacted\n(replaced with `REDACTED_API_KEY`) in all 76 affected files** before being\nincluded here. The payload content (names, CPFs, addresses, etc.) that\nappears in these tests is **synthetic data automatically generated by\nEvoMaster** for fuzzing purposes \u2014 no evidence of real student data was found\nin the samples checked (names such as \"Donald Jackson\"/\"Timothy Garcia\",\naddresses such as \"Rua teste\", emails such as \"elegibel@elegivel.com\", and\nrepeated digit strings such as \"11111111111\" are typical patterns of\nfuzzer-generated data, not real records). That said, the files were not\naudited one by one \u2014 if you plan to reuse this material, that check is worth\ndoing.\n\nThe `evomaster.jar` binary is not versioned here; download the version used\ndirectly from the\n[official EvoMaster repository](https://github.com/WebFuzzing/EvoMaster/releases).\n\n## Structure\n\n```\nreplication-package/\n\u251c\u2500\u2500 tool/                        # Experiment execution tool (generic)\n\u2502   \u251c\u2500\u2500 main.py\n\u2502   \u251c\u2500\u2500 criteria_analyzer.py\n\u2502   \u251c\u2500\u2500 extract_criteria_from_swagger.py\n\u2502   \u251c\u2500\u2500 extract_tests_data.py\n\u2502   \u251c\u2500\u2500 run_get_statistics_csv.py\n\u2502   \u251c\u2500\u2500 analyze_minimization.py  # extracts minimization-phase data from raw logs\n\u2502   \u251c\u2500\u2500 helpers.py\n\u2502   \u251c\u2500\u2500 exceptions.py\n\u2502   \u251c\u2500\u2500 requirements.txt\n\u2502   \u2514\u2500\u2500 configs/\n\u2502       \u251c\u2500\u2500 em.yaml.example      # copy to em.yaml and point it at YOUR API\n\u2502       \u2514\u2500\u2500 setup_experiment.json\n\u251c\u2500\u2500 analysis/                    # Statistical analysis and figure generation for the paper\n\u2502   \u251c\u2500\u2500 compute_statistics.py    # reproduces every statistical number cited in the paper\n\u2502   \u251c\u2500\u2500 generate_figures.py      # reproduces every figure (written to analysis/output/)\n\u2502   \u2514\u2500\u2500 requirements.txt\n\u251c\u2500\u2500 results/\n\u2502   \u251c\u2500\u2500 statistics/               # aggregated results (CSV + JSON) from the 4 runs\n\u2502   \u2502   \u2514\u2500\u2500 minimization_analysis.csv  # generated by tool/analyze_minimization.py\n\u2502   \u2514\u2500\u2500 official-run/             # complete raw data for the official dataset (see below)\n\u2502       \u251c\u2500\u2500 api-docs.json         # OpenAPI spec archived in May 2025\n\u2502       \u251c\u2500\u2500 criteria/             # paths/parameters extracted from the spec\n\u2502       \u2514\u2500\u2500 repetition_0..9/      # RANDOM/SMARTS/WTS \u00d7 10 repetitions\n\u2502           \u2514\u2500\u2500 <ALGORITHM>/\n\u2502               \u251c\u2500\u2500 generated_tests/       # generated tests (key redacted)\n\u2502               \u251c\u2500\u2500 execution_output.txt   # raw log (real time, potential faults)\n\u2502               \u251c\u2500\u2500 criteria_analyzed/     # coverage per criterion, for this run\n\u2502               \u251c\u2500\u2500 covered_targets.txt\n\u2502               \u2514\u2500\u2500 extracted_test_data.json\n\u251c\u2500\u2500 Dockerfile\n\u2514\u2500\u2500 docker-compose.yaml\n```\n\n## Results: which file is the \"official\" one\n\nThe `results/statistics/` folder contains aggregated summaries from **4\ncomplete runs** (10 repetitions \u00d7 3 techniques each), performed on different\ndates during the study's development. **Only one of them is the dataset\nreported in the paper** \u2014 and it is the only one whose complete raw data is\nin `results/official-run/`:\n\n| Run | Configured `max_time` | Used in the paper? | Raw data included? |\n|---|---|---|---|\n| `experiment-date-03-05-25-time-01-29-53-388` | 15m | No (pilot) | No (summary only) |\n| **`experiment-date-03-05-25-time-21-29-51-725`** | **30m** | **Yes \u2014 official dataset** | **Yes \u2014 `results/official-run/`** |\n| `experiment-date-05-05-25-time-00-15-46-626` | 20m | No (pilot) | No (summary only) |\n| `experiment-date-06-05-25-time-19-56-26-372` | 15m | No (pilot) | No (summary only) |\n\n> **Note:** the actual `max_time` used in the official run (the 21:29:51 one)\n> was 30 minutes per execution, consistent with the 30-minute search budget\n> described in the paper.\n\n### What's in `results/official-run/` that hasn't been used in the paper yet\n\nBeyond what is already reported in the paper's tables, every\n`execution_output.txt` records two metrics that were never explored: **real\nexecution time** (`Passed time (seconds)`) and a count of **fault\nindicators** (`Potential faults`) automatically detected by EvoMaster. The\n`generated_tests/EvoMaster_faults_Test.py` files contain concrete examples of\nthese indicators (endpoint, payload, response). The specification findings\ndiscussed in Section 5.4 of the paper (undeclared status codes, schema\ninconsistencies, pagination typing, etc.) were extracted from exactly these\nfiles; the two metrics themselves (real execution time and fault potential)\nremain an unexplored direction for future work.\n\n## How to reproduce the statistical analysis and figures\n\nEvery statistical number (Shapiro-Wilk, Kruskal-Wallis, Dunn's post-hoc test\nwith Bonferroni correction, Spearman correlation, \u03b7\u00b2_H effect sizes) and every\nresult figure in the paper is recomputed directly from the data already\nincluded in this package (`results/statistics/*.csv` and\n`results/official-run/*/execution_output.txt`) \u2014 there is no need to rerun\nthe experiment for this.\n\n```bash\ncd analysis\npip install -r requirements.txt\npython compute_statistics.py    # prints every number reported in the paper\npython generate_figures.py      # writes the 6 figures to analysis/output/\n```\n\n`compute_statistics.py` was checked number by number against the paper's text\nand tables (Sections 5.1\u20135.3) before being included here. `generate_figures.py`\nreproduces the same figures used in the paper (`../../figuras/` in the main\nrepository) from the raw data.\n\nIf the minimization-phase data (`results/statistics/minimization_analysis.csv`)\nneeds to be regenerated from the raw logs, run this first:\n\n```bash\npython tool/analyze_minimization.py\n```\n\n## How to reproduce the experiment\n\nTo run the experiment again against CMDE (requires your own `x-api-key`, not\nincluded here) or against another REST API with an OpenAPI specification:\n\n1. Copy `tool/configs/em.yaml.example` to `tool/configs/em.yaml` and set\n   `bbSwaggerUrl` to the target API's OpenAPI specification (for CMDE:\n   <https://api-cmde.gestaopresente.mec.gov.br/v1/documentation>), along with\n   `maxTime` and any other desired options\n   ([EvoMaster options documentation](https://github.com/WebFuzzing/EvoMaster/blob/master/docs/options.md)).\n2. Adjust `tool/configs/setup_experiment.json` with the desired algorithms and\n   number of repetitions.\n3. Download `evomaster.jar` (see link above) and place it in `tool/`.\n4. Run with Docker (`docker compose up --build`) or locally\n   (`python tool/main.py`, requires Python 3.8+ and Java 8).\n\nResults are saved under `tool/data_generated/<experiment_name>/`, and the\nstatistics CSV can be generated with:\n\n```bash\npython tool/run_get_statistics_csv.py -n <experiment_name>\n```\n", "readme_present": true, "readme_scrub": {"leaked": false, "hits": {}}, "signals": {"dependency_manifest": ["analysis/requirements.txt"], "container": ["Dockerfile", "docker-compose.yaml"], "build_script": [], "ci_config": [], "licence": ["LICENSE"], "tests": []}, "readme_referenced_paths": ["analyze_minimization.py", "api-docs.json", "compute_statistics.py", "covered_targets.txt", "criteria_analyzer.py", "docker-compose.yaml", "em.yaml", "evomaster.jar", "exceptions.py", "execution_output.txt", "extract_criteria_from_swagger.py", "extract_tests_data.py", "extracted_test_data.json", "generate_figures.py", "generated_tests/EvoMaster_faults_Test.py", "github.com/WebFuzzing/EvoMaster/blob/master/docs/options.md", "helpers.py", "main.py", "minimization_analysis.csv", "requirements.txt", "results/statistics/minimization_analysis.csv", "run_get_statistics_csv.py", "setup_experiment.json", "tool/analyze_minimization.py", "tool/configs/em.yaml", "tool/configs/setup_experiment.json", "tool/main.py", "tool/run_get_statistics_csv.py"], "pushed_at": "2026-08-26T13:30:21Z", "created_at": "2026-08-26T13:19:45Z", "stars": 0, "archived": false}