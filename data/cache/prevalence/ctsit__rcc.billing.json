t/request_correction_of_bad_ownership/redcap_entity_project_ownership.rds", "tests/testthat/request_correction_of_bad_ownership/redcap_projects.rds", "tests/testthat/request_correction_of_bad_ownership/redcap_user_information.rds", "tests/testthat/request_correction_of_bad_ownership/redcap_user_rights.rds", "tests/testthat/request_correction_of_bad_ownership/redcap_user_roles.rds", "tests/testthat/sequester_projects/make_sequester_projects_test_data.R", "tests/testthat/sequester_projects/redcap_entity_project_ownership.rds", "tests/testthat/sequester_projects/redcap_log_event.rds", "tests/testthat/sequester_projects/redcap_log_event3.rds", "tests/testthat/sequester_projects/redcap_log_event4.rds", "tests/testthat/sequester_projects/redcap_log_event6.rds", "tests/testthat/sequester_projects/redcap_log_event7.rds", "tests/testthat/sequester_projects/redcap_log_event8.rds", "tests/testthat/sequester_projects/redcap_log_event9.rds", "tests/testthat/sequester_projects/redcap_projects.rds", "tests/testthat/service_instance/make_test_data.R", "tests/testthat/service_instance/service_instance.rds", "tests/testthat/service_type/make_test_data.R", "tests/testthat/service_type/service_type.rds", "tests/testthat/setup.R", "tests/testthat/test-dates.R", "tests/testthat/test-get_billable_candidates.R", "tests/testthat/test-get_ctsi_study_id_to_project_id_map.R", "tests/testthat/test-get_effective_service_type.R", "tests/testthat/test-get_fiscal_years.R", "tests/testthat/test-get_new_project_invoice_line_items.R", "tests/testthat/test-get_new_project_service_instances.R", "tests/testthat/test-get_orphaned_projects.R", "tests/testthat/test-get_probono_service_request_updates.R", "tests/testthat/test-get_project_details_for_billing.R", "tests/testthat/test-get_service_request_line_items.R", "tests/testthat/test-get_service_request_lines.R", "tests/testthat/test-get_target_projects_to_invoice.R", "tests/testthat/test-get_user_rights_and_info.R", "tests/testthat/test-redcap_projects.R", "tests/testthat/test-redcap_projects_history.R", "tests/testthat/test-redcap_rights.R", "tests/testthat/test-sequester_projects.R", "tests/testthat/test-transform.R", "vignettes/.gitignore", "vignettes/billable_candidates.Rmd", "vignettes/billing_for_support.Rmd", "vignettes/cleanup_bad_email_addresses.Rmd", "vignettes/cleanup_bad_project_pi_email_addresses.Rmd", "vignettes/cleanup_project_ownership_table.Rmd", "vignettes/create_and_send_new_invoice_line_items.Rmd", "vignettes/delete_abandoned_projects.Rmd", "vignettes/images/free_support_time_remaining_banner.png", "vignettes/images/sequestered_project_in_my_projects.png", "vignettes/novel_concepts.Rmd", "vignettes/remind_owners_to_review_ownership.Rmd", "vignettes/request_correction_of_bad_ownership_data.Rmd", "vignettes/revenue_status_and_projections.Rmd", "vignettes/sequester_orphans.Rmd", "vignettes/sequester_unpaid_projects.Rmd", "vignettes/update_free_support_time_remaining.Rmd", "vignettes/update_invoice_line_items_with_invoicing_details.Rmd", "vignettes/update_probono_service_request_records.Rmd", "vignettes/update_project_billable_attribute.Rmd", "vignettes/warn_owners_of_impending_bill.Rmd", "vignettes/when_jobs_run.Rmd"], "readme": "# REDCap Automated Billing\n\n[REDACTED]\n\nREDCap Automated Billing is an automated, data-driven service billing system for a REDCap system. The University of Florida\u2019s CTS-IT designed and wrote this system to charge a modest annual fee for each project and bill for customer support work logged in a REDCap-based service request system. This generates revenue, reduces data privacy risks by incentivizing the deletion of abandoned projects, and improves the quality of research productivity metrics.\n\n## Motivation\n- Generate revenue to offset costs and improve service.\n- Reduce data exposure risk via deletion of unneeded things.\n- Improve the quality of metrics by not counting junk projects.\n- Reduce support staff workload.\n\n## What we learned\n- We can make money by charging for REDCap services.\n- Charges are a tool to incentivize customer behavior.\n- Good people data and project ownership data are required.\n- There is no such thing as over-communication.\n- Partner with your fiscal team.\n- Use an incremental and iterative approach.\n- Automate everything.\n\n## Novel Concepts\n\nREDCap Automated Billing introduces some concepts outside the normal scope of a REDCap system. These are described in [Novel Concepts](https://ctsit.github.io/rcc.billing/articles/novel_concepts.html)\n\n## Billing for support work\n\nThe complexities of billing for REDCap support work are described in [Billing for REDCap support work](https://ctsit.github.io/rcc.billing/articles/billing_for_support.html)\n\n## Business workflows\n- Cleaning person data\n  - [cleanup_bad_email_addresses](https://ctsit.github.io/rcc.billing/articles/cleanup_bad_email_addresses.html)\n  - [cleanup_bad_project_pi_email_addresses](https://ctsit.github.io/rcc.billing/articles/cleanup_bad_project_pi_email_addresses.html)\n  \n- Cleaning ownership data\n  - [cleanup_project_ownership_table](https://ctsit.github.io/rcc.billing/articles/cleanup_project_ownership_table.html)\n  - Ban accounts/emails of people who left your institution. See  [update_invoice_line_items_with_invoicing_details](https://ctsit.github.io/rcc.billing/articles/update_invoice_line_items_with_invoicing_details.html)\n\n\n- Exempt special people and special projects from billing\n  - [update_project_billable_attribute](https://ctsit.github.io/rcc.billing/articles/update_project_billable_attribute.html)  \n\n\n- Manage abandoned projects\n  - [delete_abandoned_projects](https://ctsit.github.io/rcc.billing/articles/delete_abandoned_projects.html)\n  - [sequester_orphans](https://ctsit.github.io/rcc.billing/articles/sequester_orphans.html)\n\n- Create & Manage charging records\n  - [create_and_send_new_invoice_line_items](https://ctsit.github.io/rcc.billing/articles/create_and_send_new_invoice_line_items.html)\n  - [update_invoice_line_items_with_invoicing_details](https://ctsit.github.io/rcc.billing/articles/update_invoice_line_items_with_invoicing_details.html)\n  - [sequester_unpaid_projects](https://ctsit.github.io/rcc.billing/articles/sequester_unpaid_projects.html)\n  - cancel_invoice_line_items (Ad hoc)\n\n- Manage organizational data\n  - write_uf_fiscal_orgs_to_org_hierarchies (temporarily disabled)\n  - write_uf_fiscal_orgs_to_person_org (temporarily disabled)\n\n- Manage pro bono service request work\n  - [update_free_support_time_remaining](https://ctsit.github.io/rcc.billing/articles/update_free_support_time_remaining.html)\n  - [update_probono_service_request_records](https://ctsit.github.io/rcc.billing/articles/update_probono_service_request_records.html)\n\n- Internal reporting\n  - [billable_candidates](https://ctsit.github.io/rcc.billing/articles/billable_candidates.html)\n  - [revenue_status_and_projections](https://ctsit.github.io/rcc.billing/articles/revenue_status_and_projections.html)\n\n- Manage customer communications\n  - [remind_owners_to_review_ownership](https://ctsit.github.io/rcc.billing/articles/remind_owners_to_review_ownership.html)\n  - [request_correction_of_bad_ownership_data](https://ctsit.github.io/rcc.billing/articles/request_correction_of_bad_ownership_data.html)\n  - [warn_owners_of_impending_bill](https://ctsit.github.io/rcc.billing/articles/warn_owners_of_impending_bill.html)\n\n\n## When jobs run\n\nMost ETLs and reports are run in a regular basis via Cron. The schedule of those events can be found at [When jobs run](https://ctsit.github.io/rcc.billing/articles/when_jobs_run.html)\n", "readme_present": true, "readme_scrub": {"leaked": true, "hits": {"badge_image": 1}}, "signals": {"dependency_manifest": [], "container": ["Dockerfile"], "build_script": ["build.sh"], "ci_config": [".github/workflows/pkgdown.yaml"], "licence": ["LICENSE.md"], "tests": ["tests/testthat.R"]}, "readme_referenced_paths": ["ctsit.github.io/rcc.billing/articles/billable_candidates.html", "ctsit.github.io/rcc.billing/articles/billing_for_support.html", "ctsit.github.io/rcc.billing/articles/cleanup_bad_email_addresses.html", "ctsit.github.io/rcc.billing/articles/cleanup_bad_project_pi_email_addresses.html", "ctsit.github.io/rcc.billing/articles/cleanup_project_ownership_table.html", "ctsit.github.io/rcc.billing/articles/create_and_send_new_invoice_line_items.html", "ctsit.github.io/rcc.billing/articles/delete_abandoned_projects.html", "ctsit.github.io/rcc.billing/articles/novel_concepts.html", "ctsit.github.io/rcc.billing/articles/remind_owners_to_review_ownership.html", "ctsit.github.io/rcc.billing/articles/request_correction_of_bad_ownership_data.html", "ctsit.github.io/rcc.billing/articles/revenue_status_and_projections.html", "ctsit.github.io/rcc.billing/articles/sequester_orphans.html", "ctsit.github.io/rcc.billing/articles/sequester_unpaid_projects.html", "ctsit.github.io/rcc.billing/articles/update_free_support_time_remaining.html", "ctsit.github.io/rcc.billing/articles/update_invoice_line_items_with_invoicing_details.html", "ctsit.github.io/rcc.billing/articles/update_probono_service_request_records.html", "ctsit.github.io/rcc.billing/articles/update_project_billable_attribute.html", "ctsit.github.io/rcc.billing/articles/warn_owners_of_impending_bill.html", "ctsit.github.io/rcc.billing/articles/when_jobs_run.html"], "pushed_at": "2026-08-28T20:39:06Z", "created_at": "2022-03-21T20:45:15Z", "stars": 0, "archived": false}