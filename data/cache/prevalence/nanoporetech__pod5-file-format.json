n_tmp_dir.py", "python/pod5/src/tests/test_script/check_migration_tmp_dir_bad_input.py", "python/pod5/src/tests/test_signal_tools.py", "python/pod5/src/tests/test_subset.py", "python/pod5/src/tests/test_tools.py", "python/pod5/src/tests/test_update.py", "python/pod5/src/tests/test_view.py", "python/pod5/src/tests/test_writer.py", "python/pod5/test_utils/check_pod5_files_equal.py", "test_data/multi_fast5_zip.fast5", "test_data/multi_fast5_zip_v0.pod5", "test_data/multi_fast5_zip_v1.pod5", "test_data/multi_fast5_zip_v2.pod5", "test_data/multi_fast5_zip_v3.pod5", "test_data/multi_fast5_zip_v4.pod5", "test_data/multi_fast5_zip_v5.pod5", "test_data/single_read_fast5/fe85b517-62ee-4a33-8767-41cab5d5ab39.fast5.single-read", "test_data/split_1_v4.pod5", "test_data/split_2_v4.pod5", "test_data/subset_mapping_examples/read_ids.txt", "test_data/subset_mapping_examples/subset.csv", "test_data/subset_mapping_examples/subset.summary", "test_package/CMakeLists.txt", "test_package/conanfile.py", "test_package/test_cpp_api.cpp", "test_package/test_package.cpp", "third_party/build_instructions.txt", "third_party/gsl-disable-gsl-suppress.patch", "third_party/include/.editorconfig", "third_party/include/catch2/catch.hpp", "third_party/include/gsl.h", "third_party/include/gsl/gsl", "third_party/include/gsl/gsl-lite-vc6.hpp", "third_party/include/gsl/gsl-lite.h", "third_party/include/gsl/gsl-lite.hpp", "third_party/jsoncons-0.166-icc-fix.patch", "third_party/licenses/catch2.txt", "third_party/licenses/gsl-lite.txt", "third_party/software_versions.yaml"], "readme": "[REDACTED]\n[REDACTED]\n\nPOD5 File Format\n================\n\nPOD5 File Format\n================\n\nPOD5 is a file format for storing nanopore dna data in an easily accessible way.\nThe format is able to be written in a streaming manner which allows a sequencing\ninstrument to directly write the format.\n\nData in POD5 is stored using [Apache Arrow](https://github.com/apache/arrow), allowing\nusers to consume data in many languages using standard tools.\n\nWhat does this project contain\n------------------------------\n\nThis project contains a core library for reading and writing POD5 data, and a toolkit for\naccessing this data in other languages.\n\nDocumentation\n-------------\n\nFull documentation is found at https://software-docs.nanoporetech.com/pod5\n\n\nUsage\n-----\n\nPOD5 is also bundled as a python module for easy use in scripts, a user can install using:\n\n```bash\n> pip install pod5\n```\n\nThis python module provides the python library to write custom scripts against.\n\nPlease see [examples](./python/pod5/examples) for documentation on using the library.\n\nThe `pod5` package also provides [a selection of tools](./python/pod5/README.md).\n\n\nDesign\n------\n\nFor information about the design of POD5, see the [docs](./docs/README.md).\n\nDevelopment\n-----------\n\nIf you want to contribute to pod5_file_format, or our pre-built binaries do not meet your platform requirements, you can build pod5 from source using the instructions in [DEV.md](DEV.md)\n", "readme_present": true, "readme_scrub": {"leaked": true, "hits": {"badge_image": 2}}, "signals": {"dependency_manifest": ["pyproject.toml", "python/lib_pod5/setup.py"], "container": [], "build_script": ["CMakeLists.txt", "benchmarks/build.sh", "ci/install.sh", "python/lib_pod5/Makefile"], "ci_config": [".gitlab-ci.yml"], "licence": ["LICENSE.md"], "tests": []}, "readme_referenced_paths": ["DEV.md", "docs/README.md", "python/pod5/README.md"], "pushed_at": "2026-08-24T13:05:08Z", "created_at": "2022-05-04T14:54:03Z", "stars": 177, "archived": false}