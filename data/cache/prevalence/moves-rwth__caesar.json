n-32x32.png", "website/static/favicon-48x48.png", "website/static/favicon-512x512.png", "website/static/favicon.ico", "website/static/img/architecture-oopsla23.afdesign", "website/static/img/architecture-oopsla23.svg", "website/static/img/assumption-slicing-demo.png", "website/static/img/calculi-demo.png", "website/static/img/expected-value.afdesign", "website/static/img/expected-value.svg", "website/static/img/general-slicing-demo.png", "website/static/img/heyvl.afdesign", "website/static/img/heyvl.svg", "website/static/img/i2.svg", "website/static/img/laurel-square.afdesign", "website/static/img/laurel-square.svg", "website/static/img/laurel.svg", "website/static/img/logos.afdesign", "website/static/img/logos.svg", "website/static/img/slicing-demo.png", "website/static/img/social-card.afdesign", "website/static/img/social-card.png", "website/static/img/vc-demo.png", "website/yarn.lock", "z3rro/Cargo.toml", "z3rro/README.md", "z3rro/src/array.rs", "z3rro/src/eureal/concrete.rs", "z3rro/src/eureal/datatype.rs", "z3rro/src/eureal/mod.rs", "z3rro/src/eureal/pair.rs", "z3rro/src/fuel.rs", "z3rro/src/interpreted.rs", "z3rro/src/lib.rs", "z3rro/src/list.rs", "z3rro/src/lit.rs", "z3rro/src/model.rs", "z3rro/src/orders.rs", "z3rro/src/params.rs", "z3rro/src/probes.rs", "z3rro/src/prover.rs", "z3rro/src/quantifiers.rs", "z3rro/src/scope.rs", "z3rro/src/smtlib.rs", "z3rro/src/test.rs", "z3rro/src/uint.rs", "z3rro/src/ureal.rs", "z3rro/src/util.rs"], "readme": "# Caesar\n\n_Caesar_ is a deductive verification platform for probabilistic programs.\nIt accepts input in a verification language called _HeyVL_.\nCaesar generates so-called verification conditions of the HeyVL input program(s).\nThese verification conditions are in the form of logical formulas of a logic we call _HeyLo_.\nIf the verification conditions are valid, then we say the HeyVL program _verifies_.\nIf a counter-example is found, Caesar will reject the input program.\n\n**This is research software** and we're still working on a nice user interface, documentation, and fixing bugs.\nDo not hesitate to open an issue or send an email to phisch@cs.rwth-aachen.de with questions or ideas.\nI am also happy to discuss anything via Zoom as well!\n\n**The documentation is available at [www.caesarverifier.org](https://www.caesarverifier.org).**\nStart at with the [introduction](https://www.caesarverifier.org/docs/), then walk through the [getting started guide](https://www.caesarverifier.org/docs/getting-started/).\n\nWe have an OOPSLA 2023 paper on Caesar and its theory: [_A Deductive Verification Infrastructure for Probabilistic Programs_](https://doi.org/10.1145/3622870).\nYou can [find the preprint on arxiv](https://arxiv.org/abs/2309.07781).\n\nThere is also a [development guide](https://www.caesarverifier.org/docs/devguide) if you want to work on Caesar itself.\n", "readme_present": true, "readme_scrub": {"leaked": false, "hits": {}}, "signals": {"dependency_manifest": ["pgcl/pgcl2heyvl/poetry.lock", "pgcl/pgcl2heyvl/pyproject.toml", "vscode-ext/package.json"], "container": [".devcontainer/Dockerfile"], "build_script": [], "ci_config": [".github/workflows/build-binaries-gh_release.yml"], "licence": ["LICENSE"], "tests": ["tests/README.md"]}, "readme_referenced_paths": [], "pushed_at": "2026-07-23T12:54:03Z", "created_at": "2023-09-08T06:21:01Z", "stars": 30, "archived": false}