ing/rplots/img-gen/training_coeffs_seed1000.pdf", "plotting/rplots/img-gen/training_coeffs_seed1001.pdf", "plotting/rplots/img-gen/training_coeffs_seed1002.pdf", "plotting/rplots/img-gen/training_coeffs_seed1003.pdf", "plotting/rplots/img-gen/training_coeffs_seed1004.pdf", "plotting/rplots/img-gen/training_coeffs_seed1005.pdf", "plotting/rplots/img-gen/training_coeffs_seed1006.pdf", "plotting/rplots/img-gen/training_coeffs_seed1007.pdf", "plotting/rplots/img-gen/training_coeffs_seed1008.pdf", "plotting/rplots/img-gen/training_coeffs_seed1009.pdf", "plotting/rplots/img-gen/training_ent.pdf", "plotting/rplots/img-gen/training_mse.pdf", "plotting/rplots/img.tex", "plotting/rplots/layout.r", "plotting/rplots/plot_coeffs.r", "plotting/rplots/plot_coeffs_all.r", "plotting/rplots/plot_coeffs_encoding.r", "plotting/rplots/plot_coeffs_mean.r", "plotting/rplots/plot_coeffs_phase.r", "plotting/rplots/plot_coherent.r", "plotting/rplots/plot_ent.r", "plotting/rplots/plot_expr.r", "plotting/rplots/plot_single.r", "plotting/rplots/plot_training.r", "poetry.lock", "pyproject.toml", "requirements.txt", "scripts/plot_all.sh", "scripts/plot_single.sh", "scripts/run.sh", "scripts/run_coefficient_config.sh", "scripts/run_entanglement_config.sh", "scripts/run_expressibility_config.sh", "scripts/run_paper_experiments.sh", "scripts/run_training_config.sh", "slurm/check_logs.sh", "slurm/clear_logs.sh", "slurm/create_experiment.sh", "slurm/list_mlruns.sh", "slurm/list_runs.sh", "slurm/slurm_job.sh", "slurm/sweep_circuits_seed.sh", "slurm/sweep_encoding_circuits_seed.sh", "slurm/sweep_noise_circuits_seed.sh", "slurm/sweep_qubits_encoding_circuits_seed.sh", "slurm/sweep_qubits_noise_circuits_seed.sh", "slurm/sweep_seeds.sh", "src/effects_of_noise_in_qfm/__init__.py", "src/effects_of_noise_in_qfm/__main__.py", "src/effects_of_noise_in_qfm/datasets/mlflow_dataset.py", "src/effects_of_noise_in_qfm/helpers/utils.py", "src/effects_of_noise_in_qfm/pipeline_registry.py", "src/effects_of_noise_in_qfm/pipelines/__init__.py", "src/effects_of_noise_in_qfm/pipelines/data_generation/nodes.py", "src/effects_of_noise_in_qfm/pipelines/data_generation/pipeline.py", "src/effects_of_noise_in_qfm/pipelines/data_science/coefficients/nodes.py", "src/effects_of_noise_in_qfm/pipelines/data_science/coefficients/pipeline.py", "src/effects_of_noise_in_qfm/pipelines/data_science/entanglement/nodes.py", "src/effects_of_noise_in_qfm/pipelines/data_science/entanglement/pipeline.py", "src/effects_of_noise_in_qfm/pipelines/data_science/expressibility/nodes.py", "src/effects_of_noise_in_qfm/pipelines/data_science/expressibility/pipeline.py", "src/effects_of_noise_in_qfm/pipelines/data_science/training/nodes.py", "src/effects_of_noise_in_qfm/pipelines/data_science/training/pipeline.py", "src/effects_of_noise_in_qfm/pipelines/visualization/nodes.py", "src/effects_of_noise_in_qfm/pipelines/visualization/pipeline.py", "src/effects_of_noise_in_qfm/settings.py", "tests/__init__.py", "tests/pipelines/__init__.py", "tests/test_run.py"], "readme": "# Out of Tune: Demystifying Noise-Effects on Quantum Fourier Models\n\nThis repository contains the source code and additional results for our paper \"Out of Tune: Demystifying Noise-Effects on Quantum Fourier Models\".\nA preprint is available on [ArXiv](https://arxiv.org/abs/2506.09527).\n\n## Results\n\nLooking for supplementary results beyond the scope of the paper? :eyes:\nHead over to the [results page](https://cirkiters.github.io/effect-of-noise-in-qfms/).\n\n## Getting Started :rocket:\n\nThis repository uses [Kedro](https://kedro.org/). To get started, follow these steps:\n1. Clone this repository\n2. Run `poetry install` or `pip install -r requirements.txt`\n3. Run the experiment: `kedro run`\n\nExperiments are automatically recorded using [MlFlow](https://mlflow.org/). You can view the experiments by\n1. Running `poetry run kedro mlflow ui`\n2. Navigating to [http://127.0.0.1:5000](http://127.0.0.1:5000)\n\nTo visualize the nodes and pipeline\n1. Run `poetry run kedro viz`\n2. Navigating to [http://127.0.0.1:4141](http://127.0.0.1:4141)\n\n## Tweaking :wrench:\n\n- To specify a pipeline: `kedro run --pipeline NAME`\n- Parameters can be adjusted in `conf/base/parameters.yml` or as command line arguments `--params=<key1>=<value1>`\n\n## Reproduction\n\n### Docker\n\n#### Get docker image\n\nDownload image from github registry:\n```\ndocker pull ghcr.io/cirkiters/effect-of-noise-in-qfms/effect_of_noise_repro:latest\n```\n\nOr download `effect_of_noise_repro.tar` from [Zenodo](https://doi.org/10.5281/zenodo.16963959) and load:\n```\ndocker load -i effect_of_noise_repro.tar\n```\n\nOr build image:\n\n```\ndocker build -t effect_of_noise_repro .\n```\n\n#### Create Container\n\n```\ndocker run --name effect_of_noise_repro_cont [<-flags>] -it effect_of_noise_repro [<option>]\n```\n\nThe `<option>` specifies which operations are performed on container start.\n\nAvailable options are:\n* `experiments_paper`\\*: performs all experiments shown in the paper\n* `plot_paper_results`: generates the the plots for the paper using R (only available if either the paper experiments are run first, or result data is downloaded from [Zenodo](https://doi.org/10.5281/zenodo.16963959))\n* `coefficients`: performs coefficient experiment based on the [configuration](conf/base/parameters.yml)\n* `entanglement`: performs entanglement experiment based on the [configuration](conf/base/parameters.yml)\n* `expressibility`: performs entanglement experiment based on the [configuration](conf/base/parameters.yml)\n* `training`: performs training experiment based on the [configuration](conf/base/parameters.yml)\n* `bash`(default): does not perform any operation, but launches interactive shell, default\n\nFeel free to define additional `<-flags>`, we recommend volumes, e.g.:\nVolumes, to keep track of generated files and configuration on the host system:\n```\n-v $PWD/mlruns:/home/repro/effect-of-noise-in-qfms/mlruns -v $PWD/plotting:/home/repro/effect-of-noise-in-qfms/plotting -v $PWD/conf/base:/home/repro/effect-of-noise-in-qfms/conf/base\n```\n\n\\*Please note the long runtimes when executing all experiments (hours to days).\nFor quickly inspecting our reproduction package, we recommend to use the other options.\n\n#### Start a stopped container\n\nNot done yet? You do not have to run a new container for new experiments. Just call:\n```\ndocker start -i effect_of_noise_repro_cont\n```\nand check out the [scripts](scripts/) folder, or the [instructions](#tweaking-wrench) above.\n", "readme_present": true, "readme_scrub": {"leaked": false, "hits": {}}, "signals": {"dependency_manifest": ["poetry.lock", "pyproject.toml", "requirements.txt"], "container": ["Dockerfile"], "build_script": ["plotting/rplots/Makefile"], "ci_config": [".github/workflows/build-docker.yml"], "licence": ["LICENSE"], "tests": ["tests/__init__.py"]}, "readme_referenced_paths": ["conf/base/parameters.yml", "requirements.txt"], "pushed_at": "2025-09-02T08:40:36Z", "created_at": "2024-06-10T10:06:37Z", "stars": 0, "archived": false}