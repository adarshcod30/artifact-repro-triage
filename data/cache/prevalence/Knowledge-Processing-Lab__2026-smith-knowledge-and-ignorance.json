periment-3_participant-024_data.csv", "data/primary/experiment_3/experiment-3_participant-025_data.csv", "data/primary/experiment_3/experiment-3_participant-026_data.csv", "data/primary/experiment_3/experiment-3_participant-027_data.csv", "data/primary/experiment_3/experiment-3_participant-028_data.csv", "data/primary/experiment_3/experiment-3_participant-029_data.csv", "data/primary/experiment_3/experiment-3_participant-030_data.csv", "data/primary/experiment_3/experiment-3_participant-031_data.csv", "data/primary/experiment_3/experiment-3_participant-032_data.csv", "data/primary/experiment_3/experiment-3_participant-033_data.csv", "data/primary/experiment_3/experiment-3_participant-034_data.csv", "data/primary/experiment_3/experiment-3_participant-035_data.csv", "data/primary/experiment_3/experiment-3_participant-036_data.csv", "data/primary/experiment_3/experiment-3_participant-037_data.csv", "data/primary/experiment_3/experiment-3_participant-038_data.csv", "data/primary/experiment_3/experiment-3_participant-039_data.csv", "data/primary/experiment_3/experiment-3_participant-040_data.csv", "data/primary/experiment_3/experiment-3_participant-041_data.csv", "data/primary/experiment_3/experiment-3_participant-042_data.csv", "data/primary/experiment_3/experiment-3_participant-043_data.csv", "data/primary/experiment_3/experiment-3_participant-044_data.csv", "data/primary/experiment_3/experiment-3_participant-045_data.csv", "data/primary/experiment_3/experiment-3_participant-046_data.csv", "data/primary/experiment_3/experiment-3_participant-047_data.csv", "data/primary/experiment_3/experiment-3_participant-048_data.csv", "data/primary/experiment_3/experiment-3_participant-049_data.csv", "data/primary/experiment_3/experiment-3_participant-050_data.csv", "data/primary/experiment_3/experiment-3_participant-051_data.csv", "data/primary/experiment_3/experiment-3_participant-052_data.csv", "data/primary/experiment_3/experiment-3_participant-053_data.csv", "data/primary/experiment_3/experiment-3_participant-054_data.csv", "data/primary/experiment_3/experiment-3_participant-055_data.csv", "data/primary/experiment_3/experiment-3_participant-056_data.csv", "data/primary/experiment_3/experiment-3_participant-057_data.csv", "data/primary/experiment_3/experiment-3_participant-058_data.csv", "data/primary/experiment_3/experiment-3_participant-059_data.csv", "data/primary/experiment_3/experiment-3_participant-060_data.csv", "data/primary/experiment_3/experiment-3_participant-061_data.csv", "data/processed/.gitignore", "data/processed/directory_metadata.json", "dataset_description.json", "materials/FB-Ig.png", "materials/TB-Ig-B.png", "materials/TB-K-B.png", "materials/TB-K-NB.png", "outputs/.gitignore", "renv.lock", "renv/.gitignore", "renv/activate.R", "renv/settings.json", "tests/snapshots/raw_data_snapshot.rds"], "readme": "# Knowledge and Ignorance Processing is Faster than Belief Processing (2026)\n\nThis repository contains the code required to reproduce all data processing, analyses, figures and tables reported in the manuscript.\n\nAuthors: *Alex Smith\u00b9, Emmanuele Tidoni\u00b9 \u00b2, Tom Peney\u00b9, Richard J O\u2019Connor\u00b9 & Kevin J Riggs\u00b9*\n\n\u00b9 School of Psychology, University of Hull, Hull, UK\n\n\u00b2 School of Psychology, University of Leeds, Leeds, UK\n\n## Preparation for reproduction\n\n### Prerequisites\n\n* R 4.6.1\n* `renv` (for versioned package installation)\n* [Optional] Quarto (for document rendering)\n\n### Setup Instructions\n\nPrimary data is included under `data/primary`. If for whatever reason the checksum warning flags that a data validation error has occurred, data can be redownloaded from the Zenodo archive. [REDACTED]\n\n1. Clone the repository (or download the `.zip` and extract it):\n\n   ```powershell\n   git clone https://github.com/Knowledge-Processing-Lab/2026-smith-knowledge-and-ignorance.git\n   cd 2026-smith-knowledge-and-ignorance\n   ```\n\n2. *Optional:* If your IDE uses projects (e.g., RStudio), open the new directory as a project before continuing.\n\n3. Install `renv`, if you have not done so already.\n\n   ```R\n   install.packages(\"renv\")\n   ```\n\n4. Restore the project library and install R dependencies:\n\n   ```R\n   renv::restore()\n   ```\n\n**Notes**\n\n* You may be prompted to activate the project first. Once activated, re-run `renv::restore()` to begin package installation.\n\n* If any packages fail to build, you may need [RTools](https://cran.r-project.org/bin/windows/Rtools/) (Windows only).\n\n## Instructions for reproducing the analysis\n\nOnce the environment has been setup, run `_main.R`. This will run each analysis script in the correct order. \n\nA printed report `_experiment_report.html` will be created for simplified viewing of the results. Opening the file should display the report in your default web browser. \n\n* To avoid using Quarto, you can run each script in `/code` manually and print the `results` object to the console. \n\nFigures and tables are created under `outputs/figures` and `outputs/tables` respectively. \n\n**N.B.** The 'Denying Knowledge' result of Experiment 2 is reported under Supplementary Test 1.\n\n## Additional Information\n\n* Estimated time for reproduction: It should be possible to complete the above steps in under 30 minutes.\n* The analysis code was run and verified on a Windows 11 x64 (build 26200) system.\n* Each data directory contains a machine-readable `directory_metadata.json` file which includes definitions for all columns in the associated data files.\n* This repository conforms to the [Psych-DS](https://psych-ds.github.io/) data standard.\n\n## Funding and contact\n\nThis work was supported by the Economic and Social Research Council (UKRI559).\n\nQuestions and issues: Please contact Tom Peney ([T.Peney@hull.ac.uk](mailto:T.Peney@hull.ac.uk)) or open an issue on this repository.\n\n## Licence\n\nCode is released under the MIT licence. Data and materials are released under CC-BY-4.0.\n\n## Abstract\n\nHumans routinely track what others know, believe, and are ignorant of. Much of social cognition research, however, focuses on belief attribution, with knowledge and ignorance underexplored. Competing theories treat knowledge as either a specific form of belief (justified true belief) or as a distinct and more foundational mental state. We tested these accounts across three preregistered experiments. Participants read statements about either reality, knowledge or belief and then judged whether these statements were true of a subsequently presented image. Response times revealed a consistent hierarchy: reality judgments were fastest; followed by knowledge and then belief. Participants were also faster to deny knowledge (attribute ignorance) than to deny belief. These findings challenge traditional philosophical belief-based accounts of knowledge and suggest instead that knowledge is a more fundamental mental state not reducible to belief, with implications for theory of mind architecture and the modelling of mental states in AI systems.", "readme_present": true, "readme_scrub": {"leaked": true, "hits": {"badge_image": 1}}, "signals": {"dependency_manifest": [], "container": [], "build_script": [], "ci_config": [], "licence": [], "tests": ["tests/snapshots/raw_data_snapshot.rds"]}, "readme_referenced_paths": ["_experiment_report.html", "_main.R", "directory_metadata.json"], "pushed_at": "2026-08-28T09:12:37Z", "created_at": "2026-08-24T13:22:56Z", "stars": 0, "archived": false}