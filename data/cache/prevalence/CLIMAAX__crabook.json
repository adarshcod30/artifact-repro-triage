hange.png", "crabook/images/top/climaax_project.png", "crabook/images/top/funding_opportunities.png", "crabook/images/top/regional_examples.png", "crabook/images/top/top_droughts.png", "crabook/images/top/top_fire.png", "crabook/images/top/top_floods.png", "crabook/images/top/top_heatwaves.png", "crabook/images/top/top_heavy_rainfall.png", "crabook/images/top/top_multi.png", "crabook/images/top/top_snow.png", "crabook/images/top/top_wind.png", "crabook/images/vuln_curve_adjustment_method.png", "crabook/images/vuln_curve_buidling_types_europe_koks.png", "crabook/images/vuln_curve_flood_huizinga.png", "crabook/images/vuln_curve_wind_feuerstein.png", "crabook/images/vuln_curve_wind_feuerstein_adjusted.png", "crabook/intro.md", "crabook/logo.png", "crabook/notebooks/workflows/droughts.md", "crabook/notebooks/workflows/fire.md", "crabook/notebooks/workflows/floods.md", "crabook/notebooks/workflows/heatwaves.md", "crabook/notebooks/workflows/heavy_rainfall.md", "crabook/notebooks/workflows/multi.md", "crabook/notebooks/workflows/snow.md", "crabook/notebooks/workflows/src/FIRE/01_wildfire_ML/shared_funcs.md", "crabook/notebooks/workflows/storms.md", "crabook/notebooks/workflows_how_to.md", "crabook/notebooks/workflows_how_to/cli.md", "crabook/notebooks/workflows_how_to/docker.md", "crabook/notebooks/workflows_how_to/jupyterlab_desktop.md", "crabook/placeholder.md", "crabook/resources/FAQ.md", "crabook/resources/FAQ/maximum_damages.md", "crabook/resources/FAQ/vulnerability_curves.md", "crabook/resources/dashboards.md", "crabook/resources/datasets.md", "crabook/resources/datasets/droughtrisk_sample_nuts3.md", "crabook/resources/datasets/eclips2.0_mirror.md", "crabook/resources/datasets/effis_mirror.md", "crabook/resources/datasets/fwi_1981-2010_europe.md", "crabook/resources/datasets/precipitation_idf_europe.md", "crabook/resources/datasets/river_discharges_mirror.md", "crabook/resources/datasets/wildfire_sample_cat.md", "crabook/resources/definitions.md", "crabook/resources/geonode.md", "crabook/resources/glossary.md", "crabook/resources/guiding_questions.md", "crabook/resources/jupyterhub/info.md", "crabook/resources/jupyterhub/tips.md", "crabook/resources/servicedesk.md", "crabook/resources/software.md", "crabook/resources/support.md", "requirements.txt"], "readme": "# Climate Risk Assessment Handbook\n\nVisit the Handbook at https://handbook.climaax.eu/\n\n<img src=\"https://raw.githubusercontent.com/CLIMAAX/crabook/main/crabook/logo.png\" height=\"100\" />\n\n\n## See also\n\n- [Release notes](https://github.com/CLIMAAX/crabook/releases)\n- [Discussion forum](https://github.com/CLIMAAX/crabook/discussions)\n- [Catalogue of workflow applications](https://github.com/CLIMAAX/examples)\n- [Community of Practice](https://www.climaax.eu/community-of-practice/)\n- [CLIMAAX homepage](https://climaax.eu/)\n- [10.5281/zenodo.18186357](https://doi.org/10.5281/zenodo.18186357)\n- [EU Mission on Adaptation to Climate Change](https://www.climaax.eu/eu-mission-on-adaptation-to-climate-change/)\n\n\n## Development\n\n### Setting up\n\n```bash\n# Clone the Handbook repository\ngit clone https://github.com/CLIMAAX/crabook.git\ncd crabook\n\n# Clone all workflow repositories\ngit submodule update --init --recursive\n\n# Set up the Python environment (here with conda and pip)\nconda create -n crabook python=3.13 pip\nconda activate crabook\npip install -r requirements.txt\n```\n\n### Building the book\n\nTo build the HTML version of the Handbook (in `crabook/_build/html/`):\n\n```bash\njb build crabook\n```\n\nTo remove existing builds:\n\n```bash\njb clean crabook\n```\n\n### Release process\n\n1. Tag all submodule repositories that have changed since the last release.\n2. Tag the Handbook and create a release from the tag. Provide release notes for changes from all repositories.\n3. The zenodo-upload action creates a new Zenodo version draft. [Go to Zenodo](https://zenodo.org/records/18196375), enter the new version dialogue, check the file contents, update the list of contributors if necessary, fill in the publication date, and the version number and publish.\n4. Announce the new release on the Handbook discussion forum.\n\n\n## License\n\n`Apache-2.0 OR CC-BY-4.0` ([SPDX license identifier](https://spdx.dev/learn/handling-license-info/)).\n\n\n## Acknowledgements\n\nThis project has received funding from the European Union\u2019s Horizon Europe \u2013 the Framework Programme for Research and Innovation (2021-2027) under grant agreement No. 101093864.\n", "readme_present": true, "readme_scrub": {"leaked": false, "hits": {}}, "signals": {"dependency_manifest": ["requirements.txt"], "container": [], "build_script": [], "ci_config": [".github/workflows/build-deploy-book.yml"], "licence": [], "tests": []}, "readme_referenced_paths": ["requirements.txt"], "pushed_at": "2026-08-28T16:44:12Z", "created_at": "2023-05-30T15:13:07Z", "stars": 19, "archived": false}