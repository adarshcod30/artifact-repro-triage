ce_access_notes.md", "pytest.ini", "reproduction_metadata.json", "requirements.txt", "run_analysis.sh", "scripts/analyze_gpu_measurements.py", "scripts/analyze_statistical_significance.py", "scripts/audit_revision_outputs.py", "scripts/benchmark_scalability.py", "scripts/build_gpu_paper_results.py", "scripts/build_revision_manuscript_artifacts.py", "scripts/collect_gpu_power_sla.py", "scripts/download_or_prepare_caiso_multiday.py", "scripts/download_or_prepare_philly.py", "scripts/draw_revision_figures.py", "scripts/recompute_revision_bounds.py", "scripts/run_gpu_burst_recovery_matrix.py", "scripts/run_gpu_measurement_matrix.py", "scripts/run_policy_certification.py", "scripts/run_rolling_temporal_certification.py", "scripts/run_temporal_conditional_certification.py", "scripts/validate_temporal_certificate.py", "src/__init__.py", "src/config.py", "src/data/__init__.py", "src/data/alibaba_gpu.py", "src/data/azure_llm.py", "src/data/caiso.py", "src/data/loaders.py", "src/data/philly.py", "src/evaluation/__init__.py", "src/evaluation/dependence_aware.py", "src/evaluation/metrics.py", "src/modeling/__init__.py", "src/modeling/advanced_baselines.py", "src/modeling/calibration.py", "src/modeling/flexibility.py", "src/modeling/inference_replay.py", "src/modeling/joint_assurance.py", "src/plotting/__init__.py", "src/plotting/calibration_repair.py", "src/plotting/hierarchical_calibration.py", "src/plotting/mvp_figures.py", "src/plotting/summary.py", "src/preprocessing/__init__.py", "src/preprocessing/power.py", "src/preprocessing/tiers.py", "src/simulation/__init__.py", "src/simulation/contracts.py", "src/simulation/methods.py", "src/simulation/run_mvp.py", "tests/test_azure_llm_mapping.py", "tests/test_dependence_aware.py", "tests/test_policy_certification.py", "verify_reproduction.py"], "readme": "# FlexSure-Cert reproduction package\n\nThis version supports the manuscript **FlexSure-Cert: Dependence-Aware\nMulti-Risk Certification for Grid-Responsive Artificial Intelligence Data\nCenters**.\n\n## What version 2 changes\n\nVersion 2.0.0 replaces the earlier independence-sensitive certification\nlayer with fixed-window mixture-supermartingale bounds for bounded adapted\nlosses under predictable participation. It also archives conditional failure\ncounts, four non-overlapping chronological stages, certification-power tables,\nrolling folds, ablations, complete parameter and provenance ledgers, and the\ncontrolled A100 evidence used by the revised manuscript.\n\n## Fast verification\n\nPython 3.11 or newer is recommended.\n\n```bash\npython -m venv .venv\nsource .venv/bin/activate\npython -m pip install -r requirements.txt\nbash run_analysis.sh\n```\n\nThe verification checks every archived checksum, asserts the central reported\nquantities, runs the tests and primary/rolling audits, regenerates the manuscript\ntables, and redraws all five figures plus the graphical abstract from archived\ntables. Raw source traces are not required for this fast route.\n\n## Full experiment routes\n\nAfter obtaining the public source traces listed in\n`provenance/raw_input_manifest.csv`, the principal commands are:\n\n```bash\npython scripts/run_temporal_conditional_certification.py \\\n  --config configs/philly_caiso_oasis_365d_conditional.yaml \\\n  --output-dir outputs/philly_caiso_oasis_365d_conditional_certification_power_balanced_candidate_v2\n\npython scripts/run_rolling_temporal_certification.py \\\n  --config configs/philly_caiso_oasis_365d_conditional_rolling.yaml \\\n  --output-dir outputs/philly_caiso_oasis_365d_conditional_rolling_power_balanced_candidate\n\npython scripts/run_temporal_conditional_certification.py \\\n  --config configs/philly_caiso_oasis_30d_conditional_ablation.yaml \\\n  --output-dir outputs/philly_caiso_oasis_30d_conditional_ablation\n```\n\nThe archived output directories already contain the complete event-level and\nsummary results used by the paper. Controlled A100 measurements contain 280 run\nrecords, so a GPU is unnecessary for verifying the published analysis.\n\n## Evidence boundary\n\nObserved evidence consists of public workload/grid traces and controlled A100\ntelemetry. Demand-response products, contract terms, workload service tiers,\nPUE, fleet scaling, realization noise, and replay alignment are modeled\nexperimental components. The parameter and provenance ledgers preserve this\ndistinction.\n\n## Archive and licenses\n\nThe repository release is `https://github.com/ScottZXJ123/FlexSure-Cert/releases/tag/v2.0.0` and its immutable\nZenodo record is [10.5281/zenodo.22109753](https://doi.org/10.5281/zenodo.22109753). The concept DOI\n[10.5281/zenodo.21323803](https://doi.org/10.5281/zenodo.21323803) resolves to the latest archived\nversion. Code is MIT licensed; derived tables and original documentation are CC\nBY 4.0. Source datasets retain their original terms; see `LICENSES.md`.\n", "readme_present": true, "readme_scrub": {"leaked": false, "hits": {}}, "signals": {"dependency_manifest": ["requirements.txt"], "container": [], "build_script": [], "ci_config": [], "licence": ["LICENSE"], "tests": ["tests/test_azure_llm_mapping.py"]}, "readme_referenced_paths": ["LICENSES.md", "configs/philly_caiso_oasis_30d_conditional_ablation.yaml", "configs/philly_caiso_oasis_365d_conditional.yaml", "configs/philly_caiso_oasis_365d_conditional_rolling.yaml", "provenance/raw_input_manifest.csv", "requirements.txt", "run_analysis.sh", "scripts/run_rolling_temporal_certification.py", "scripts/run_temporal_conditional_certification.py"], "pushed_at": "2026-08-26T10:02:18Z", "created_at": "2026-07-12T14:17:24Z", "stars": 0, "archived": false}