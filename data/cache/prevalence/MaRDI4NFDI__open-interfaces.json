k.c", "lang_python/oif_impl/_serialization.py", "lang_python/oif_impl/bridge_python.c", "lang_python/oif_impl/openinterfaces/CMakeLists.txt", "lang_python/oif_impl/openinterfaces/_impl/CMakeLists.txt", "lang_python/oif_impl/openinterfaces/_impl/interfaces/ivp.py", "lang_python/oif_impl/openinterfaces/_impl/interfaces/linsolve.py", "lang_python/oif_impl/openinterfaces/_impl/interfaces/optim.py", "lang_python/oif_impl/openinterfaces/_impl/interfaces/qeq.py", "lang_python/oif_impl/openinterfaces/_impl/ivp/scipy_ode/scipy_ode.conf", "lang_python/oif_impl/openinterfaces/_impl/ivp/scipy_ode/scipy_ode.py", "lang_python/oif_impl/openinterfaces/_impl/linsolve/numpy/linsolve.py", "lang_python/oif_impl/openinterfaces/_impl/linsolve/numpy/numpy.conf", "lang_python/oif_impl/openinterfaces/_impl/optim/scipy_optimize/scipy_optimize.conf", "lang_python/oif_impl/openinterfaces/_impl/optim/scipy_optimize/scipy_optimize.py", "lang_python/oif_impl/openinterfaces/_impl/qeq/py_qeq_solver/py_qeq_solver.conf", "lang_python/oif_impl/openinterfaces/_impl/qeq/py_qeq_solver/qeq_solver.py", "lang_python/oif_impl/openinterfaces/callback.py", "lang_python/oif_interfaces/openinterfaces/interfaces/ivp.py", "lang_python/oif_interfaces/openinterfaces/interfaces/linsolve.py", "lang_python/oif_interfaces/openinterfaces/interfaces/optim.py", "lang_python/oif_interfaces/openinterfaces/interfaces/qeq.py", "pyproject.toml", "requirements-dev.txt", "requirements-macos.txt", "tests/CMakeLists.txt", "tests/lang_c/CMakeLists.txt", "tests/lang_c/run_aux_tests_config_dict.cpp", "tests/lang_c/test_config_dict.cpp", "tests/lang_c/test_examples.cpp", "tests/lang_c/test_ivp.cpp", "tests/lang_c/test_linsolve.cpp", "tests/lang_c/test_output.cpp", "tests/lang_c/test_qeq.cpp", "tests/lang_c/test_util.cpp", "tests/lang_c/testutils.hpp", "tests/lang_julia/CMakeLists.txt", "tests/lang_julia/aux_funcs.c", "tests/lang_julia/runtests.jl", "tests/lang_julia/test_callback.jl", "tests/lang_julia/test_examples.jl", "tests/lang_julia/test_ivp.jl", "tests/lang_julia/test_linsolve.jl", "tests/lang_julia/test_optim.jl", "tests/lang_julia/test_qeq.jl", "tests/lang_python/test_examples.py", "tests/lang_python/test_ivp.py", "tests/lang_python/test_linsolve.py", "tests/lang_python/test_optim.py", "tests/lang_python/test_qeq.py", "tests/lang_python/test_util.py", "tests/test_segfaults.sh", "vendor/CMakeLists.txt"], "readme": "<h1 align=\"center\">\n<img src=\"https://raw.githubusercontent.com/MaRDI4NFDI/open-interfaces/refs/heads/main/assets/mardi-oif-logo.svg\" width=\"40\" style=\"vertical-align: text-bottom;\" />\nMaRDI Open Interfaces\n</h1>\n\n[REDACTED]\n[REDACTED]\n\n**The project is not active currently (August 2026)**\n\n_MaRDI Open Interfaces_ is a project aiming to improve interoperability\nin scientific computing by removing two hurdles that computational scientists\nusually face in their daily work.\n\nThese hurdles are the following.\nFirst, numerical solvers are often implemented in different programming\nlanguages.\nSecond, these solvers have potentially significantly diverging interfaces\nin terms of function names, order of function arguments, and the invocation\norder.\nTherefore, when a computational scientist wants to switch from one solver\nto another, it could take non-negligible effort in code modification\nand testing for the correctness.\n\n_Open Interfaces_ aim to alleviate these problems by providing automatic data\nmarshalling between different languages and a set of interfaces for typical\nnumerical problems such as integration of differential equations and\noptimization.\n\n<p align=\"center\">\n    <img src=\"https://media.githubusercontent.com/media/MaRDI4NFDI/open-interfaces/refs/heads/main/assets/pairwise_bindings.png\" />\n    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n    <img src=\"https://media.githubusercontent.com/media/MaRDI4NFDI/open-interfaces/refs/heads/main/assets/oif_bindings.png\" />\n    <br />\n    <strong>A</strong>&nbsp;Traditional pairwise bindings\n    <br />\n    <strong>B</strong>&nbsp;Decoupled bindings via <em>Open Interfaces</em>\n</p>\n\nThis project is the part of the [_Mathematical Research Data Initiative\n(MaRDI)_](https://mardi4nfdi.de).\n\n## Installation and Documentation\n\nPlease refer to the documentation at\n<https://mardi4nfdi.github.io/open-interfaces/>\nfor deeper view on the goals and implementation details\nas well as installation instructions, tutorials, and API reference.\n\n## Support and Contact\n\n_MaRDI Open Interfaces_ is an open source academic project.\nPlease use the\n[issue tracker](https://github.com/MaRDI4NFDI/open-interfaces/issues)\nfor bug reports and feature requests and asking questions.\n\n\n## License\n\n[REDACTED]\n\n\n## Citing\n\nIf you _MaRDI Open Interfaces_, please consider citing\n[this paper](https://openresearchsoftware.metajnl.com/articles/10.5334/jors.569):\n```bibtex\n@Article{KabanovEtAl2025,\n  author    = {Kabanov, Dmitry I. and Rave, Stephan and Ohlberger, Mario},\n  journal   = {Journal of Open Research Software},\n  title     = {Improving Interoperability in Scientific Computing via {MaRDI Open Interfaces}},\n  year      = {2025},\n  issn      = {2049-9647},\n  volume    = {13},\n  doi       = {10.5334/jors.569},\n  publisher = {Ubiquity Press, Ltd.},\n}\n```\n\n\n## Funding\n\nThis work is funded by the _Deutsche Forschungsgemeinschaft_ (DFG, _German\nResearch Foundation_) under Germany's Excellence Strategy EXC 2044-390685587,\n\u201cMathematics M\u00fcnster: Dynamics\u2013Geometry\u2013Structure\u201d and the National Research\nData Infrastructure, project number&nbsp;460135501, NFDI&nbsp;29/1\n\u201cMaRDI \u2013 Mathematical Research Data Initiative\n[Mathematische Forschungsdateninitiative]\u201d.\n", "readme_present": true, "readme_scrub": {"leaked": true, "hits": {"badge_image": 3}}, "signals": {"dependency_manifest": ["pyproject.toml"], "container": [], "build_script": ["CMakeLists.txt", "Makefile"], "ci_config": [".github/workflows/docs.yaml"], "licence": ["LICENSE"], "tests": ["tests/CMakeLists.txt"]}, "readme_referenced_paths": [], "pushed_at": "2026-08-27T16:18:52Z", "created_at": "2022-07-12T11:16:26Z", "stars": 7, "archived": false}