goal_function.py", "baseline/llm/promptbench/prompt_attack/label_constraint.py", "baseline/llm/promptbench/prompt_attack/search.py", "baseline/llm/promptbench/prompt_attack/transformations.py", "baseline/llm/promptbench/prompts/semantic_atk_prompts.py", "baseline/llm/promptbench/prompts/three_shot/few_shot_examples.py", "baseline/llm/promptbench/prompts/three_shot/role_oriented.py", "baseline/llm/promptbench/prompts/three_shot/task_oriented.py", "baseline/llm/promptbench/prompts/zero_shot/role_oriented.py", "baseline/llm/promptbench/prompts/zero_shot/task_oriented.py", "baseline/llm/promptbench/visualize.py", "baseline/roben/LICENSE", "baseline/roben/README.md", "baseline/roben/agglom_clusters.py", "baseline/roben/attacks.py", "baseline/roben/augmentor.py", "baseline/roben/construct_clusters.py", "baseline/roben/create_clusters_agglomerative.sh", "baseline/roben/edit_dist_utils.py", "baseline/roben/environment.yml", "baseline/roben/preprocess_tc.py", "baseline/roben/preprocess_vocab.py", "baseline/roben/reconstruct_clusters.py", "baseline/roben/recoverer.py", "baseline/roben/run_glue.py", "baseline/roben/scRNN/README.md", "baseline/roben/scRNN/corrector.py", "baseline/roben/scRNN/model.py", "baseline/roben/scRNN/train.py", "baseline/roben/scRNN/train_ScRNN.sh", "baseline/roben/scRNN/train_ScRNN_MNLI.sh", "baseline/roben/scRNN/train_ScRNN_QNLI.sh", "baseline/roben/scRNN/utils.py", "baseline/roben/train_mnli_agglomerative.sh", "baseline/roben/train_qnli_agglomerative.sh", "baseline/roben/train_rte_agglomerative.sh", "baseline/roben/train_rte_cc.sh", "baseline/roben/train_sst2_agglomerative.sh", "baseline/roben/train_sst2_cc.sh", "baseline/roben/trans.py", "baseline/roben/utils_glue.py", "baseline/roben/utils_roben.py", "baseline/roben/word_embedding_model_runners.py", "charmer.py", "charmer_jailbreak.py", "context.py", "data/advbench/default_demo.csv", "data/advbench/harmful_behaviors.csv", "data/advbench/harmful_strings.csv", "data/autodan_initial_prompt.txt", "data/transfer_expriment_behaviors.csv", "dataloader.py", "requirements.txt", "schematic.png", "scripts/run_MNLI-m.sh", "scripts/run_agnews.sh", "scripts/run_qnli.sh", "scripts/run_rte.sh", "scripts/run_sst.sh", "utils.py", "utils_jailbreak.py", "utils_llm_inference.py"], "readme": "# Charmer: Revisiting Character-level Adversarial Attacks for Language Models\n\n[REDACTED][REDACTED][REDACTED]\n\n![](schematic.png)\n\nOfficial implementation in PyTorch of the **ICML'24 paper \"Revisiting Character-level Adversarial Attacks for Language Models\"**.\n\n## Requirements\n```\nconda create -n lmrobust python=3.8\nconda install pytorch==2.0.0 torchvision==0.15.0 torchaudio==2.0.0 pytorch-cuda=11.7 -c pytorch -c nvidia\nconda install -c anaconda jupyter\npip install -r requirements.txt\n```\n`baseline` includes auxiliary code not written by authors.\n\n## Sample scripts\n\nTo run Charmer in the TextAattack BERT, RoBERTa and ALBERT models, run the separate dataset scripts in `scripts`, e.g.:\n```\ncd scripts\nbash run_sst.sh\n```\nThis will produce a `.csv` file similar to:\n```\noriginal,perturbed,True,Pred_original,Pred_perturbed,success,Dist_char,Dist_token,similarity,time\nFears for T N pension after talks Unions representing workers at Turner   Newall say they are 'disappointed' after talks with stricken parent firm Federal Mogul.,Fears for T E pension :fter talks Unions representing workers at Turner   Newall say they are 'disappointed' after talks with stricken parent firm Federal Mogul.,2,2,3,True,2,4,0.9770777225494384,3.747948408126831\n```\n\nwhere each column is:\n- `original`: Original sentence.\n- `perturbed`: Sentence after the attack.\n- `True`: True label of the sentence.\n- `Pred_original`: Prediction of the model for the original sentence.\n- `Pred_perturbed`: Prediction of the model for the attacked sentence.\n- `success`: True if `Pred_original` != `Pred_perturbed`.\n- `Dist_char`: Levenshtein distance in the character-level between `original` and `perturbed`.\n- `Dist_token`: Levenshtein distance in the token-level between `original` and `perturbed`.\n- `similarity`: USE between `original` and `perturbed`.\n- `time`: Time needed to produce `perturbed`.\n\n## Jailbreaking\n\nTo run Charmer in the Jailbreaking setting, you can run `attack_jailbreak.py`\n\n## Cite as:\n\n```\n@inproceedings{Abad2024Charmer,\n  author = {Abad Rocamora, Elias and Wu, Yongtao and Liu, Fanghui and Chrysos, Grigorios G and Cevher, Volkan},\n\n  title = {Revisiting Character-level Adversarial Attacks for Language Models},\n\n  booktitle = {International Conference on Machine Learning (ICML)},\n\n  year = {2024}\n}\n```\n", "readme_present": true, "readme_scrub": {"leaked": true, "hits": {"badge_image": 3}}, "signals": {"dependency_manifest": ["baseline/TextAttack/docs/environment.yml", "baseline/TextAttack/docs/requirements.txt", "baseline/TextAttack/setup.py", "baseline/llm/promptbench/environment.yaml"], "container": [], "build_script": ["baseline/TextAttack/Makefile"], "ci_config": [], "licence": ["LICENSE"], "tests": []}, "readme_referenced_paths": ["attack_jailbreak.py", "requirements.txt", "run_sst.sh"], "pushed_at": "2026-08-28T13:57:11Z", "created_at": "2024-05-06T16:08:07Z", "stars": 20, "archived": false}