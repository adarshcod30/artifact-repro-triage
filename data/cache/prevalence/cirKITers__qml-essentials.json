g", "docs/figures/fourier_series_tf_dark.png", "docs/figures/fourier_series_tf_light.png", "docs/figures/gates_fidelities_dark.png", "docs/figures/gates_fidelities_light.png", "docs/figures/histogram.svg", "docs/figures/invert_images.sh", "docs/figures/jaqsi_overview_dark.png", "docs/figures/jaqsi_overview_light.png", "docs/figures/jaqsi_pulse_dark.png", "docs/figures/jaqsi_pulse_light.png", "docs/figures/model_2d_psd_dark.png", "docs/figures/model_2d_psd_light.png", "docs/figures/model_fct_dark.png", "docs/figures/model_fct_light.png", "docs/figures/model_fct_spectr_dark.png", "docs/figures/model_fct_spectr_light.png", "docs/figures/model_fct_spectr_os_dark.png", "docs/figures/model_fct_spectr_os_light.png", "docs/figures/model_fct_spectr_ours_dark.png", "docs/figures/model_fct_spectr_ours_light.png", "docs/figures/model_psd_an_dark.png", "docs/figures/model_psd_an_light.png", "docs/figures/model_psd_dark.png", "docs/figures/model_psd_light.png", "docs/figures/pulse_gates_dependencies_dark.png", "docs/figures/pulse_gates_dependencies_light.png", "docs/figures/pulse_schedule_dark.png", "docs/figures/pulse_schedule_light.png", "docs/figures/pulses_structure_dark.png", "docs/figures/pulses_structure_light.png", "docs/figures/rel-entropy.svg", "docs/figures/trained_series_dark.png", "docs/figures/trained_series_dataset_dark.png", "docs/figures/trained_series_dataset_light.png", "docs/figures/trained_series_light.png", "docs/figures/trained_series_tf_dark.png", "docs/figures/trained_series_tf_light.png", "docs/generate_circuits.py", "docs/index.md", "docs/jaqsi.ipynb", "docs/jaqsi.md", "docs/javascripts/mathjax.js", "docs/logo.svg", "docs/math_utils.md", "docs/metrics.ipynb", "docs/noise.md", "docs/pulses.ipynb", "docs/pulses.md", "docs/random_sampling.md", "docs/references.md", "docs/slurm_benchmark.sh", "docs/style.css", "docs/training.ipynb", "docs/training.md", "docs/usage.ipynb", "docs/usage.md", "mkdocs.yml", "pyproject.toml", "qml_essentials/__init__.py", "qml_essentials/algebra.py", "qml_essentials/ansaetze.py", "qml_essentials/coefficients.py", "qml_essentials/drawing.py", "qml_essentials/entanglement.py", "qml_essentials/evolution.py", "qml_essentials/expressibility.py", "qml_essentials/gates.py", "qml_essentials/jaqsi.py", "qml_essentials/math.py", "qml_essentials/memory.py", "qml_essentials/model.py", "qml_essentials/operations.py", "qml_essentials/pauli.py", "qml_essentials/pulses.py", "qml_essentials/qoc.py", "qml_essentials/qoc_results_drag.csv", "qml_essentials/qoc_results_gaussian.csv", "qml_essentials/qoc_results_square.csv", "qml_essentials/random_sampling.py", "qml_essentials/script.py", "qml_essentials/simulation.py", "qml_essentials/states.py", "qml_essentials/tape.py", "qml_essentials/topologies.py", "qml_essentials/trainability.py", "qml_essentials/unitary.py", "qml_essentials/utils.py", "tests/__init__.py", "tests/conftest.py", "tests/test_algebra.py", "tests/test_ansaetze.py", "tests/test_coefficients.py", "tests/test_entanglement.py", "tests/test_expressiblity.py", "tests/test_jaqsi.py", "tests/test_matchgate_migration.py", "tests/test_math.py", "tests/test_model.py", "tests/test_pauli.py", "tests/test_pulse_state.py", "tests/test_qoc.py", "tests/test_random_sampling.py", "tests/test_states.py", "uv.lock"], "readme": "# QML Essentials\n\n<p align=\"center\">\n<img src=\"https://raw.githubusercontent.com/cirKITers/qml-essentials/refs/heads/main/docs/logo.svg\" width=\"200\" title=\"Logo\">\n</p>\n<h3 align=\"center\">A toolbox to make working with QML models easier.</h3>\n<br/>\n\n## \ud83d\udcdc About\n\nThis repo contains some of the commonly used Ansaetze and coding stuff required for working with QML and Data-Reuploading models.\\\nThere are also dedicated classes to calculate entanglement and expressiblity of a provided model as well as its Fourier coefficients.\nCheckout our [Arxiv Paper](https://arxiv.org/abs/2506.06695) to learn more.\n\n## \ud83d\ude80 Getting Started\n\n```\npip install qml-essentials\n```\nor with the [uv package manager](https://github.com/astral-sh/uv):\n```\nuv add qml-essentials\n```\n\nto install our package from [PyPI](https://pypi.org/project/qml-essentials/).\n\n<p align=\"center\">\n<img src=\"docs/figures/code.svg\" width=\"640\" title=\"Code Example\">\n</p>\n<p align=\"center\">\n<img src=\"docs/figures/histogram.svg\" width=\"640\" title=\"Histogram Figure\">\n</p>\n\nYou can find details on how to use it and further documentation on the corresponding [Github Page](https://cirkiters.github.io/qml-essentials/).\n\n## \ud83d\udce6 Package Structure\n\nThe following diagram provides an overview on how the different components within this package depend on each other.\n\n```mermaid\nflowchart LR\n    qmless([QML Essentials])\n    qmless --> qmless.ansaetze([Ansaetze])\n    qmless.ansaetze --> qmless.blocks([Blocks])\n    qmless.blocks --> qmless.gates([Gates])\n    qmless.blocks --> qmless.topo([Topologies])\n    qmless.gates --> qmless.unitary([UnitaryGates])\n    qmless.gates --> qmless.pulse([PulseGates])\n    qmless --> qmless.coefficients([Coefficients])\n    qmless.coefficients --> qmless.analytical([Analytical])\n    qmless.coefficients --> qmless.numerical([Numerical])\n    qmless.numerical --> qmless.fcc([Fourier Coefficient Correlation])\n    qmless.numerical --> qmless.fingerprint([Fourier Fingerprints])\n    qmless --> qmless.models([Models])\n    qmless --> qmless.expr([Expressibility])\n    qmless --> qmless.ent([Entanglement])\n    qmless.ent --> qmless.mw([Meyer Wallach])\n    qmless.ent --> qmless.re([Relative Entropy])\n    qmless.ent --> qmless.bell([Bell Measurement])\n    qmless.ent --> qmless.ef([Entanglement of Formation])\n    qmless.ent --> qmless.ce([Concentratable Entanglement])\n\n    classDef l1 fill:#1f8f5a,stroke:#1f8f5a,color:#d4f7e8\n    classDef l2 fill:#2fb170,stroke:#2fb170,color:#d4f7e8\n    classDef l3 fill:#58e3a6,stroke:#58e3a6,color:#272a35\n    classDef l4 fill:#a8f0d1,stroke:#a8f0d1,color:#272a35\n\n    linkStyle default stroke-width:2px\n\n    class qmless l1\n    class qmless.ansaetze,qmless.coefficients,qmless.models,qmless.expr,qmless.ent l2\n    class qmless.blocks,qmless.gates,qmless.numerical,qmless.analytical,qmless.mw,qmless.bell,qmless.ef,qmless.re,qmless.ce l3\n    class qmless.unitary,qmless.pulse,qmless.topo,qmless.fcc,qmless.fingerprint l4\n```\n\n## \ud83d\udea7 Contributing\n\nContributions are highly welcome! \ud83e\udd17 Take a look at our [Contribution Guidelines](https://github.com/cirKITers/qml-essentials/blob/main/CONTRIBUTING.md).\n\nSee our [coverage report](coverage/index.html) if you would like to contribute with further tests.\n", "readme_present": true, "readme_scrub": {"leaked": false, "hits": {}}, "signals": {"dependency_manifest": ["pyproject.toml"], "container": [], "build_script": [], "ci_config": [".github/workflows/dependabot-approve.yml"], "licence": ["LICENSE"], "tests": ["tests/__init__.py"]}, "readme_referenced_paths": ["coverage/index.html", "github.com/cirKITers/qml-essentials/blob/main/CONTRIBUTING.md"], "pushed_at": "2026-08-28T13:09:59Z", "created_at": "2024-07-01T08:00:06Z", "stars": 7, "archived": false}