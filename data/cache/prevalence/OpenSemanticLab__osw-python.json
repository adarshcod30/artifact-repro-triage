sts/integration/test_page_package.py", "tests/integration/test_rdf_generation.py", "tests/integration/test_wtsite.py", "tests/sparql_client_test.py", "tests/test_credential_manager.py", "tests/test_osl.py", "tests/test_store_entity_failure.py", "tests/test_wiki_tools.py", "tests/test_wtsite_edit.py", "tests/test_wtsite_session_lock.py", "tests/utils/code_postprocessing_test.py", "tests/utils/oold_test.py", "tests/utils/templates_test.py", "tests/utils/utils_test.py", "tests/utils/workflow_test.py", "uv.lock", "zensical.toml"], "readme": "[![PyPI-Server]([REDACTED]\n[REDACTED]\n[REDACTED]\n[REDACTED]\n![license]([REDACTED]\n\n# osw\n\nPython toolset for data processing, queries, wikicode generation and page\nmanipulation within [OpenSemanticLab](https://github.com/OpenSemanticLab).\n\nWork with OpenSemanticLab instances the way you work with Python objects:\nload pages as typed pydantic entities, query with semantic search, generate\nmodels from the schemas stored in the wiki, and write changes back.\n\n**Documentation: <https://opensemanticlab.github.io/osw-python/>**\n\n## Installation\n\n```bash\npip install osw\n```\n\nOptional extras (`osw[wikitext]`, `osw[DB]`, `osw[S3]`, `osw[dataimport]`,\n`osw[UI]`, `osw[all]`) are described in the\n[Get Started guide](https://opensemanticlab.github.io/osw-python/get-started/).\n\n## Quickstart\n\n```python\nfrom osw.express import OswExpress\n\nosw = OswExpress(domain=\"wiki-dev.open-semantic-lab.org\")\ninstances = osw.site.semantic_search(\"[[Category:Item]]\")\nprint(instances)\n```\n\nMore runnable scripts live in [examples/](examples/), and the\n[Basics tutorial](docs/tutorials/basics.ipynb) walks through the\nOpenSemanticLab data model.\n\n## Contributing\n\nContributions are welcome, see [CONTRIBUTING.md](CONTRIBUTING.md).\nDevelopment setup, checks and tests are one command each: `make install`,\n`make check`, `make test`.\n\n## Related projects\n\nGeneral features for object-oriented interaction with knowledge graphs live\nin the standalone package [oold-python](https://github.com/OO-LD/oold-python).\n\n## License\n\nAGPL-3.0-or-later, see [LICENSE.txt](LICENSE.txt).\n", "readme_present": true, "readme_scrub": {"leaked": true, "hits": {"badge_image": 3, "badge_url": 2}}, "signals": {"dependency_manifest": ["pyproject.toml"], "container": [], "build_script": ["Makefile"], "ci_config": [".github/workflows/docs.yml"], "licence": ["LICENSE.txt"], "tests": ["tests/conftest.py"]}, "readme_referenced_paths": ["CONTRIBUTING.md", "LICENSE.txt", "docs/tutorials/basics.ipynb"], "pushed_at": "2026-08-28T15:30:36Z", "created_at": "2022-02-11T09:56:53Z", "stars": 11, "archived": false}