bato/recipes/etopo_standard.yaml", "src/globato/recipes/modifiers/__init__.py", "src/globato/recipes/modifiers/buffer_and_cut.py", "src/globato/recipes/modifiers/crm.py", "src/globato/recipes/modifiers/cudem.py", "src/globato/recipes/newport_coastal_coupling.yaml", "src/globato/recipes/quick_coastal.yaml", "src/globato/recipes/schemas/__init__.py", "src/globato/recipes/western_ak.yaml", "src/globato/streams/__init__.py", "src/globato/streams/base.py", "src/globato/streams/profiles/__init__.py", "src/globato/streams/profiles/atl03_xyz.yaml", "src/globato/streams/profiles/charts_xyz.yaml", "src/globato/streams/profiles/copernicus_sdb.yaml", "src/globato/streams/profiles/csb_xyz.yaml", "src/globato/streams/profiles/dnc_xyz.yaml", "src/globato/streams/profiles/ehydro_xyz.yaml", "src/globato/streams/profiles/gdb_xyz.yaml", "src/globato/streams/profiles/margrav_xyz.yaml", "src/globato/streams/profiles/nos_fathoms_xyz.yaml", "src/globato/streams/profiles/nos_feet_xyz.yaml", "src/globato/streams/profiles/nos_xyz.yaml", "src/globato/streams/profiles/rio-xyz.yaml", "src/globato/streams/profiles/sysu_nc.yaml", "src/globato/streams/readers/__init__.py", "src/globato/streams/readers/bag.py", "src/globato/streams/readers/base.py", "src/globato/streams/readers/datalist.py", "src/globato/streams/readers/fio.py", "src/globato/streams/readers/gdal_proc.py", "src/globato/streams/readers/gtpc.py", "src/globato/streams/readers/icesat2.py", "src/globato/streams/readers/lidar.py", "src/globato/streams/readers/multibeam.py", "src/globato/streams/readers/netcdf_reader.py", "src/globato/streams/readers/ogr_proc.py", "src/globato/streams/readers/pyogrio.py", "src/globato/streams/readers/rio.py", "src/globato/streams/readers/xyz.py", "src/globato/streams/schema.py", "src/globato/utils.py", "tests/test_cli.py", "tests/test_cli_parsing.py", "tests/test_imports.py", "tests/test_streams.py"], "readme": "<p align=\"center\">\n\t<a href=\"https://github.com/continuous-dems\">\n\t\t<img src=\"https://raw.githubusercontent.com/continuous-dems/globato/refs/heads/main/docs/source/_static/globato-logo.svg\" height=\"80\" alt=\"Continuous DEMs Logo\">\n\t</a>\n</p>\n<h1 align=\"center\">GloBaTo</h1>\n<p align=\"center\"><em>Domo Arigato, Multi-Resolution Globato.</em></p>\n\n<p align=\"center\">\n  <a href=\"https://github.com/continuous-dems/globato\">[REDACTED]</a>\n  <a href=\"LICENSE\">[REDACTED]</a>\n  <a href=\"https://www.python.org/\">[REDACTED]</a>\n  <a href=\"[REDACTED]\n  <a href=\"https://anaconda.org/conda-forge/globato\"><img src=\"[REDACTED] alt=\"Conda Version\"></a>\n  <a href=\"https://cudem.zulip.org\">[REDACTED]</a>\n</p>\n\n**Globato** is the user-facing geospatial engine of the Continuous-DEMs ecosystem. It is designed for the rapid development, blending, and processing of high-accuracy Topo-Bathy Digital Elevation Models (DEMs).\n\nGlobato is part of the [Continuous DEMs Project](https://continuous-dems.readthedocs.io/), an ecosystem of tools for modern, continuous digital elevation model generation.\n\n---\n\n## \ud83d\udce6 Installation\nInstall via pip (this will automatically pull in the `fetchez` and `transformez` dependencies):\n\n```bash\npip install globato\n```\n\n## \ud83d\udc04 Quickstart\n\nIf you are new to Globato, the best place to start is the Quickstart guide, which will take you from installation to generating your first DEM in under 5 minutes.\n\n* **[Quickstart: From Zero to DEM in 1 arc-second](https://globato.readthedocs.io/en/latest/user_guide/quickstart.html)**\n\n---\n\n## \ud83d\udcda Documentation\nWould you like to know more? Check out our [Official Documentation](https://globato.readthedocs.io) to learn about:\n\n* **The Python API:** Build custom Digital Elevation Models and process elevation data in your apps.\n\n* **The Globato CLI:** Generate and run globato recipes, fetch elevation data sources, visualize your data all in the command line.\n\n* **DEM Recipes:** Build reproducable DEMs using simple YAML recipes.\n\n* **Module Bundles:** Use pre-configured module bundles for quick DEM generation in your region.\n\n---\n\n## \u2696 License\n\nThis project is licensed under the MIT License - see the [LICENSE](https://github.com/continuous-dems/fetchez/blob/main/LICENSE) file for details.\n\nCopyright (c) 2010-2026 Regents of the University of Colorado\n", "readme_present": true, "readme_scrub": {"leaked": true, "hits": {"badge_image": 5, "badge_url": 2}}, "signals": {"dependency_manifest": ["pyproject.toml"], "container": [], "build_script": [], "ci_config": [".github/workflows/publish.yaml"], "licence": ["LICENSE"], "tests": ["tests/test_cli.py"]}, "readme_referenced_paths": ["globato.readthedocs.io/en/latest/user_guide/quickstart.html"], "pushed_at": "2026-08-27T16:14:37Z", "created_at": "2026-02-12T00:53:41Z", "stars": 3, "archived": false}