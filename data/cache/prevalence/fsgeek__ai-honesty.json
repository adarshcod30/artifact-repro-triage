 "reviews/review_20260305_140006.jsonl", "reviews/review_20260306_140008.jsonl", "reviews/review_20260307_140004.jsonl", "reviews/review_20260308_130005.jsonl", "reviews/review_20260309_130007.jsonl", "reviews/review_20260310_130008.jsonl", "reviews/review_20260311_130008.jsonl", "reviews/review_20260312_130004.jsonl", "reviews/review_20260313_130007.jsonl", "reviews/review_20260314_130008.jsonl", "reviews/state.json", "reviews/triage/triage_20260212_184021.json", "reviews/triage/triage_20260212_185518.json", "reviews/triage/triage_20260213_040142.json", "reviews/vastaav_comparison_analysis.md", "role_epistemic_phase_space.png", "role_epistemic_results.csv", "scripts/ab_comparison.py", "scripts/adversarial_judge.py", "scripts/analysis_per_category_failure.py", "scripts/analyze_cross_domain_manifold.py", "scripts/analyze_experiment_H.py", "scripts/analyze_scaffolding_coupling.py", "scripts/analyze_token_classification.py", "scripts/benchmark_tensor_overhead.py", "scripts/calibration_ece_analysis.py", "scripts/citation_bounded_judge.py", "scripts/conciseness_judge.py", "scripts/cron_review.sh", "scripts/daily_review_pipeline.py", "scripts/epistemic_trace_demo.py", "scripts/exp34_gap_auc.py", "scripts/exp34_posthoc.py", "scripts/experiment1.py", "scripts/experiment10_truthfulqa.py", "scripts/experiment12_alignment_tax.py", "scripts/experiment13_heatmap_comparison.py", "scripts/experiment14_role_epistemic.py", "scripts/experiment15_cross_model.py", "scripts/experiment15b_remaining_models.py", "scripts/experiment16_base_vs_instruct.py", "scripts/experiment17_multi_metric.py", "scripts/experiment18_logits_probe.py", "scripts/experiment19_query_types.py", "scripts/experiment2.py", "scripts/experiment20_calibration.py", "scripts/experiment21_baselines.py", "scripts/experiment22_composition.py", "scripts/experiment23_alignment_tax_breadth.py", "scripts/experiment24_self_report_inversion.py", "scripts/experiment25_adversarial_tensor_phase1.py", "scripts/experiment26_tensor_gating.py", "scripts/experiment27_bounded_verification.py", "scripts/experiment27_realistic_verification.py", "scripts/experiment27_reeval_no_selfreport.py", "scripts/experiment27b_stratified_evaluator.py", "scripts/experiment27c_full_traces.py", "scripts/experiment28_assistant_axis.py", "scripts/experiment29_base_self_report.py", "scripts/experiment3.py", "scripts/experiment30_truthfulqa_entropy.py", "scripts/experiment31_aggregation_analysis.py", "scripts/experiment31_frontier_api.py", "scripts/experiment31_smoke_test.py", "scripts/experiment32_length_controlled.py", "scripts/experiment33_semantic_entropy.py", "scripts/experiment34_pipeline_conviction.py", "scripts/experiment34_pipeline_entropy.py", "scripts/experiment4.py", "scripts/experiment5.py", "scripts/experiment6.py", "scripts/experiment7.py", "scripts/experiment8_cartography.py", "scripts/experiment9_heatmap.py", "scripts/experiment_H_coding_styles.py", "scripts/generate_table3_decomposition.py", "scripts/math_proof_traces.py", "scripts/math_proof_traces_batch2.py", "scripts/narrative_coherence_judge.py", "scripts/probe_citations.py", "scripts/provenance_judge.py", "scripts/quick_provenance_check.sh", "scripts/recollect_self_report.py", "scripts/redundancy_judge.py", "scripts/regenerate_budget_curve.py", "scripts/regenerate_confidence_distributions.py", "scripts/regenerate_entropy_distributions.py", "scripts/review_analytics.py", "scripts/review_triage.py", "scripts/run_review_pipeline.sh", "scripts/signal_ablation_analysis.py", "scripts/tensor_interface.py", "signal_ablation_results.csv", "spoiled_200tok_runs/exp34_traces_20260825_104152.jsonl", "spoiled_200tok_runs/exp34_traces_20260825_104331_v6_runaway_stall.jsonl", "src/.gitignore", "talks/systopia/.gitignore", "talks/systopia/Makefile", "talks/systopia/claude-disclaimer.png", "talks/systopia/claude-marketing.png", "talks/systopia/epistemic_honesty_talk.pdf", "talks/systopia/epistemic_honesty_talk.tex", "talks/systopia/epistemic_honesty_talk_tight.md", "talks/systopia/grok-screenshot.png", "talks/systopia/mallku_heatmap.png", "talks/systopia/mallku_phase_space.png", "talks/systopia/mallku_tax_heatmap.png", "tla/EpistemicImpossibility.cfg", "tla/EpistemicImpossibility.tla", "tla/epistemic_tensor.cfg", "tla/epistemic_tensor.tla", "tla/run_tlc.sh", "tla/states/26-08-28-11-01-19/epistemic_tensor-0.st", "tla/states/26-08-28-11-01-19/epistemic_tensor.st", "tla/states/26-08-28-11-01-19/epistemic_tensor_0.fp", "tla/states/26-08-28-11-01-19/epistemic_tensor_1.fp"], "readme": "# Epistemic Observability in Language Models\n\nResearch code, experiments, and papers investigating whether language models\ncan reliably distinguish what they know from what they fabricate \u2014 and what\nsystems can do about it when they cannot.\n\n**Papers:**\n\n- *Epistemic Observability in Language Models* \u2014 technical report,\n  [arXiv:2603.20531](https://arxiv.org/abs/2603.20531)\n- *Using Epistemic Observability in Agentic Systems for Combating\n  Hallucinations* \u2014 position paper, PACMI '26 (`papers/pacmi26/`)\n\n**Core finding:** self-reported confidence is close to useless as a\nverification signal, because it is compressed at the top of its scale. Across\nfour model families (OLMo-3, Llama 3.1, Qwen3, Mistral) models report a mean\nof 0.98 on knowable queries and 0.73 on unknowable ones, and 43% of\nunknowable queries \u2014 questions with no correct answer \u2014 receive a literal\n\"100\". Internal telemetry (per-token entropy, attention summaries)\ndiscriminates reliably (AUC 0.87\u20130.92 pooled and per family) and cannot be\nseparately controlled by the model under current training objectives. The\nsystems consequence: expose that telemetry through the generation interface\nand spend verification budgets where they buy the most reliability.\n\n> **Correction (2026-08-28).** Earlier versions of this README, and\n> [arXiv:2603.20531](https://arxiv.org/abs/2603.20531) v2, reported that\n> self-report was *inverted* (AUC 0.28\u20130.36, below random). That was an\n> artifact of a confidence-parse bug: the extractor decoded the prompt along\n> with the generation and took the first integer, which was usually the `0`\n> in the prompt's own \"scale of 0-100\" text. Reported by Chris Brew in\n> [issue #1](https://github.com/fsgeek/ai-honesty/issues/1) and fixed at the\n> source in 3488f83. Corrected, every family scores *above* chance (AUC\n> 0.66\u20130.92). The impossibility argument does not depend on the inversion \u2014\n> it needs only that self-report be uninformative to a bounded supervisor \u2014\n> and the entropy, budget-curve, and post-training results are unaffected. An\n> arXiv v3 carrying the correction is in preparation.\n\n## Reference implementation\n\nThe tensor interface described in the papers lives in\n[`scripts/tensor_interface.py`](scripts/tensor_interface.py):\n\n```python\nfrom tensor_interface import TensorInterface\n\ninterface = TensorInterface(\"allenai/olmo-3-7b-instruct\")\nresult = interface.generate_with_tensor(\"What is the capital of France?\")\n\nresult.text              # the generated response (testimony)\nresult.entropy_trace     # per-token entropy (telemetry)\nresult.attention_summary # attention concentration statistics\n```\n\n- [`scripts/epistemic_trace_demo.py`](scripts/epistemic_trace_demo.py) \u2014 demo of the entropy trace\n- [`scripts/benchmark_tensor_overhead.py`](scripts/benchmark_tensor_overhead.py) \u2014 overhead measurements (~2\u20137% latency, signal-set dependent)\n- [`scripts/experiment27_realistic_verification.py`](scripts/experiment27_realistic_verification.py) \u2014 the budgeted-verification evaluation behind the PACMI paper's Figure 3\n\n## Setup\n\nRequires Python 3.11+ and CUDA for the transformer experiments.\n\n```bash\nuv sync\nsource .venv/bin/activate\npython scripts/epistemic_trace_demo.py\n```\n\nLlama models require Meta license approval on Hugging Face; Mistral models\nneed `fix_mistral_regex=True` when loading the tokenizer.\n\n## Repository layout\n\n| Path | Contents |\n|------|----------|\n| `scripts/` | Standalone experiment scripts (numbered) and the tensor interface |\n| `papers/` | LaTeX sources for the papers |\n| `tla/` | TLA+ specifications of the text-only impossibility and the tensor escape |\n| `docs/` | Research summaries and narrative drafts |\n| `notes/`, `reviews/` | Working notes and automated review-pipeline output |\n\nThis repository is published as-is, working history included \u2014 drafts,\nnotes, and review logs and all. For a project arguing that systems should\nexpose their internal state rather than curate their testimony, publishing\nonly a polished fa\u00e7ade seemed like the wrong kind of joke.\n\n## Citing\n\nSee [`CITATION.cff`](CITATION.cff); the preferred citation for the ideas is\nthe [arXiv report](https://arxiv.org/abs/2603.20531).\n\n## License\n\n[MIT](LICENSE).\n", "readme_present": true, "readme_scrub": {"leaked": false, "hits": {}}, "signals": {"dependency_manifest": ["pyproject.toml"], "container": [], "build_script": ["acmart-primary/Makefile"], "ci_config": [".github/workflows/create-release.yml"], "licence": ["LICENSE"], "tests": []}, "readme_referenced_paths": ["scripts/benchmark_tensor_overhead.py", "scripts/epistemic_trace_demo.py", "scripts/experiment27_realistic_verification.py", "scripts/tensor_interface.py"], "pushed_at": "2026-08-28T19:34:29Z", "created_at": "2026-01-01T19:49:59Z", "stars": 0, "archived": false}