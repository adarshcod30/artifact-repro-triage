7df09cd3f5b64c/LLM4Predict%2Fscripts%2F06_summarize.py", "contents_url": "https://api.github.com/repos/YiqinDai/LLM4JM-SC26/contents/LLM4Predict%2Fscripts%2F06_summarize.py?ref=367df59797ec4dac7cc3bda7c57df09cd3f5b64c", "patch": "@@ -6,6 +6,7 @@\n import argparse\n import json\n import math\n+import re\n import sys\n from pathlib import Path\n \n@@ -71,27 +72,35 @@ def load_prediction_file(path: Path) -> tuple[np.ndarray, np.ndarray]:\n \n def parse_resource_value(text: str, target_name: str) -> float:\n     fields = {}\n-    for item in text.strip().split(\"|\"):\n+    # Some generations use ';' instead of '|'. Accept both so a few\n+    # format drifts do not block post-processing of an otherwise complete run.\n+    for item in re.split(r\"[|;]\", text.strip()):\n         if \"#\" in item:\n             key, value = item.split(\"#\", 1)\n             fields[key.strip()] = value.strip()\n     raw = fields.get(\"Elapsed\" if target_name == \"runtime\" else \"MaxRSS\")\n     if raw is None or raw == \"\" or raw.lower() == \"null\":\n         return -1.0\n     if target_name == \"memory\":\n-        if raw.endswith(\"K\"):\n-            raw = raw[:-1]\n+        raw = raw.strip()\n+        match = re.search(r\"(-?\\d+(?:\\.\\d+)?)([KMG]?)\", raw, flags=re.IGNORECASE)\n+        if not match:\n+            raise ValueError(f\"\u65e0\u6cd5\u89e3\u6790 MaxRSS \u5b57\u6bb5: {raw!r}\")\n+        raw = match.group(1)\n+        unit = match.group(2).upper()\n+        if unit == \"K\":\n             mult = 1.0\n-        elif raw.endswith(\"M\"):\n-            raw = raw[:-1]\n+        elif unit == \"M\":\n             mult = 1024.0\n-        elif raw.endswith(\"G\"):\n-            raw = raw[:-1]\n+        elif unit == \"G\":\n             mult = 1024.0 * 1024.0\n         else:\n             mult = 1.0\n         return float(raw) * mult\n-    return float(raw)\n+    match = re.search(r\"(-?\\d+(?:\\.\\d+)?)\", raw.strip())\n+    if not match:\n+        raise ValueError(f\"\u65e0\u6cd5\u89e3\u6790 Elapsed \u5b57\u6bb5: {raw!r}\")\n+    return float(match.group(1))\n \n \n def load_llm_prediction_file(path: Path, target_name: str) -> tuple[np.ndarray, np.ndarray]:"}]}