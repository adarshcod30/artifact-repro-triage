[{"url": "https://api.github.com/repos/libLISA/liblisa/issues/4", "repository_url": "https://api.github.com/repos/libLISA/liblisa", "labels_url": "https://api.github.com/repos/libLISA/liblisa/issues/4/labels{/name}", "comments_url": "https://api.github.com/repos/libLISA/liblisa/issues/4/comments", "events_url": "https://api.github.com/repos/libLISA/liblisa/issues/4/events", "html_url": "https://github.com/libLISA/liblisa/pull/4", "id": 2864174701, "node_id": "PR_kwDOFntgYs6Ly0Nb", "number": 4, "title": "Clarify liblisa-semantic-tool server's cache-not-found message.", "user": {"login": "ErrWare", "id": 32579486, "node_id": "MDQ6VXNlcjMyNTc5NDg2", "avatar_url": "https://avatars.githubusercontent.com/u/32579486?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ErrWare", "html_url": "https://github.com/ErrWare", "followers_url": "https://api.github.com/users/ErrWare/followers", "following_url": "https://api.github.com/users/ErrWare/following{/other_user}", "gists_url": "https://api.github.com/users/ErrWare/gists{/gist_id}", "starred_url": "https://api.github.com/users/ErrWare/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ErrWare/subscriptions", "organizations_url": "https://api.github.com/users/ErrWare/orgs", "repos_url": "https://api.github.com/users/ErrWare/repos", "events_url": "https://api.github.com/users/ErrWare/events{/privacy}", "received_events_url": "https://api.github.com/users/ErrWare/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "labels": [], "state": "closed", "locked": false, "assignees": [], "milestone": null, "comments": 0, "created_at": "2025-02-19T19:03:53Z", "updated_at": "2025-02-21T13:30:58Z", "closed_at": "2025-02-21T13:25:06Z", "assignee": null, "author_association": "CONTRIBUTOR", "issue_field_values": [], "type": null, "active_lock_reason": null, "draft": false, "pull_request": {"url": "https://api.github.com/repos/libLISA/liblisa/pulls/4", "html_url": "https://github.com/libLISA/liblisa/pull/4", "diff_url": "https://github.com/libLISA/liblisa/pull/4.diff", "patch_url": "https://github.com/libLISA/liblisa/pull/4.patch", "merged_at": "2025-02-21T13:25:06Z"}, "body": "The new typical use case looks like this:\r\n\r\n```\r\n./liblisa-semantics-tool server --cache mycache.cache semantics/amd-7700x.json\r\nCreating cache \"mycache.cache\"\r\nReading...\r\nBuilding lookup table...\r\nThat took 112565ms\r\nReady!\r\n```", "closed_by": {"login": "jxors", "id": 9155798, "node_id": "MDQ6VXNlcjkxNTU3OTg=", "avatar_url": "https://avatars.githubusercontent.com/u/9155798?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jxors", "html_url": "https://github.com/jxors", "followers_url": "https://api.github.com/users/jxors/followers", "following_url": "https://api.github.com/users/jxors/following{/other_user}", "gists_url": "https://api.github.com/users/jxors/gists{/gist_id}", "starred_url": "https://api.github.com/users/jxors/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jxors/subscriptions", "organizations_url": "https://api.github.com/users/jxors/orgs", "repos_url": "https://api.github.com/users/jxors/repos", "events_url": "https://api.github.com/users/jxors/events{/privacy}", "received_events_url": "https://api.github.com/users/jxors/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"url": "https://api.github.com/repos/libLISA/liblisa/issues/4/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/libLISA/liblisa/issues/4/timeline", "performed_via_github_app": null, "state_reason": null}, {"url": "https://api.github.com/repos/libLISA/liblisa/issues/3", "repository_url": "https://api.github.com/repos/libLISA/liblisa", "labels_url": "https://api.github.com/repos/libLISA/liblisa/issues/3/labels{/name}", "comments_url": "https://api.github.com/repos/libLISA/liblisa/issues/3/comments", "events_url": "https://api.github.com/repos/libLISA/liblisa/issues/3/events", "html_url": "https://github.com/libLISA/liblisa/issues/3", "id": 2854609637, "node_id": "I_kwDOFntgYs6qJeLl", "number": 3, "title": "Misleading Message When Creating A New Lookup Table Cache", "user": {"login": "ErrWare", "id": 32579486, "node_id": "MDQ6VXNlcjMyNTc5NDg2", "avatar_url": "https://avatars.githubusercontent.com/u/32579486?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ErrWare", "html_url": "https://github.com/ErrWare", "followers_url": "https://api.github.com/users/ErrWare/followers", "following_url": "https://api.github.com/users/ErrWare/following{/other_user}", "gists_url": "https://api.github.com/users/ErrWare/gists{/gist_id}", "starred_url": "https://api.github.com/users/ErrWare/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ErrWare/subscriptions", "organizations_url": "https://api.github.com/users/ErrWare/orgs", "repos_url": "https://api.github.com/users/ErrWare/repos", "events_url": "https://api.github.com/users/ErrWare/events{/privacy}", "received_events_url": "https://api.github.com/users/ErrWare/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "labels": [{"id": 3088771812, "node_id": "MDU6TGFiZWwzMDg4NzcxODEy", "url": "https://api.github.com/repos/libLISA/liblisa/labels/enhancement", "name": "enhancement", "color": "a2eeef", "default": true, "description": "New feature or request"}, {"id": 3088771821, "node_id": "MDU6TGFiZWwzMDg4NzcxODIx", "url": "https://api.github.com/repos/libLISA/liblisa/labels/good%20first%20issue", "name": "good first issue", "color": "7057ff", "default": true, "description": "Good for newcomers"}], "state": "closed", "locked": false, "assignees": [], "milestone": null, "comments": 2, "created_at": "2025-02-14T20:05:07Z", "updated_at": "2025-02-21T13:32:14Z", "closed_at": "2025-02-21T13:31:50Z", "assignee": null, "author_association": "CONTRIBUTOR", "issue_field_values": [], "type": null, "active_lock_reason": null, "sub_issues_summary": {"total": 0, "completed": 0, "percent_completed": 0}, "issue_dependencies_summary": {"blocked_by": 0, "total_blocked_by": 0, "blocking": 0, "total_blocking": 0}, "body": "When I start a server with a new lookup table cache (e.q. `liblisa-semantics-tool server --cache amd-7700x.cache semantics/amd-7700x.json`) I get the following message:\n\n`Error reading \"amd-7700x.cache\": No such file or directory (os error 2)`\n\nAs a user this makes me think:\n\n1. Error? That's fatal, why is the process continuing?\n2. The caching mechanism is broken.\n\nContrary to expectation, it's actually fine and the program will create the cache as it should. The message should either be skipped in the event of error number 2 (no such file) or replaced with something more representative like \"Cache `name` not found, creating new cache...\"\n\nI think this is an easy fix to anyone familiar with rust. Just change the error message line in [server.rs:250](https://github.com/libLISA/liblisa/blob/946ed52a22801ed438944bb0df850f464d90aecc/cli/liblisa-semantics-tool/src/server.rs#L250) to skip its output if the error message number is 2.", "closed_by": {"login": "jxors", "id": 9155798, "node_id": "MDQ6VXNlcjkxNTU3OTg=", "avatar_url": "https://avatars.githubusercontent.com/u/9155798?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jxors", "html_url": "https://github.com/jxors", "followers_url": "https://api.github.com/users/jxors/followers", "following_url": "https://api.github.com/users/jxors/following{/other_user}", "gists_url": "https://api.github.com/users/jxors/gists{/gist_id}", "starred_url": "https://api.github.com/users/jxors/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jxors/subscriptions", "organizations_url": "https://api.github.com/users/jxors/orgs", "repos_url": "https://api.github.com/users/jxors/repos", "events_url": "https://api.github.com/users/jxors/events{/privacy}", "received_events_url": "https://api.github.com/users/jxors/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"url": "https://api.github.com/repos/libLISA/liblisa/issues/3/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/libLISA/liblisa/issues/3/timeline", "performed_via_github_app": null, "state_reason": "completed", "pinned_comment": null}, {"url": "https://api.github.com/repos/libLISA/liblisa/issues/2", "repository_url": "https://api.github.com/repos/libLISA/liblisa", "labels_url": "https://api.github.com/repos/libLISA/liblisa/issues/2/labels{/name}", "comments_url": "https://api.github.com/repos/libLISA/liblisa/issues/2/comments", "events_url": "https://api.github.com/repos/libLISA/liblisa/issues/2/events", "html_url": "https://github.com/libLISA/liblisa/pull/2", "id": 2854449667, "node_id": "PR_kwDOFntgYs6LSSwD", "number": 2, "title": "Add Instructions To Install nightly Toolchain", "user": {"login": "ErrWare", "id": 32579486, "node_id": "MDQ6VXNlcjMyNTc5NDg2", "avatar_url": "https://avatars.githubusercontent.com/u/32579486?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ErrWare", "html_url": "https://github.com/ErrWare", "followers_url": "https://api.github.com/users/ErrWare/followers", "following_url": "https://api.github.com/users/ErrWare/following{/other_user}", "gists_url": "https://api.github.com/users/ErrWare/gists{/gist_id}", "starred_url": "https://api.github.com/users/ErrWare/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ErrWare/subscriptions", "organizations_url": "https://api.github.com/users/ErrWare/orgs", "repos_url": "https://api.github.com/users/ErrWare/repos", "events_url": "https://api.github.com/users/ErrWare/events{/privacy}", "received_events_url": "https://api.github.com/users/ErrWare/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "labels": [], "state": "closed", "locked": false, "assignees": [], "milestone": null, "comments": 1, "created_at": "2025-02-14T18:23:09Z", "updated_at": "2025-02-14T20:40:16Z", "closed_at": "2025-02-14T20:40:11Z", "assignee": null, "author_association": "CONTRIBUTOR", "issue_field_values": [], "type": null, "active_lock_reason": null, "draft": false, "pull_request": {"url": "https://api.github.com/repos/libLISA/liblisa/pulls/2", "html_url": "https://github.com/libLISA/liblisa/pull/2", "diff_url": "https://github.com/libLISA/liblisa/pull/2.diff", "patch_url": "https://github.com/libLISA/liblisa/pull/2.patch", "merged_at": "2025-02-14T20:40:11Z"}, "body": "I was getting the error 'error: toolchain 'nightly-x86_64-unknown-linux-gnu' is not installed'\r\n\r\nThe `rustup toolchain install nightly` command fixed it. Hopefully this saves others some time.", "closed_by": {"login": "jxors", "id": 9155798, "node_id": "MDQ6VXNlcjkxNTU3OTg=", "avatar_url": "https://avatars.githubusercontent.com/u/9155798?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jxors", "html_url": "https://github.com/jxors", "followers_url": "https://api.github.com/users/jxors/followers", "following_url": "https://api.github.com/users/jxors/following{/other_user}", "gists_url": "https://api.github.com/users/jxors/gists{/gist_id}", "starred_url": "https://api.github.com/users/jxors/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jxors/subscriptions", "organizations_url": "https://api.github.com/users/jxors/orgs", "repos_url": "https://api.github.com/users/jxors/repos", "events_url": "https://api.github.com/users/jxors/events{/privacy}", "received_events_url": "https://api.github.com/users/jxors/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"url": "https://api.github.com/repos/libLISA/liblisa/issues/2/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/libLISA/liblisa/issues/2/timeline", "performed_via_github_app": null, "state_reason": null}, {"url": "https://api.github.com/repos/libLISA/liblisa/issues/1", "repository_url": "https://api.github.com/repos/libLISA/liblisa", "labels_url": "https://api.github.com/repos/libLISA/liblisa/issues/1/labels{/name}", "comments_url": "https://api.github.com/repos/libLISA/liblisa/issues/1/comments", "events_url": "https://api.github.com/repos/libLISA/liblisa/issues/1/events", "html_url": "https://github.com/libLISA/liblisa/issues/1", "id": 2804588996, "node_id": "I_kwDOFntgYs6nKqHE", "number": 1, "title": "Question about encoding c4037d0080000000000c", "user": {"login": "KenSykes", "id": 56104430, "node_id": "MDQ6VXNlcjU2MTA0NDMw", "avatar_url": "https://avatars.githubusercontent.com/u/56104430?v=4", "gravatar_id": "", "url": "https://api.github.com/users/KenSykes", "html_url": "https://github.com/KenSykes", "followers_url": "https://api.github.com/users/KenSykes/followers", "following_url": "https://api.github.com/users/KenSykes/following{/other_user}", "gists_url": "https://api.github.com/users/KenSykes/gists{/gist_id}", "starred_url": "https://api.github.com/users/KenSykes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/KenSykes/subscriptions", "organizations_url": "https://api.github.com/users/KenSykes/orgs", "repos_url": "https://api.github.com/users/KenSykes/repos", "events_url": "https://api.github.com/users/KenSykes/events{/privacy}", "received_events_url": "https://api.github.com/users/KenSykes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "labels": [], "state": "closed", "locked": false, "assignees": [], "milestone": null, "comments": 2, "created_at": "2025-01-22T14:47:48Z", "updated_at": "2025-01-23T09:45:50Z", "closed_at": "2025-01-22T18:14:28Z", "assignee": null, "author_association": "NONE", "issue_field_values": [], "type": null, "active_lock_reason": null, "sub_issues_summary": {"total": 0, "completed": 0, "percent_completed": 0}, "issue_dependencies_summary": {"blocked_by": 0, "total_blocked_by": 0, "blocking": 0, "total_blocking": 0}, "body": "I used your liblisa command line tool to extract all the bit encodings from the five CPUs you provided, deduped them, and ran them through the iced-x86 (Rust) Intel decoder. It reports a family of instructions starting with C4 as invalid (such as encoding in the title). According to ref.x86asm.net c4 is  [invalid in 64-bit mode](http://ref.x86asm.net/coder64.html#xC4) and an [LES instruction](http://ref.x86asm.net/coder32.html#xC4) in 32-bit mode.\n\nAttempting to execute this instruction on Windows results in an illegal instruction exception (Windows debugger doesn't recognize instruction either):\n\n```\n0:000> u @rip\nntdll!LdrpDoDebuggerBreak+0x35:\n00007ffd`b7621429 c4              ???\n00007ffd`b762142a 037d00          add     edi,dword ptr [rbp]\n00007ffd`b762142d 800000          add     byte ptr [rax],0\n00007ffd`b7621430 0000            add     byte ptr [rax],al\n00007ffd`b7621432 0ccc            or      al,0CCh\n00007ffd`b7621434 cc              int     3\n00007ffd`b7621435 cc              int     3\n00007ffd`b7621436 cc              int     3\n0:000> g\n(13de8.14f50): Illegal instruction - code c000001d (first chance)\n```\n\nBut LibLISA says this encoding will read 32 bytes from [R8] into XMM8: https://explore.liblisa.nl/instruction/c4037d0080000000000c?arch=3900X\n\nThoughts?", "closed_by": {"login": "KenSykes", "id": 56104430, "node_id": "MDQ6VXNlcjU2MTA0NDMw", "avatar_url": "https://avatars.githubusercontent.com/u/56104430?v=4", "gravatar_id": "", "url": "https://api.github.com/users/KenSykes", "html_url": "https://github.com/KenSykes", "followers_url": "https://api.github.com/users/KenSykes/followers", "following_url": "https://api.github.com/users/KenSykes/following{/other_user}", "gists_url": "https://api.github.com/users/KenSykes/gists{/gist_id}", "starred_url": "https://api.github.com/users/KenSykes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/KenSykes/subscriptions", "organizations_url": "https://api.github.com/users/KenSykes/orgs", "repos_url": "https://api.github.com/users/KenSykes/repos", "events_url": "https://api.github.com/users/KenSykes/events{/privacy}", "received_events_url": "https://api.github.com/users/KenSykes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"url": "https://api.github.com/repos/libLISA/liblisa/issues/1/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/libLISA/liblisa/issues/1/timeline", "performed_via_github_app": null, "state_reason": "completed", "pinned_comment": null}]