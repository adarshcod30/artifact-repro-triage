sers/erdogant/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "erdogant", "id": 31008129, "node_id": "MDQ6VXNlcjMxMDA4MTI5", "avatar_url": "https://avatars.githubusercontent.com/u/31008129?v=4", "gravatar_id": "", "url": "https://api.github.com/users/erdogant", "html_url": "https://github.com/erdogant", "followers_url": "https://api.github.com/users/erdogant/followers", "following_url": "https://api.github.com/users/erdogant/following{/other_user}", "gists_url": "https://api.github.com/users/erdogant/gists{/gist_id}", "starred_url": "https://api.github.com/users/erdogant/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/erdogant/subscriptions", "organizations_url": "https://api.github.com/users/erdogant/orgs", "repos_url": "https://api.github.com/users/erdogant/repos", "events_url": "https://api.github.com/users/erdogant/events{/privacy}", "received_events_url": "https://api.github.com/users/erdogant/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "3b26c862909955f615573ba5f3b7fb5848f01871", "url": "https://api.github.com/repos/erdogant/irelease/commits/3b26c862909955f615573ba5f3b7fb5848f01871", "html_url": "https://github.com/erdogant/irelease/commit/3b26c862909955f615573ba5f3b7fb5848f01871"}], "stats": {"total": 57, "additions": 56, "deletions": 1}, "files": [{"sha": "70e5df47784720137e0d8794c4ddef601484ef96", "filename": ".github/workflows/release.yml", "status": "added", "additions": 55, "deletions": 0, "changes": 55, "blob_url": "https://github.com/erdogant/irelease/blob/76369c66df4b5343992486343bd70d68fa4d8afd/.github%2Fworkflows%2Frelease.yml", "raw_url": "https://github.com/erdogant/irelease/raw/76369c66df4b5343992486343bd70d68fa4d8afd/.github%2Fworkflows%2Frelease.yml", "contents_url": "https://api.github.com/repos/erdogant/irelease/contents/.github%2Fworkflows%2Frelease.yml?ref=76369c66df4b5343992486343bd70d68fa4d8afd", "patch": "@@ -0,0 +1,55 @@\n+name: Publish to PyPI\n+\n+# Publishes when a GitHub release is published (e.g. by irelease).\n+# Uses PyPI Trusted Publishing (OIDC): no API token or secret needed, but the\n+# publisher must be registered once on PyPI under\n+# Manage project -> Publishing -> GitHub: owner=erdogant, repo=irelease,\n+# workflow=release.yml, environment=pypi.\n+on:\n+  release:\n+    types: [published]\n+  workflow_dispatch:\n+\n+jobs:\n+  build:\n+    name: Build distribution\n+    runs-on: ubuntu-latest\n+\n+    steps:\n+      - uses: actions/checkout@v4\n+\n+      - name: Install uv\n+        uses: astral-sh/setup-uv@v6\n+\n+      - name: Build sdist and wheel\n+        run: uv build\n+\n+      - name: Check metadata\n+        run: uvx twine check --strict dist/*\n+\n+      - uses: actions/upload-artifact@v4\n+        with:\n+          name: dist\n+          path: dist/\n+\n+  publish:\n+    name: Publish to PyPI\n+    needs: build\n+    # Only the canonical repository publishes. Forks that cut their own\n+    # GitHub release still build and check the artifacts, but skip the upload.\n+    if: github.repository_owner == 'erdogant'\n+    runs-on: ubuntu-latest\n+    environment:\n+      name: pypi\n+      url: https://pypi.org/p/irelease\n+    permissions:\n+      # OIDC token for PyPI Trusted Publishing\n+      id-token: write\n+\n+    steps:\n+      - uses: actions/download-artifact@v4\n+        with:\n+          name: dist\n+          path: dist/\n+\n+      - uses: pypa/gh-action-pypi-publish@release/v1"}, {"sha": "6f1cbc95c21632978c48ff96e1636cf4c4194a23", "filename": "irelease/__init__.py", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/erdogant/irelease/blob/76369c66df4b5343992486343bd70d68fa4d8afd/irelease%2F__init__.py", "raw_url": "https://github.com/erdogant/irelease/raw/76369c66df4b5343992486343bd70d68fa4d8afd/irelease%2F__init__.py", "contents_url": "https://api.github.com/repos/erdogant/irelease/contents/irelease%2F__init__.py?ref=76369c66df4b5343992486343bd70d68fa4d8afd", "patch": "@@ -5,7 +5,7 @@\n \n __author__ = 'Erdogan Tasksen'\n __email__ = 'erdogant@gmail.com'\n-__version__ = '1.3.3'\n+__version__ = '1.3.4'\n \n \n # module level doc-string"}]}