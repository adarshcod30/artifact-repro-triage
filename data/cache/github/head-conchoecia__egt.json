ull requests should append entries to `[Unreleased]` under the appropriate sect\n \n ## [Unreleased]\n \n+## [0.2.6] - 2026-08-28\n+\n ### Added\n - `egt phylotreeumap mlt-matrix` \u2014 new subcommand exposing `topoumap_genmatrix()`: averages the genome-by-locus-pair distance matrix (from `combine-distances`) into the MLT locus-by-locus matrix that `mgt-mlt-umap` consumes in MLT mode. Previously this stage was only reachable through the Snakemake workflows, so the MLT arm of the pipeline could not be run stage-by-stage from the CLI.\n "}, {"sha": "36181b1b94a1fa17abcba97e379c51fb957bc761", "filename": "CITATION.cff", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/conchoecia/egt/blob/d135408071ed733ac605dbd5ea5412540f6fef9c/CITATION.cff", "raw_url": "https://github.com/conchoecia/egt/raw/d135408071ed733ac605dbd5ea5412540f6fef9c/CITATION.cff", "contents_url": "https://api.github.com/repos/conchoecia/egt/contents/CITATION.cff?ref=d135408071ed733ac605dbd5ea5412540f6fef9c", "patch": "@@ -1,7 +1,7 @@\n cff-version: 1.2.0\n message: \"If you use this software, please cite both the software and the preferred citation below.\"\n title: \"egt: Evolutionary Genome Topology analysis toolkit\"\n-version: 0.2.5\n+version: 0.2.6\n license: MIT\n repository-code: \"https://github.com/conchoecia/egt\"\n authors:"}, {"sha": "9f5f6add5a4c594dacc041b62a157e3056574b55", "filename": "pyproject.toml", "status": "modified", "additions": 2, "deletions": 2, "changes": 4, "blob_url": "https://github.com/conchoecia/egt/blob/d135408071ed733ac605dbd5ea5412540f6fef9c/pyproject.toml", "raw_url": "https://github.com/conchoecia/egt/raw/d135408071ed733ac605dbd5ea5412540f6fef9c/pyproject.toml", "contents_url": "https://api.github.com/repos/conchoecia/egt/contents/pyproject.toml?ref=d135408071ed733ac605dbd5ea5412540f6fef9c", "patch": "@@ -4,7 +4,7 @@ build-backend = \"setuptools.build_meta\"\n \n [project]\n name = \"egt\"\n-version = \"0.2.5\"\n+version = \"0.2.6\"\n description = \"Evolutionary Genome Topology \u2014 analysis toolkit for chromosome evolution across metazoan genomes using reciprocal-best-hits data.\"\n readme = \"README.md\"\n requires-python = \">=3.10\"\n@@ -91,7 +91,7 @@ addopts = \"-v --tb=short\"\n # creates a v<NEW> tag. Push with `git push --follow-tags` (or use the\n # `--push` flag if a release remote is configured).\n [tool.bumpversion]\n-current_version = \"0.2.5\"\n+current_version = \"0.2.6\"\n parse = '(?P<major>\\d+)\\.(?P<minor>\\d+)\\.(?P<patch>\\d+)'\n serialize = [\"{major}.{minor}.{patch}\"]\n commit = true"}, {"sha": "01ef12070dc3373abb02369555f99945aab3a201", "filename": "src/egt/__init__.py", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/conchoecia/egt/blob/d135408071ed733ac605dbd5ea5412540f6fef9c/src%2Fegt%2F__init__.py", "raw_url": "https://github.com/conchoecia/egt/raw/d135408071ed733ac605dbd5ea5412540f6fef9c/src%2Fegt%2F__init__.py", "contents_url": "https://api.github.com/repos/conchoecia/egt/contents/src%2Fegt%2F__init__.py?ref=d135408071ed733ac605dbd5ea5412540f6fef9c", "patch": "@@ -1 +1 @@\n-__version__ = \"0.2.5\"\n+__version__ = \"0.2.6\""}]}