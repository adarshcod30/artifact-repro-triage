rivacy}", "received_events_url": "https://api.github.com/users/ammhelal/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "ammhelal", "id": 20818774, "node_id": "MDQ6VXNlcjIwODE4Nzc0", "avatar_url": "https://avatars.githubusercontent.com/u/20818774?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ammhelal", "html_url": "https://github.com/ammhelal", "followers_url": "https://api.github.com/users/ammhelal/followers", "following_url": "https://api.github.com/users/ammhelal/following{/other_user}", "gists_url": "https://api.github.com/users/ammhelal/gists{/gist_id}", "starred_url": "https://api.github.com/users/ammhelal/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ammhelal/subscriptions", "organizations_url": "https://api.github.com/users/ammhelal/orgs", "repos_url": "https://api.github.com/users/ammhelal/repos", "events_url": "https://api.github.com/users/ammhelal/events{/privacy}", "received_events_url": "https://api.github.com/users/ammhelal/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "b7faaa59057c6e120565125a2d7740925c78fb5f", "url": "https://api.github.com/repos/IntelLabs/ReLATE-Sparse/commits/b7faaa59057c6e120565125a2d7740925c78fb5f", "html_url": "https://github.com/IntelLabs/ReLATE-Sparse/commit/b7faaa59057c6e120565125a2d7740925c78fb5f"}], "stats": {"total": 2, "additions": 1, "deletions": 1}, "files": [{"sha": "b5cd5c7b4705dcef39b203b50138353d6e22f6fc", "filename": "README.md", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/IntelLabs/ReLATE-Sparse/blob/78be70c45959f699e2914d2355c0b8fe5f0121d6/README.md", "raw_url": "https://github.com/IntelLabs/ReLATE-Sparse/raw/78be70c45959f699e2914d2355c0b8fe5f0121d6/README.md", "contents_url": "https://api.github.com/repos/IntelLabs/ReLATE-Sparse/contents/README.md?ref=78be70c45959f699e2914d2355c0b8fe5f0121d6", "patch": "@@ -1,6 +1,6 @@\n # ReLATE\n ReLATE (reinforcement-learned adaptive tensor encoding) is a learning-augmented framework that discovers safe and efficient sparse tensor encodings for tensor decomposition (TD), without labeled training samples. An autonomous agent learns optimized encodings through direct interaction with the TD environment, using a hybrid model-free and model-based algorithm that learns from both real and imagined actions. To guarantee functionally correct encodings with bounded execution time even during early learning, ReLATE introduces elastic training, rule-driven action masking, and dynamics-informed action filtering. After offline training, ReLATE deploys the best encoding with zero inference overhead, adapting to irregular tensor shapes and data distributions to consistently outperform expert-designed formats by up to 2\u00d7. The detailed algorithms are described in the following paper:\n-* **ReLATE: Accelerating Tensor Decomposition via Safe and Efficient Learning of Sparse Encodings**. Ahmed E. Helal, Fabio Checconi, Jan Laukemann, Yongseok Soh, Jesmin Jahan Tithi, Fabrizio Petrini, Jeewhan Choi. (https://arxiv.org/abs/2509.00280).\n+* **ReLATE: Accelerating Tensor Decomposition via Safe and Efficient Learning of Sparse Encodings**. Ahmed E. Helal, Fabio Checconi, Jan Laukemann, Yongseok Soh, Jesmin Jahan Tithi, Fabrizio Petrini, Jeewhan Choi. In Proceedings of the International Conference for High Performance Computing, Networking, Storage and Analysis (SC26), November 2026.\n \n ## Getting started\n ReLATE learns encodings for the ALTO library (`extern/`) and drives it from Python."}]}