ents{/privacy}", "received_events_url": "https://api.github.com/users/AxEquals-b/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "AxEquals-b", "id": 143308437, "node_id": "U_kgDOCIq2lQ", "avatar_url": "https://avatars.githubusercontent.com/u/143308437?v=4", "gravatar_id": "", "url": "https://api.github.com/users/AxEquals-b", "html_url": "https://github.com/AxEquals-b", "followers_url": "https://api.github.com/users/AxEquals-b/followers", "following_url": "https://api.github.com/users/AxEquals-b/following{/other_user}", "gists_url": "https://api.github.com/users/AxEquals-b/gists{/gist_id}", "starred_url": "https://api.github.com/users/AxEquals-b/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/AxEquals-b/subscriptions", "organizations_url": "https://api.github.com/users/AxEquals-b/orgs", "repos_url": "https://api.github.com/users/AxEquals-b/repos", "events_url": "https://api.github.com/users/AxEquals-b/events{/privacy}", "received_events_url": "https://api.github.com/users/AxEquals-b/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "c1166de33ce106b0ed7a66f27978a058f6dce600", "url": "https://api.github.com/repos/AxEquals-b/ZXH_ADAE/commits/c1166de33ce106b0ed7a66f27978a058f6dce600", "html_url": "https://github.com/AxEquals-b/ZXH_ADAE/commit/c1166de33ce106b0ed7a66f27978a058f6dce600"}], "stats": {"total": 11, "additions": 11, "deletions": 0}, "files": [{"sha": "0ec3fc1a10127bf3c16c307bc94578b42df34e8d", "filename": "README.md", "status": "modified", "additions": 2, "deletions": 0, "changes": 2, "blob_url": "https://github.com/AxEquals-b/ZXH_ADAE/blob/fea58a888d3c89046c078d760b8e85317f53b89c/README.md", "raw_url": "https://github.com/AxEquals-b/ZXH_ADAE/raw/fea58a888d3c89046c078d760b8e85317f53b89c/README.md", "contents_url": "https://api.github.com/repos/AxEquals-b/ZXH_ADAE/contents/README.md?ref=fea58a888d3c89046c078d760b8e85317f53b89c", "patch": "@@ -54,6 +54,8 @@ ADAE_IMAGE=my-zxh-artifact:latest ./aggregate.sh\n \n This script first rebuilds the ZXH-Sim Python overlay into `src/pydeps` by invoking `install_zxh.sh`. It then builds a Docker image using `Dockerfile`. The Docker image copies `src/` into `/home/cuquantum/src`; at runtime only `output/` is mounted, so the source overlay used by a run is the one embedded in the prepared image.\n \n+The scripts automatically relax permissions on the bind-mounted `src/pydeps` and `output/` directories so that the cuQuantum Appliance container can write to them even if the release archive was extracted by a different host UID.\n+\n Useful environment variables:\n \n - `CUQUANTUM_IMAGE`: base image, default `nvcr.io/nvidia/cuquantum-appliance:25.11-x86_64`."}, {"sha": "f59ab5a4605a8e5d7320ea746d23d56d846d4a15", "filename": "aggregate.sh", "status": "modified", "additions": 2, "deletions": 0, "changes": 2, "blob_url": "https://github.com/AxEquals-b/ZXH_ADAE/blob/fea58a888d3c89046c078d760b8e85317f53b89c/aggregate.sh", "raw_url": "https://github.com/AxEquals-b/ZXH_ADAE/raw/fea58a888d3c89046c078d760b8e85317f53b89c/aggregate.sh", "contents_url": "https://api.github.com/repos/AxEquals-b/ZXH_ADAE/contents/aggregate.sh?ref=fea58a888d3c89046c078d760b8e85317f53b89c", "patch": "@@ -9,6 +9,8 @@ ABLATION_RUN_ID=\"${ABLATION_RUN_ID:-latest}\"\n P_BATCH_RUN_ID=\"${P_BATCH_RUN_ID:-${ZXH_RUN_ID}}\"\n \n mkdir -p \"${ROOT_DIR}/output/figures\"\n+# The container may use a different UID than the host user that extracted the artifact.\n+chmod -R a+rwX \"${ROOT_DIR}/output\"\n \n docker run --rm \\\n   --gpus all \\"}, {"sha": "41c6a919f7f11e9af51d40bdc05294b204fca044", "filename": "install_zxh.sh", "status": "modified", "additions": 5, "deletions": 0, "changes": 5, "blob_url": "https://github.com/AxEquals-b/ZXH_ADAE/blob/fea58a888d3c89046c078d760b8e85317f53b89c/install_zxh.sh", "raw_url": "https://github.com/AxEquals-b/ZXH_ADAE/raw/fea58a888d3c89046c078d760b8e85317f53b89c/install_zxh.sh", "contents_url": "https://api.github.com/repos/AxEquals-b/ZXH_ADAE/contents/install_zxh.sh?ref=fea58a888d3c89046c078d760b8e85317f53b89c", "patch": "@@ -22,6 +22,11 @@ if [[ ! -d \"${PYDEPS_DIR}\" ]]; then\n \texit 1\n fi\n \n+# The cuQuantum Appliance container runs as its internal cuquantum user.\n+# Make the bind-mounted overlay writable even when a release zip was\n+# extracted by a different host UID.\n+chmod -R a+rwX \"${PYDEPS_DIR}\"\n+\n docker_args=(\n \t--rm\n \t--gpus all"}, {"sha": "654fced7bd51c51805a024da772f490caa5ed51a", "filename": "run_all.sh", "status": "modified", "additions": 2, "deletions": 0, "changes": 2, "blob_url": "https://github.com/AxEquals-b/ZXH_ADAE/blob/fea58a888d3c89046c078d760b8e85317f53b89c/run_all.sh", "raw_url": "https://github.com/AxEquals-b/ZXH_ADAE/raw/fea58a888d3c89046c078d760b8e85317f53b89c/run_all.sh", "contents_url": "https://api.github.com/repos/AxEquals-b/ZXH_ADAE/contents/run_all.sh?ref=fea58a888d3c89046c078d760b8e85317f53b89c", "patch": "@@ -16,6 +16,8 @@ RUN_ABLATIONS=\"${RUN_ABLATIONS:-1}\"\n RUN_P_BATCH=\"${RUN_P_BATCH:-1}\"\n \n mkdir -p \"${ROOT_DIR}/output/results\" \"${ROOT_DIR}/output/circuits\" \"${ROOT_DIR}/output/figures\"\n+# The container may use a different UID than the host user that extracted the artifact.\n+chmod -R a+rwX \"${ROOT_DIR}/output\"\n \n docker run --rm \\\n   --gpus all \\"}]}