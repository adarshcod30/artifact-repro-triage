iss/received_events", "type": "User", "user_view_type": "public", "site_admin": false}], "milestone": null, "comments": 0, "created_at": "2023-10-17T11:12:24Z", "updated_at": "2023-10-17T17:48:41Z", "closed_at": "2023-10-17T17:48:41Z", "assignee": {"login": "AlexanderSchultheiss", "id": 54794966, "node_id": "MDQ6VXNlcjU0Nzk0OTY2", "avatar_url": "https://avatars.githubusercontent.com/u/54794966?v=4", "gravatar_id": "", "url": "https://api.github.com/users/AlexanderSchultheiss", "html_url": "https://github.com/AlexanderSchultheiss", "followers_url": "https://api.github.com/users/AlexanderSchultheiss/followers", "following_url": "https://api.github.com/users/AlexanderSchultheiss/following{/other_user}", "gists_url": "https://api.github.com/users/AlexanderSchultheiss/gists{/gist_id}", "starred_url": "https://api.github.com/users/AlexanderSchultheiss/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/AlexanderSchultheiss/subscriptions", "organizations_url": "https://api.github.com/users/AlexanderSchultheiss/orgs", "repos_url": "https://api.github.com/users/AlexanderSchultheiss/repos", "events_url": "https://api.github.com/users/AlexanderSchultheiss/events{/privacy}", "received_events_url": "https://api.github.com/users/AlexanderSchultheiss/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "author_association": "MEMBER", "issue_field_values": [], "type": null, "active_lock_reason": null, "sub_issues_summary": {"total": 0, "completed": 0, "percent_completed": 0}, "issue_dependencies_summary": {"blocked_by": 0, "total_blocked_by": 0, "blocking": 0, "total_blocking": 0}, "body": "# Description\r\nFor debugging purposes, it is often necessary to manually check data related to a result (e.g., the patch, the rejects, or the patched file). The current debugging mode only saves the data related to the current experimental run, which makes it difficult to analyze results retroactively. \r\n\r\n# Task \r\nChange the writing of debugging information so that the corresponding data is stored for each experimental run separately. \r\n\r\n## Data \r\nThe following data is to be written:\r\n- normal patch \r\n- filtered patch\r\n- rejects file of normal patch\r\n- rejects file of filtered patch\r\n-  for each variant:\r\n  - target files before patching\r\n  - target files after patching (actual)\r\n  - target files after patching (expected)\r\n  - presence conditions \r\n  - configuration\r\n- for the SPL\r\n  - target files before patching\r\n  - target files after patching (expected)\r\n  - presence conditions\r\n  - diff", "closed_by": {"login": "AlexanderSchultheiss", "id": 54794966, "node_id": "MDQ6VXNlcjU0Nzk0OTY2", "avatar_url": "https://avatars.githubusercontent.com/u/54794966?v=4", "gravatar_id": "", "url": "https://api.github.com/users/AlexanderSchultheiss", "html_url": "https://github.com/AlexanderSchultheiss", "followers_url": "https://api.github.com/users/AlexanderSchultheiss/followers", "following_url": "https://api.github.com/users/AlexanderSchultheiss/following{/other_user}", "gists_url": "https://api.github.com/users/AlexanderSchultheiss/gists{/gist_id}", "starred_url": "https://api.github.com/users/AlexanderSchultheiss/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/AlexanderSchultheiss/subscriptions", "organizations_url": "https://api.github.com/users/AlexanderSchultheiss/orgs", "repos_url": "https://api.github.com/users/AlexanderSchultheiss/repos", "events_url": "https://api.github.com/users/AlexanderSchultheiss/events{/privacy}", "received_events_url": "https://api.github.com/users/AlexanderSchultheiss/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"url": "https://api.github.com/repos/VariantSync/patching-with-matching-eval/issues/1/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.