ers/jviszlai/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "jviszlai", "id": 22546326, "node_id": "MDQ6VXNlcjIyNTQ2MzI2", "avatar_url": "https://avatars.githubusercontent.com/u/22546326?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jviszlai", "html_url": "https://github.com/jviszlai", "followers_url": "https://api.github.com/users/jviszlai/followers", "following_url": "https://api.github.com/users/jviszlai/following{/other_user}", "gists_url": "https://api.github.com/users/jviszlai/gists{/gist_id}", "starred_url": "https://api.github.com/users/jviszlai/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jviszlai/subscriptions", "organizations_url": "https://api.github.com/users/jviszlai/orgs", "repos_url": "https://api.github.com/users/jviszlai/repos", "events_url": "https://api.github.com/users/jviszlai/events{/privacy}", "received_events_url": "https://api.github.com/users/jviszlai/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "a2eaa5249c9c148b5518d1d5cfdab3ec8bdc97dc", "url": "https://api.github.com/repos/jviszlai/PropHunt/commits/a2eaa5249c9c148b5518d1d5cfdab3ec8bdc97dc", "html_url": "https://github.com/jviszlai/PropHunt/commit/a2eaa5249c9c148b5518d1d5cfdab3ec8bdc97dc"}], "stats": {"total": 12, "additions": 12, "deletions": 0}, "files": [{"sha": "901250598319a004242a0c0b039cc96640fa19a0", "filename": "README.md", "status": "added", "additions": 12, "deletions": 0, "changes": 12, "blob_url": "https://github.com/jviszlai/PropHunt/blob/4b04cd0f42beb15cf2d4f0aa43edf0e45226985a/README.md", "raw_url": "https://github.com/jviszlai/PropHunt/raw/4b04cd0f42beb15cf2d4f0aa43edf0e45226985a/README.md", "contents_url": "https://api.github.com/repos/jviszlai/PropHunt/contents/README.md?ref=4b04cd0f42beb15cf2d4f0aa43edf0e45226985a", "patch": "@@ -0,0 +1,12 @@\n+# PropHunt\n+\n+PropHunt is a tool for automated optimization of syndrome measurement circuits of CSS codes. \n+\n+## Setup\n+The recommended method is to use the provided Docker image. This also includes building of the [`loandra`](https://github.com/jezberg/loandra) MaxSAT solver. The Docker image can be built by running `make docker`.\n+\n+If built without Docker, the paths in `prop_hunt/ambiguous_error.py` will need to be updated to match the `loandra` install location.\n+\n+## Usage\n+Example usage can be seen in `scripts/prophunt_experiment.py`. The simplest method is to use `prop_hunt.prop_graph.prop_graph_from_code` with a `CSSCode` from the [`qLDPC` repository](https://github.com/qLDPCOrg/qLDPC) and construct a `PropHuntCompiler` using the resulting `PropagationGraph`. Estimated effective distances are output after each optimization iteration. \n+"}]}