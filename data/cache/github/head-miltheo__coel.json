on", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/miltheo/coel/blob/23a8e1a548416cf81a44f73541d4569e7cae63cc/.zenodo.json", "raw_url": "https://github.com/miltheo/coel/raw/23a8e1a548416cf81a44f73541d4569e7cae63cc/.zenodo.json", "contents_url": "https://api.github.com/repos/miltheo/coel/contents/.zenodo.json?ref=23a8e1a548416cf81a44f73541d4569e7cae63cc", "patch": "@@ -4,7 +4,7 @@\n   \"description\": \"The Classification of Everyday Living (COEL) Extended Digital Ecosystem provides versioned resources for representing interoperable behavioural health event data. This release includes the COEL Behavioural Atom v2.0 JSON Schema, behaviour classification model registries, mappings to COEL concepts, derived JSON and Turtle serialisations, JSON-LD projection resources, documentation, and reproducibility utilities. The accompanying Semantic Web Journal replication package contains two compressed canonical Atom payloads, compact reference results, and a one-command analysis pipeline for reproducing the reported validation, temporal retrieval, and semantic aggregation results.\",\n   \"license\": \"GPL-3.0-or-later\",\n   \"access_right\": \"open\",\n-  \"version\": \"2.0.0\",\n+  \"version\": \"1.0.0\",\n   \"keywords\": [\n     \"Classification of Everyday Living\",\n     \"COEL\","}]}