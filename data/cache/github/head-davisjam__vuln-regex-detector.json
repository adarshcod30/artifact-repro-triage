\n-    &chkcmd(\"cd rxxr/code; ./build.sh; cd -\");\n+    &chkcmd(\"cd $clone_dir; git checkout $stable; cd code; ./build.sh; cd ../..\");\n \n     &log(\"Cleaning up\");\n-    &chkcmd(\"mv rxxr/code/scan.bin /tmp/RXXR2-INSTALL-scan.bin\");\n-    &chkcmd(\"rm -rf rxxr/\");\n+    &chkcmd(\"mv $clone_dir/code/scan.bin /tmp/RXXR2-INSTALL-scan.bin\");\n+    &chkcmd(\"rm -rf $clone_dir/\");\n     &chkcmd(\"mkdir $dir\");\n     &chkcmd(\"mv /tmp/RXXR2-INSTALL-scan.bin $file\");\n-    &chkcmd(\"rm rxxr2.zip\");\n \n     if (not -f $file) {\n       die \"Error, configuring rxxr2 failed: could not find $file\\n\";"}, {"sha": "d90683c89146b2f47aa9a7cba0426ac6a19159d1", "filename": "src/validate/test/go/safe.json", "status": "added", "additions": 1, "deletions": 0, "changes": 1, "blob_url": "https://github.com/davisjam/vuln-regex-detector/blob/54ddfd60ced5ea0735ed42b910505fa14d3b41bf/src%2Fvalidate%2Ftest%2Fgo%2Fsafe.json", "raw_url": "https://github.com/davisjam/vuln-regex-detector/raw/54ddfd60ced5ea0735ed42b910505fa14d3b41bf/src%2Fvalidate%2Ftest%2Fgo%2Fsafe.json", "contents_url": "https://api.github.com/repos/davisjam/vuln-regex-detector/contents/src%2Fvalidate%2Ftest%2Fgo%2Fsafe.json?ref=54ddfd60ced5ea0735ed42b910505fa14d3b41bf", "patch": "@@ -0,0 +1 @@\n+{\"language\":\"go\", \"pattern\":\"a+$\", \"evilInput\": {\"suffix\":\"bb\",\"pumpPairs\":[{\"prefix\":\"\",\"pump\":\"aa\"}]}, \"nPumps\": 1000, \"timeLimit\": 10}"}, {"sha": "c924ff2aa5e27095e0ace0771b82ac645176ae81", "filename": "src/validate/test/go/unsafe-complex.json", "status": "added", "additions": 1, "deletions": 0, "changes": 1, "blob_url": "https://github.com/davisjam/vuln-regex-detector/blob/54ddfd60ced5ea0735ed42b910505fa14d3b41bf/src%2Fvalidate%2Ftest%2Fgo%2Funsafe-complex.json", "raw_url": "https://github.com/davisjam/vuln-regex-detector/raw/54ddfd60ced5ea0735ed42b910505fa14d3b41bf/src%2Fvalidate%2Ftest%2Fgo%2Funsafe-complex.json", "contents_url": "https://api.github.com/repos/davisjam/vuln-regex-detector/