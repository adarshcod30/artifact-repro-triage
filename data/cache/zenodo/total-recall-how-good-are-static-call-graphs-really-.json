hive": "https://zenodo.org/api/records/8207702/files-archive", "archive_media": "https://zenodo.org/api/records/8207702/media-files-archive", "latest": "https://zenodo.org/api/records/8207702/versions/latest", "latest_html": "https://zenodo.org/records/8207702/latest", "versions": "https://zenodo.org/api/records/8207702/versions", "draft": "https://zenodo.org/api/records/8207702/draft", "access_links": "https://zenodo.org/api/records/8207702/access/links", "access_grants": "https://zenodo.org/api/records/8207702/access/grants", "access_users": "https://zenodo.org/api/records/8207702/access/users", "access_request": "https://zenodo.org/api/records/8207702/access/request", "access": "https://zenodo.org/api/records/8207702/access", "communities": "https://zenodo.org/api/records/8207702/communities", "communities-suggestions": "https://zenodo.org/api/records/8207702/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/8207702/request-deletion", "file_modification": "https://zenodo.org/api/records/8207702/file-modification", "quota_increase": "https://zenodo.org/api/records/8207702/quota-increase", "requests": "https://zenodo.org/api/records/8207702/requests"}, "updated": "2023-08-03T02:27:02.864223+00:00", "recid": "8207702", "revision": 2, "files": [{"id": "ec33b4b1-948c-44f9-aefc-bcd249cb9d37", "key": "artifact.7z", "size": 663826062, "checksum": "md5:2e87f89f709fb5b15e25c16b03a01848", "links": {"self": "https://zenodo.org/api/records/8207702/files/artifact.7z/content"}}], "swh": null, "owners": [{"id": "558945"}], "status": "published", "stats": {"downloads": 46, "unique_downloads": 46, "views": 279, "unique_views": 270, "version_downloads": 30, "version_unique_downloads": 30, "version_unique_views": 99, "version_views": 100}, "state": "done", "submitted": true}, {"created": "2024-07-30T14:35:31.905392+00:00", "modified": "2024-07-30T14:36:48.996871+00:00", "id": 13134617, "conceptrecid": "10888531", "doi": "10.5281/zenodo.13134617", "conceptdoi": "10.5281/zenodo.10888531", "doi_url": "https://doi.org/10.5281/zenodo.13134617", "metadata": {"title": "Total Recall? How Good are Static Call Graphs Really? - Companion Artifact", "doi": "10.5281/zenodo.13134617", "publication_date": "2024-07-30", "description": "<div>\n<div>This artifact holds a pipeline that captures a <em>dynamic callgraph</em> for a JVM program and a given set of inputs (input corpus). This dynamic callgraph can then be used as a <em>baseline</em> to compute precision and recall of a defined set of static callgraphs.</div>\n<br>\n<div>To achieve a good quality of the dynamic baseline, the pipeline provides different techniques for creating a suitable input corpus. These are:</div>\n<br>\n<div>\n<ol>\n<li><strong>Base Seed Corpus</strong>: Pre-existing input corpora found online, without any modification</li>\n<li><strong>Seed Corpus:</strong> Manual additions to the Base Seed Corpus derived from inspecting the coverage values.</li>\n<li><strong>Fuzzing:</strong> A coverage-guided fuzzer (<a href=\"https://github.com/CodeIntelligenceTesting/jazzer\">Jazzer</a>) generates program inputs from scratch</li>\n<li><strong>Fuzzing Seed</strong>: Jazzer generates new inputs using the Seed Corpus as a starting point. This is the combination of all aforementioned techniques, which we found to be best suited for good quality dynamic callgraphs.</li>\n</ol>\n</div>\n<div>The pipeline evaluates precision and recall for the following fixed set of static callgraphs:</div>\n<br>\n<div>\n<ul>\n<li>OPAL: CHA, RTA, 0-CFA</li>\n<li>WALA: CHA, RTA, 0-CFA</li>\n<li>Soot: CHA</li>\n<li>Doop: 0-CFA</li>\n</ul>\n</div>\n<br>\n<div>Numerical values for precision and recall are computed for every static callgraph and every project. We further include scripts that visualize those values for our set of four programs.</div>\n<div>&nbsp;</div>\n<div>The artifact consists of three archives:</div>\n<div>&nbsp;</div>\n<div>\n<ol>\n<li><em>total_recall_paper_supplementary.zip</em>: Holds supplementary material for our paper, including proofs for bounds to precision and recall, as well as additional visualizations.</li>\n<li><em>total_recall_artifact.zip: </em>Holds the implementation of our pipeline and most of the data generated for our evaluation. A detailed description on how to use this artifact can be found in the enclosed README.md file.</li>\n<li><em>total_recall_artifact_supplementary.zip</em>: Holds supplementary data for our artifact. This may be helpful if you do not have access to the computing resources required to compute static callgraphs. Installation instructions can be found in the enclosed README.md file.</li>\n</ol>\n</div>\n</div>", "access_right": "open", "creators": [{"name": "Helm, Dominik", "affiliation": "Technische Universit\u00e4t Darmstadt", "orcid": "0009-0004-6425-8630"}, {"name": "Keidel, Sven", "affiliation": "Technische Universit\u00e4t Darmstadt", "orcid": "0000-0002-4278-2181"}, {"name": "Kampk\u00f6tter, Anemone", "affiliation": "Technische Universit\u00e4t Dortmund", "orcid": "0000-0003-4286-714X"}, {"name": "D\u00fcsing, Johannes", "affiliation": "Technische Universit\u00e4t Dortmund", "orcid": "0000-0002-9367-2206"}, {"name": "Roth, Tobias", "affiliation": "Technische Universit\u00e4t Darmstadt", "orcid": "0000-0001-6561-0430"}, {"name": "Hermann, Ben", "affiliation": "Technische Universit\u00e4t Dortmund", "orcid": "0000-0001-9848-2017"}, {"name": "Mezini, Mira", "affiliation": "Technische Universit\u00e4t Darmstadt", "orcid": "0000-0001-6563-7537"}], "keywords": ["call graph", "static analysis", "dynamic analysis", "precision", "recall"], "related_identifiers": [{"identifier": "10.1145/3650212.3652114", "relation": "isSupplementTo", "resource_type": "publication-conferencepaper", "scheme": "doi"}], "version": "2.0.0", "language": "eng", "custom": {"code:programmingLanguage": [{"id": "java", "title": {"en": "Java"}}, {"id": "python", "title": {"en": "Python"}}]}, "resource_type": {"title": "Software", "type": "software"}, "meeting": {"title": "ACM SIGSOFT International Symposium on Software Testing and Analysis", "acronym": "ISSTA", "dates": "16.09.2024 - 20.09.2024", "place": "Vienna", "url": "https://2024.issta.org/"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "10888531"}}]}}, "title": "Total Recall? How Good are Static Call Graphs Really? - Companion Artifact", "links": {"self": "https://zenodo.org/api/records/13134617", "self_html": "https://zenodo.org/records/13134617", "preview_html": "https://zenodo.org/records/13134617?preview=1", "doi": "https://doi.org/10.5281/zenodo.13134617", "self_doi": "https://doi.org/10.5281/zenodo.13134617", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.13134617", "reserve_doi": "https://zenodo.org/api/records/13134617/draft/pids/doi", "parent": "https://zenodo.org/api/records/10888531", "parent_html": "https://zenodo.org/records/10888531", "parent_doi": "https://doi.org/10.5281/zenodo.10888531", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.10888531", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:13134617/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:13134617/sequence/default", "files": "https://zenodo.org/api/records/13134617/files", "media_files": "https://zenodo.org/api/records/13134617/media-files", "archive": "https://zenodo.org/api/records/13134617/files-archive", "archive_media": "https://zenodo.org/api/records/13134617/media-files-archive", "latest": "https://zenodo.org/api/records/13134617/versions/latest", "latest_html": "https://zenodo.org/records/13134617/latest", "versions": "https://zenodo.org/api/records/13134617/versions", "draft": "https://zenodo.org/api/records/13134617/draft", "access_links": "https://zenodo.org/api/records/13134617/access/links", "access_grants": "https://zenodo.org/api/records/13134617/access/grants", "access_users": "https://zenodo.org/a