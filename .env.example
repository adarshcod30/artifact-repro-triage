# Copy to .env and fill in ONE provider. .env is gitignored - never commit it.

# --- AWS Bedrock (what the reported results used) ---------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Alternatives -----------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# --- Run configuration ------------------------------------------------------
# Both baseline and solution read this, so they can never run different models.
# One of: bedrock | anthropic | gemini | grok
ARTIFACT_TRIAGE_PROVIDER=bedrock

# Blank uses the provider default. Reported results used nova-pro.
ARTIFACT_TRIAGE_MODEL=us.amazon.nova-pro-v1:0

# Confidence below which an artifact is escalated to a human reviewer.
ARTIFACT_TRIAGE_ESCALATE_BELOW=0.55

# Repeat trials for the falsified-README experiment. 1 is NOT reportable.
ARTIFACT_TRIAGE_TRIALS=3
