# Copy to .env and fill in ONE provider. .env is gitignored - never commit it.
#
#   cp .env.example .env
#
# NOTHING here is needed to reproduce the deterministic results. The prevalence
# study, the negative control, the ablation, the link-checker gap and all 12
# credential-free `make` targets run with this file absent. Credentials are
# only for the paid model experiments (`make baseline`, `solution`, `falsified`,
# `adversarial`) and for `artifact-triage <repo> --model`.

# ===========================================================================
# 1. Pick a provider. One of: bedrock | openai | anthropic | gemini | grok
# ===========================================================================
ARTIFACT_TRIAGE_PROVIDER=bedrock

# ===========================================================================
# 2. Set the key for THAT provider. Leave the others blank.
# ===========================================================================

# --- AWS Bedrock — what the published results used --------------------------
# Needs `bedrock:InvokeModel` on the model, and model access enabled in the
# Bedrock console for that region. Region matters: access is granted per region.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# Optional: Azure OpenAI, a gateway, or any OpenAI-compatible endpoint.
# OPENAI_BASE_URL=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Google Gemini ----------------------------------------------------------
GEMINI_API_KEY=

# --- xAI Grok ---------------------------------------------------------------
XAI_API_KEY=

# ===========================================================================
# 3. Choose the model (optional)
# ===========================================================================
# Blank uses that provider's default. Both the baseline and the solution read
# this one variable, so they can never accidentally run different models - the
# fairness of the whole comparison depends on that.
#
#   bedrock    us.amazon.nova-pro-v1:0        <- the published results
#   bedrock    us.amazon.nova-2-lite-v1:0     <- 13x cheaper, still 94%
#   openai     gpt-4o-mini
#   anthropic  claude-opus-5
#   gemini     gemini-2.5-flash
#   grok       grok-4-fast-non-reasoning
ARTIFACT_TRIAGE_MODEL=us.amazon.nova-pro-v1:0

# ===========================================================================
# 4. Safety rails
# ===========================================================================
# Hard ceiling in USD, enforced per call against an append-only ledger, and it
# RAISES rather than warns. Set this before running anything paid.
ARTIFACT_TRIAGE_BUDGET_USD=7.00

# Repeat trials for the falsified-README experiment. 1 is NOT reportable: the
# same experiment returned 100% then 90% on consecutive runs at temperature 0.
ARTIFACT_TRIAGE_TRIALS=3

# Optional: report cost at YOUR negotiated or regional rate, USD per 1M tokens.
# Affects the reported cost metric only - it cannot change a result.
# ARTIFACT_TRIAGE_USD_IN=
# ARTIFACT_TRIAGE_USD_OUT=

# ---------------------------------------------------------------------------
# REMOVED: ARTIFACT_TRIAGE_ESCALATE_BELOW
#
# This file used to advertise a confidence threshold for escalating an artifact
# to a human reviewer. It had not done anything for a long time. The confidence
# gate was removed after it fired 0 times out of 15 and self-reported confidence
# turned out to be ANTI-calibrated - mean 0.700 when the answer was right, 0.750
# when it was wrong. `decide()` now escalates on the evidence and never reads
# `confidence`. Setting the variable changed nothing, which is worse than not
# offering it.
# ---------------------------------------------------------------------------
